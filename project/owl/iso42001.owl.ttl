            owl:onProperty iso42001:closure_datetime ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:evidence_collected ],
        iso42001:NamedEntity ;
    skos:closeMatch iso27001:InformationSecurityIncident,
        iso29100:PrivacyBreach,
        nist_ai_100_1:Harm,
        nist_ai_600_1:GaiRisk ;
    skos:definition "An AI incident, i.e., an AI system event determined to require response, escalation, or external communication. Captures triage, response lifecycle, and communications to users and other interested parties per A.8.4 and A.8.3." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:note "AI-specific categories (data poisoning, model stealing, prompt injection, etc.) supplement classical infosec incident classes",
        "Provides the entity to which A.8.4 communication plans and A.8.3 external reports attach",
        "Reference: ISO/IEC 42001:2023 Annex A controls A.8.3, A.8.4. ISO/IEC standards text is copyright ISO/IEC - not reproduced here." ;
    iso42001:annex_a_reference "A.8.3, A.8.4" .

