        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:societal_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:societal_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:technical_context ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:shared_with_parties ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:assessment_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:dimensions_assessed ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:ai_systems_assessed ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:applicable_jurisdictions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:assessment_scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:assessment_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:next_assessment_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty iso42001:assessment_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:next_assessment_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:shared_with_parties ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:assessment_scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:mitigations ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:applicable_jurisdictions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:identified_consequences ],
        iso42001:DocumentedInformation ;
    skos:closeMatch iso29100:PrivacyImpactAssessment,
        nist_ai_100_1:Impact,
        nist_ai_600_1:PrimaryGaiConsideration ;
    skos:definition "An instance of an AI system impact assessment performed per Clause 6.1.4 and Clause 8.4. Documents consequences of deployment, intended use, and foreseeable misuse on individuals, groups, and societies." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:note "Considers deployment context, intended use, and reasonably foreseeable misuse",
        "Instance assessing consequences for individuals, groups, and societies per Clause 8.4" ;
    skos:relatedMatch iso27001:RiskAssessment ;
    iso42001:annex_a_reference "A.5" ;
    iso42001:iso42001_clause "6.1.4" .

iso42001:ImplementationStatus a owl:Class ;
    rdfs:label "ImplementationStatus" ;
    owl:unionOf ( <https://w3id.org/lmodel/iso42001/ImplementationStatus#not_started> <https://w3id.org/lmodel/iso42001/ImplementationStatus#planned> <https://w3id.org/lmodel/iso42001/ImplementationStatus#in_progress> <https://w3id.org/lmodel/iso42001/ImplementationStatus#implemented> <https://w3id.org/lmodel/iso42001/ImplementationStatus#not_applicable> ) ;
    skos:definition "Lifecycle status of a reference control, used in the AIMS Statement of Applicability and control tracking." ;
    skos:exactMatch iso27001:ImplementationStatus ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    linkml:permissible_values <https://w3id.org/lmodel/iso42001/ImplementationStatus#implemented>,
        <https://w3id.org/lmodel/iso42001/ImplementationStatus#in_progress>,
        <https://w3id.org/lmodel/iso42001/ImplementationStatus#not_applicable>,
        <https://w3id.org/lmodel/iso42001/ImplementationStatus#not_started>,
        <https://w3id.org/lmodel/iso42001/ImplementationStatus#planned> .

iso42001:implementation_status a owl:ObjectProperty ;
    rdfs:label "implementation_status" ;
    rdfs:range iso42001:ImplementationStatus ;
    skos:definition "Current implementation status." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:resources_required a owl:DatatypeProperty ;
    rdfs:label "resources_required" ;
    rdfs:range xsd:string ;
    skos:definition "Resources required for implementation." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:DocumentType a owl:Class ;
    rdfs:label "DocumentType" ;
    owl:unionOf ( <https://w3id.org/lmodel/iso42001/DocumentType#policy> <https://w3id.org/lmodel/iso42001/DocumentType#procedure> <https://w3id.org/lmodel/iso42001/DocumentType#standard> <https://w3id.org/lmodel/iso42001/DocumentType#guideline> <https://w3id.org/lmodel/iso42001/DocumentType#record> <https://w3id.org/lmodel/iso42001/DocumentType#plan> <https://w3id.org/lmodel/iso42001/DocumentType#report> <https://w3id.org/lmodel/iso42001/DocumentType#technical_documentation> ) ;
