	skos:definition "How the guidance of Annex B is taken into account." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> .
iso42001:aims_treatment_approval_workflow a owl:DatatypeProperty ;
	rdfs:label "aims_treatment_approval_workflow" ;
	skos:definition "How designated management approves a plan and accepts the risk left over." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> .
iso42001:aims_treatment_control_selection a owl:DatatypeProperty ;
	rdfs:label "aims_treatment_control_selection" ;
	skos:definition "How the controls a treatment needs are chosen." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> .
iso42001:aims_treatment_options_guidance a owl:DatatypeProperty ;
	rdfs:label "aims_treatment_options_guidance" ;
	skos:definition "How a treatment option is chosen for a risk." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> .
iso42001:aims_treatment_soa_template a owl:DatatypeProperty ;
	rdfs:label "aims_treatment_soa_template" ;
	skos:definition "The template the Statement of Applicability follows." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> .
iso42001:aims_use_approvals a owl:DatatypeProperty ;
	rdfs:label "aims_use_approvals" ;
	skos:definition "The approvals needed before use." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	iso42001:annex_b_item "B.9.2" .
iso42001:aims_use_costs a owl:DatatypeProperty ;
	rdfs:label "aims_use_costs" ;
	skos:definition "What use costs, ongoing upkeep included." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	iso42001:annex_b_item "B.9.2" .
iso42001:aims_use_legal_requirements a owl:DatatypeProperty ;
	rdfs:label "aims_use_legal_requirements" ;
	skos:definition "The laws that bear on use." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	iso42001:annex_b_item "B.9.2" .
iso42001:aims_use_processes a owl:ObjectProperty ;
	rdfs:label "aims_use_processes" ;
	skos:definition "The processes for using AI systems responsibly." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> .
iso42001:aims_use_sourcing_requirements a owl:DatatypeProperty ;
	rdfs:label "aims_use_sourcing_requirements" ;
	skos:definition "What a system or its supplier must meet to be taken on." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	iso42001:annex_b_item "B.9.2" .
iso42001:aims_user_information a owl:ObjectProperty ;
	rdfs:label "aims_user_information" ;
	skos:definition "What users of AI systems are told." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> .
iso42001:aims_user_information_channels a owl:DatatypeProperty ;
	rdfs:label "aims_user_information_channels" ;
	skos:definition "How it reaches them, such as instructions, alerts or a web page." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	iso42001:annex_b_item "B.8.2" .
iso42001:aims_user_information_contents a owl:DatatypeProperty ;
	rdfs:label "aims_user_information_contents" ;
	skos:definition "What users are told, such as that AI is behind what they see and how to overrule it." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	iso42001:annex_b_item "B.8.2" .
iso42001:aims_user_information_criteria a owl:DatatypeProperty ;
	rdfs:label "aims_user_information_criteria" ;
	skos:definition "What decided what they are told." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	iso42001:annex_b_item "B.8.2" .
iso42001:aims_user_information_validated a owl:DatatypeProperty ;
	rdfs:label "aims_user_information_validated" ;
	skos:definition "Whether the organization has checked that users can get it and that it is right." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	iso42001:annex_b_item "B.8.2" .
iso42001:description a owl:DatatypeProperty ;
	rdfs:label "description" ;
	skos:definition "What the record says or describes, in the organization's own words." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	skos:note "It means what LOKF's description means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one description key." .
iso42001:title a owl:DatatypeProperty ;
	rdfs:label "title" ;
	skos:definition "The name the organization gives the record." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	skos:note "It means what LOKF's title means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key." .
