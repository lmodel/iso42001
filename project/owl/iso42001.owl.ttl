    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:narrowMatch iso27001:Asset ;
    skos:note "Algorithm, framework, model, or library used by the AI system per Annex A.4.4",
        "Track vendor, version, and license terms to support third-party assurance" ;
