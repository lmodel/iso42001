iso42001:SoAEntry a owl:Class ;
    rdfs:label "SoAEntry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:target_implementation_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso42001:Role ;
            owl:onProperty iso42001:responsible_role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:is_applicable ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:responsible_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:is_applicable ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:implementation_evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:inclusion_justification ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:inclusion_justification ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:exclusion_justification ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:exclusion_justification ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty iso42001:is_applicable ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty iso42001:target_implementation_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso42001:AIReferenceControl ;
            owl:onProperty iso42001:control_reference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:implementation_evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso42001:ImplementationStatus ;
            owl:onProperty iso42001:implementation_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:target_implementation_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:inclusion_justification ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:implementation_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:responsible_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:exclusion_justification ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:control_reference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:control_reference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:implementation_evidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:implementation_status ] ;
    skos:definition "A single entry in the AIMS Statement of Applicability documenting the applicability and implementation status of one reference control." ;
    skos:exactMatch iso27001:SoAEntry ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:note "Exclusion justifications should reference risk assessment outputs or external requirements",
        "One row of the SoA: links a control to applicability, justification, and status" .

iso42001:SupplierRelationship a owl:Class ;
    rdfs:label "SupplierRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:corrective_actions_required ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:supplier_assessment_criteria ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:monitoring_method ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:monitoring_method ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:corrective_actions_required ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:monitoring_method ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:supplier_assessment_criteria ],
        iso42001:ThirdPartyRelationship ;
    skos:definition "A supplier relationship covering services, products, or materials (e.g., datasets, models, libraries, full AI systems) provided to the organization per A.10.3." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:note "Includes assessment criteria, monitoring method, and corrective actions required",
        "Supplier relationship per Annex A.10.3" ;
    skos:relatedMatch iso27001:InterestedParty ;
    iso42001:annex_a_reference "A.10.3" .

iso42001:action_items a owl:DatatypeProperty ;
    rdfs:label "action_items" ;
    rdfs:range xsd:string ;
    skos:definition "Action items resulting from the review." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:ai_incidents a owl:ObjectProperty ;
    rdfs:label "ai_incidents" ;
    rdfs:range iso42001:AIIncident ;
    skos:definition "AI incidents managed under the AIMS." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
