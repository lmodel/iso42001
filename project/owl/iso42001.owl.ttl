            owl:onProperty iso42001:awareness_program ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:scope_exclusions ],
        iso42001:NamedEntity ;
    skos:closeMatch iso27001:InformationSecurityManagementSystem,
        nist_ai_100_1:AiRmfFramework ;
    skos:definition "Top-level container representing an organization's complete AI Management System (AIMS) per ISO/IEC 42001:2023. Aggregates all components required to support the AIMS lifecycle." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:note "Reference: ISO/IEC 42001:2023 Clause 4.4. ISO/IEC standards text is copyright ISO/IEC - not reproduced here.",
        "Root entity for any ISO/IEC 42001 conformance dataset" ;
    skos:relatedMatch iso29100:PrivacyFramework,
        nist_ai_600_1:GaiProfile ;
    iso42001:iso42001_clause "4.4" ;
    iso42001:mandatory "true" .

iso42001:AuditProgramme a owl:Class ;
    rdfs:label "AuditProgramme" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:auditor_qualifications ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:audit_frequency_rationale ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:programme_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:programme_period ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:programme_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:auditor_qualifications ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:programme_period ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:audit_frequency_rationale ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:planned_audits ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:resource_requirements ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso42001:InternalAudit ;
            owl:onProperty iso42001:planned_audits ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:resource_requirements ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:audit_frequency_rationale ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:programme_period ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:programme_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:resource_requirements ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:auditor_qualifications ],
        iso42001:DocumentedInformation ;
    skos:definition "The internal audit programme per Clause 9.2.2, planning AIMS audit activities over a defined period." ;
    skos:exactMatch iso27001:AuditProgramme ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:note "Audit programme per Clause 9.2.2",
        "Frequency rationale should reflect process importance and prior audit results" ;
    iso42001:iso42001_clause "9.2.2" .

xsd:duration a rdfs:Datatype .

xsd:positiveInteger a rdfs:Datatype .

<https://w3id.org/lmodel/iso42001/AIControlFamily#ai_policies> a owl:Class ;
    rdfs:label "ai_policies" ;
    rdfs:subClassOf iso42001:AIControlFamily ;
    skos:definition "Policies related to AI (Annex A.2) - management direction and support for AI systems according to business requirements." ;
    iso42001:annex_clause "A.2" .

<https://w3id.org/lmodel/iso42001/AIControlFamily#ai_resources> a owl:Class ;
    rdfs:label "ai_resources" ;
    rdfs:subClassOf iso42001:AIControlFamily ;
    skos:definition "Resources for AI systems (Annex A.4) - documentation of data, tooling, system/computing, and human resources for AI systems." ;
    iso42001:annex_clause "A.4" .

<https://w3id.org/lmodel/iso42001/AIControlFamily#ai_system_lifecycle> a owl:Class ;
    rdfs:label "ai_system_lifecycle" ;
    rdfs:subClassOf iso42001:AIControlFamily ;
    skos:definition "AI system life cycle (Annex A.6) - responsible design, development, verification, deployment, operation, and technical documentation." ;
    iso42001:annex_clause "A.6" .

<https://w3id.org/lmodel/iso42001/AIControlFamily#data_for_ai> a owl:Class ;
    rdfs:label "data_for_ai" ;
    rdfs:subClassOf iso42001:AIControlFamily ;
    skos:definition "Data for AI systems (Annex A.7) - data management, acquisition, quality, provenance, and preparation for AI." ;
    iso42001:annex_clause "A.7" .

<https://w3id.org/lmodel/iso42001/AIControlFamily#impact_assessment> a owl:Class ;
    rdfs:label "impact_assessment" ;
    rdfs:subClassOf iso42001:AIControlFamily ;
    skos:definition "Assessing impacts of AI systems (Annex A.5) - evaluation of consequences for individuals, groups, and societies across the AI system life cycle." ;
    iso42001:annex_clause "A.5" .

<https://w3id.org/lmodel/iso42001/AIControlFamily#information_for_parties> a owl:Class ;
    rdfs:label "information_for_parties" ;
    rdfs:subClassOf iso42001:AIControlFamily ;
    skos:definition "Information for interested parties (Annex A.8) - system documentation for users, external reporting, and incident communications." ;
    iso42001:annex_clause "A.8" .

<https://w3id.org/lmodel/iso42001/AIControlFamily#internal_organization> a owl:Class ;
    rdfs:label "internal_organization" ;
    rdfs:subClassOf iso42001:AIControlFamily ;
    skos:definition "Internal organization (Annex A.3) - accountability for responsible implementation, operation, and management of AI systems." ;
    iso42001:annex_clause "A.3" .

<https://w3id.org/lmodel/iso42001/AIControlFamily#third_party_relationships> a owl:Class ;
    rdfs:label "third_party_relationships" ;
    rdfs:subClassOf iso42001:AIControlFamily ;
    skos:definition "Third-party and customer relationships (Annex A.10) - allocating responsibilities, supplier management, and customer expectations." ;
    iso42001:annex_clause "A.10" .

<https://w3id.org/lmodel/iso42001/AIControlFamily#use_of_ai> a owl:Class ;
    rdfs:label "use_of_ai" ;
    rdfs:subClassOf iso42001:AIControlFamily ;
    skos:definition "Use of AI systems (Annex A.9) - responsible-use processes, objectives, and intended-use enforcement." ;
    iso42001:annex_clause "A.9" .

<https://w3id.org/lmodel/iso42001/AIIncidentCategory#adverse_societal_impact> a owl:Class ;
    rdfs:label "adverse_societal_impact" ;
    rdfs:subClassOf iso42001:AIIncidentCategory ;
    skos:closeMatch nist_ai_100_1:HARM_TO_AN_ECOSYSTEM,
        nist_ai_600_1:ENVIRONMENTAL_IMPACTS ;
    skos:definition "Broader societal harm reported by external interested parties." .

<https://w3id.org/lmodel/iso42001/AIIncidentCategory#bias_incident> a owl:Class ;
    rdfs:label "bias_incident" ;
    rdfs:subClassOf iso42001:AIIncidentCategory ;
    skos:closeMatch nist_ai_100_1:HARM_TO_PEOPLE ;
    skos:definition "Unfair or discriminatory outcomes affecting individuals or groups." ;
    skos:exactMatch nist_ai_600_1:HARMFUL_BIAS_OR_HOMOGENIZATION .

<https://w3id.org/lmodel/iso42001/AIIncidentCategory#data_poisoning> a owl:Class ;
    rdfs:label "data_poisoning" ;
    rdfs:subClassOf iso42001:AIIncidentCategory ;
    skos:closeMatch nist_ai_600_1:INFORMATION_INTEGRITY ;
    skos:definition "Training or production data manipulated to compromise model behaviour." .

<https://w3id.org/lmodel/iso42001/AIIncidentCategory#hallucination> a owl:Class ;
    rdfs:label "hallucination" ;
    rdfs:subClassOf iso42001:AIIncidentCategory ;
    skos:definition "Confidently incorrect or fabricated outputs causing material harm." ;
    skos:exactMatch nist_ai_600_1:CONFABULATION .

<https://w3id.org/lmodel/iso42001/AIIncidentCategory#membership_inference> a owl:Class ;
    rdfs:label "membership_inference" ;
    rdfs:subClassOf iso42001:AIIncidentCategory ;
    skos:definition "Inference of whether a record was part of the training set." .

<https://w3id.org/lmodel/iso42001/AIIncidentCategory#misuse> a owl:Class ;
    rdfs:label "misuse" ;
    rdfs:subClassOf iso42001:AIIncidentCategory ;
    skos:definition "Use of the AI system outside its documented intended use." ;
    skos:relatedMatch nist_ai_600_1:DANGEROUS_VIOLENT_OR_HATEFUL_CONTENT .

<https://w3id.org/lmodel/iso42001/AIIncidentCategory#model_drift> a owl:Class ;
    rdfs:label "model_drift" ;
    rdfs:subClassOf iso42001:AIIncidentCategory ;
    skos:definition "Performance or behaviour degradation due to distribution shift." .

<https://w3id.org/lmodel/iso42001/AIIncidentCategory#model_inversion> a owl:Class ;
    rdfs:label "model_inversion" ;
    rdfs:subClassOf iso42001:AIIncidentCategory ;
    skos:definition "Reconstruction of sensitive training data via model queries." .

<https://w3id.org/lmodel/iso42001/AIIncidentCategory#model_stealing> a owl:Class ;
    rdfs:label "model_stealing" ;
    rdfs:subClassOf iso42001:AIIncidentCategory ;
    skos:definition "Unauthorized extraction or reconstruction of a deployed model." .

<https://w3id.org/lmodel/iso42001/AIIncidentCategory#other> a owl:Class ;
    rdfs:label "other" ;
    rdfs:subClassOf iso42001:AIIncidentCategory ;
    skos:definition "Other AI incident category not enumerated above." .

<https://w3id.org/lmodel/iso42001/AIIncidentCategory#privacy_breach> a owl:Class ;
    rdfs:label "privacy_breach" ;
    rdfs:subClassOf iso42001:AIIncidentCategory ;
    skos:closeMatch nist_ai_100_1:HARM_TO_PEOPLE,
        nist_ai_600_1:DATA_PRIVACY ;
    skos:definition "Unauthorized disclosure of personal data via the AI system." ;
    skos:exactMatch iso29100:PrivacyBreach .

<https://w3id.org/lmodel/iso42001/AIIncidentCategory#prompt_injection> a owl:Class ;
    rdfs:label "prompt_injection" ;
    rdfs:subClassOf iso42001:AIIncidentCategory ;
    skos:closeMatch nist_ai_600_1:INFORMATION_SECURITY ;
    skos:definition "Adversarial inputs causing the model to deviate from intended behaviour." .

<https://w3id.org/lmodel/iso42001/AIIncidentCategory#safety_incident> a owl:Class ;
    rdfs:label "safety_incident" ;
    rdfs:subClassOf iso42001:AIIncidentCategory ;
    skos:definition "Harm to life, health, property, or the environment from AI behaviour." .

<https://w3id.org/lmodel/iso42001/AIIncidentCategory#security_breach> a owl:Class ;
    rdfs:label "security_breach" ;
    rdfs:subClassOf iso42001:AIIncidentCategory ;
    skos:closeMatch nist_ai_100_1:HARM_TO_AN_ORGANIZATION,
        nist_ai_600_1:INFORMATION_SECURITY ;
    skos:definition "Compromise of confidentiality, integrity, or availability of the AI system." .

<https://w3id.org/lmodel/iso42001/AIObjectiveCategory#accessibility> a owl:Class ;
    rdfs:label "accessibility" ;
    rdfs:subClassOf iso42001:AIObjectiveCategory ;
    skos:definition "Usability of AI systems by people with diverse abilities." .

<https://w3id.org/lmodel/iso42001/AIObjectiveCategory#accountability> a owl:Class ;
    rdfs:label "accountability" ;
    rdfs:subClassOf iso42001:AIObjectiveCategory ;
    skos:definition "Clear allocation of responsibility for AI-supported decisions." .

<https://w3id.org/lmodel/iso42001/AIObjectiveCategory#ai_expertise> a owl:Class ;
    rdfs:label "ai_expertise" ;
    rdfs:subClassOf iso42001:AIObjectiveCategory ;
    skos:definition "Availability of interdisciplinary expertise for AI activities." .

<https://w3id.org/lmodel/iso42001/AIObjectiveCategory#availability_of_training_data> a owl:Class ;
    rdfs:label "availability_of_training_data" ;
    rdfs:subClassOf iso42001:AIObjectiveCategory ;
    skos:definition "Sufficient availability and quality of training, validation, and test data needed to train and verify AI systems (Annex C.2.3)." .

<https://w3id.org/lmodel/iso42001/AIObjectiveCategory#data_quality> a owl:Class ;
    rdfs:label "data_quality" ;
    rdfs:subClassOf iso42001:AIObjectiveCategory ;
    skos:closeMatch iso29100:accuracy_and_quality ;
    skos:definition "Adequate quality of training, validation, and test data." .

<https://w3id.org/lmodel/iso42001/AIObjectiveCategory#environmental_impact> a owl:Class ;
    rdfs:label "environmental_impact" ;
    rdfs:subClassOf iso42001:AIObjectiveCategory ;
    skos:definition "Management of positive and negative environmental effects." .

<https://w3id.org/lmodel/iso42001/AIObjectiveCategory#explainability> a owl:Class ;
    rdfs:label "explainability" ;
    rdfs:subClassOf iso42001:AIObjectiveCategory ;
    skos:definition "Comprehensible explanations of important factors driving AI outputs." ;
    skos:exactMatch nist_ai_100_1:TrustworthinessCharacteristic .

<https://w3id.org/lmodel/iso42001/AIObjectiveCategory#fairness> a owl:Class ;
    rdfs:label "fairness" ;
    rdfs:subClassOf iso42001:AIObjectiveCategory ;
    skos:closeMatch nist_ai_100_1:TrustworthinessCharacteristic ;
    skos:definition "Avoiding inappropriate or unfair outcomes for individuals or groups." ;
    skos:relatedMatch iso29100:individual_participation_and_access .

<https://w3id.org/lmodel/iso42001/AIObjectiveCategory#maintainability> a owl:Class ;
    rdfs:label "maintainability" ;
    rdfs:subClassOf iso42001:AIObjectiveCategory ;
    skos:definition "Ability to correct defects and accommodate new requirements." .

<https://w3id.org/lmodel/iso42001/AIObjectiveCategory#privacy> a owl:Class ;
    rdfs:label "privacy" ;
    rdfs:subClassOf iso42001:AIObjectiveCategory ;
    skos:definition "Protection of personal and sensitive data processed by AI systems." ;
    skos:exactMatch iso29100:PrivacyPrinciple,
        nist_ai_100_1:TrustworthinessCharacteristic .

<https://w3id.org/lmodel/iso42001/AIObjectiveCategory#reliability> a owl:Class ;
    rdfs:label "reliability" ;
    rdfs:subClassOf iso42001:AIObjectiveCategory ;
    skos:closeMatch nist_ai_100_1:TrustworthinessCharacteristic ;
    skos:definition "Consistent performance under defined conditions." .

<https://w3id.org/lmodel/iso42001/AIObjectiveCategory#robustness> a owl:Class ;
    rdfs:label "robustness" ;
    rdfs:subClassOf iso42001:AIObjectiveCategory ;
    skos:closeMatch nist_ai_100_1:TrustworthinessCharacteristic ;
    skos:definition "Comparable performance on new and operational data." .

<https://w3id.org/lmodel/iso42001/AIObjectiveCategory#safety> a owl:Class ;
    rdfs:label "safety" ;
    rdfs:subClassOf iso42001:AIObjectiveCategory ;
    skos:definition "Avoidance of harm to life, health, property, or the environment." ;
    skos:exactMatch nist_ai_100_1:TrustworthinessCharacteristic .

<https://w3id.org/lmodel/iso42001/AIObjectiveCategory#security> a owl:Class ;
    rdfs:label "security" ;
    rdfs:subClassOf iso42001:AIObjectiveCategory ;
    skos:closeMatch iso29100:information_security ;
    skos:definition "Protection from AI-specific and conventional security threats." ;
    skos:exactMatch nist_ai_100_1:TrustworthinessCharacteristic .

<https://w3id.org/lmodel/iso42001/AIObjectiveCategory#transparency> a owl:Class ;
    rdfs:label "transparency" ;
    rdfs:subClassOf iso42001:AIObjectiveCategory ;
    skos:closeMatch iso29100:openness_transparency_and_notice,
        nist_ai_100_1:TrustworthinessCharacteristic ;
    skos:definition "Visibility into organizational AI practices and AI system behaviour." .

<https://w3id.org/lmodel/iso42001/AIOrganizationalRole#ai_customer> a owl:Class ;
    rdfs:label "ai_customer" ;
    rdfs:subClassOf iso42001:AIOrganizationalRole ;
    skos:closeMatch nist_ai_100_1:END_USERS,
        nist_ai_600_1:END_USERS ;
    skos:definition "Organization or individual that uses an AI product or service." .

<https://w3id.org/lmodel/iso42001/AIOrganizationalRole#ai_partner> a owl:Class ;
    rdfs:label "ai_partner" ;
    rdfs:subClassOf iso42001:AIOrganizationalRole ;
    skos:closeMatch iso29100:ThirdParty,
        nist_ai_100_1:THIRD_PARTY_ENTITIES ;
    skos:definition "System integrators and data providers for AI systems." .

<https://w3id.org/lmodel/iso42001/AIOrganizationalRole#ai_producer> a owl:Class ;
    rdfs:label "ai_producer" ;
    rdfs:subClassOf iso42001:AIOrganizationalRole ;
    skos:closeMatch nist_ai_100_1:AI_DESIGN ;
    skos:definition "Organization or actor that develops, designs, operates, tests, evaluates, deploys, or governs AI systems." .

<https://w3id.org/lmodel/iso42001/AIOrganizationalRole#ai_provider> a owl:Class ;
    rdfs:label "ai_provider" ;
    rdfs:subClassOf iso42001:AIOrganizationalRole ;
    skos:closeMatch nist_ai_100_1:AI_DEVELOPMENT ;
    skos:definition "Organization providing AI platforms, products, or services to others." .

<https://w3id.org/lmodel/iso42001/AIOrganizationalRole#ai_subject> a owl:Class ;
    rdfs:label "ai_subject" ;
    rdfs:subClassOf iso42001:AIOrganizationalRole ;
    skos:closeMatch iso29100:PIIPrincipal,
        nist_ai_100_1:AFFECTED_INDIVIDUALS_OR_COMMUNITIES,
        nist_ai_600_1:AFFECTED_INDIVIDUALS_AND_COMMUNITIES ;
    skos:definition "Individuals or groups whose data or interests are affected by an AI system (e.g., data subjects)." .

<https://w3id.org/lmodel/iso42001/AIOrganizationalRole#relevant_authority> a owl:Class ;
    rdfs:label "relevant_authority" ;
    rdfs:subClassOf iso42001:AIOrganizationalRole ;
    skos:closeMatch nist_ai_100_1:GOVERNANCE_AND_OVERSIGHT,
        nist_ai_600_1:GOVERNANCE_AND_OVERSIGHT ;
    skos:definition "Policymakers, regulators, and other oversight bodies." .

<https://w3id.org/lmodel/iso42001/AIRiskSourceCategory#complexity_of_environment> a owl:Class ;
    rdfs:label "complexity_of_environment" ;
    rdfs:subClassOf iso42001:AIRiskSourceCategory ;
    skos:definition "Performance uncertainty in complex or open operational environments (e.g., autonomous systems)." .

<https://w3id.org/lmodel/iso42001/AIRiskSourceCategory#hardware> a owl:Class ;
    rdfs:label "hardware" ;
    rdfs:subClassOf iso42001:AIRiskSourceCategory ;
    skos:definition "Hardware errors or behavioural differences when transferring trained models between systems." .

<https://w3id.org/lmodel/iso42001/AIRiskSourceCategory#lack_of_transparency_or_explainability> a owl:Class ;
    rdfs:label "lack_of_transparency_or_explainability" ;
    rdfs:subClassOf iso42001:AIRiskSourceCategory ;
    skos:definition "Inability to provide adequate information to interested parties, affecting trustworthiness and accountability." ;
    skos:exactMatch nist_ai_100_1:INSCRUTABILITY .

<https://w3id.org/lmodel/iso42001/AIRiskSourceCategory#level_of_automation> a owl:Class ;
    rdfs:label "level_of_automation" ;
    rdfs:subClassOf iso42001:AIRiskSourceCategory ;
    skos:definition "Effects of automation on safety, fairness, security, or human oversight." .

<https://w3id.org/lmodel/iso42001/AIRiskSourceCategory#lifecycle> a owl:Class ;
    rdfs:label "lifecycle" ;
    rdfs:subClassOf iso42001:AIRiskSourceCategory ;
    skos:closeMatch nist_ai_600_1:DESIGN ;
    skos:definition "Risks introduced at any AI system life cycle stage, including design flaws, deployment issues, or decommissioning gaps." ;
    skos:exactMatch nist_ai_100_1:RISK_AT_DIFFERENT_LIFECYCLE_STAGES .

<https://w3id.org/lmodel/iso42001/AIRiskSourceCategory#machine_learning_specific> a owl:Class ;
    rdfs:label "machine_learning_specific" ;
    rdfs:subClassOf iso42001:AIRiskSourceCategory ;
    skos:closeMatch nist_ai_100_1:TRACKING_EMERGENT_RISKS,
        nist_ai_600_1:TRAINING ;
    skos:definition "Risks tied to data collection, data quality, and ML-specific phenomena such as data poisoning." .

<https://w3id.org/lmodel/iso42001/AIRiskSourceCategory#technology_readiness> a owl:Class ;
    rdfs:label "technology_readiness" ;
    rdfs:subClassOf iso42001:AIRiskSourceCategory ;
    skos:definition "Risks from immature technology with unknown limitations as well as mature technology subject to technology complacency." .

<https://w3id.org/lmodel/iso42001/AISystemLifecycleStage#continuous_validation> a owl:Class ;
    rdfs:label "continuous_validation" ;
    rdfs:subClassOf iso42001:AISystemLifecycleStage ;
    skos:closeMatch nist_ai_100_1:OPERATE_AND_MONITOR ;
    skos:definition "Continuous validation, including drift detection and re-training triggers." .

<https://w3id.org/lmodel/iso42001/AISystemLifecycleStage#data_collection_and_preparation> a owl:Class ;
    rdfs:label "data_collection_and_preparation" ;
    rdfs:subClassOf iso42001:AISystemLifecycleStage ;
    skos:definition "Acquiring, labelling, and preparing data resources." ;
    skos:exactMatch nist_ai_100_1:COLLECT_AND_PROCESS_DATA .

<https://w3id.org/lmodel/iso42001/AISystemLifecycleStage#decommissioning> a owl:Class ;
    rdfs:label "decommissioning" ;
    rdfs:subClassOf iso42001:AISystemLifecycleStage ;
    skos:definition "Retirement, disposal, and post-decommissioning obligations." ;
    skos:exactMatch nist_ai_600_1:DECOMMISSIONING ;
    skos:relatedMatch nist_ai_100_1:OPERATE_AND_MONITOR .

<https://w3id.org/lmodel/iso42001/AISystemLifecycleStage#deployment> a owl:Class ;
    rdfs:label "deployment" ;
    rdfs:subClassOf iso42001:AISystemLifecycleStage ;
    skos:definition "Release and integration into the production environment." ;
    skos:exactMatch nist_ai_100_1:DEPLOY_AND_USE,
        nist_ai_600_1:DEPLOYMENT .

<https://w3id.org/lmodel/iso42001/AISystemLifecycleStage#design> a owl:Class ;
    rdfs:label "design" ;
    rdfs:subClassOf iso42001:AISystemLifecycleStage ;
    skos:definition "AI system design including requirements and architecture." ;
    skos:exactMatch nist_ai_100_1:PLAN_AND_DESIGN,
        nist_ai_600_1:DESIGN .

<https://w3id.org/lmodel/iso42001/AISystemLifecycleStage#development> a owl:Class ;
    rdfs:label "development" ;
    rdfs:subClassOf iso42001:AISystemLifecycleStage ;
    skos:definition "Model and AI system development and training." ;
    skos:exactMatch nist_ai_100_1:BUILD_AND_USE_MODEL,
        nist_ai_600_1:DEVELOPMENT .

<https://w3id.org/lmodel/iso42001/AISystemLifecycleStage#inception> a owl:Class ;
    rdfs:label "inception" ;
    rdfs:subClassOf iso42001:AISystemLifecycleStage ;
    skos:closeMatch nist_ai_100_1:PLAN_AND_DESIGN ;
    skos:definition "Initial conception, feasibility, and use-case definition." .

<https://w3id.org/lmodel/iso42001/AISystemLifecycleStage#operation_and_monitoring> a owl:Class ;
    rdfs:label "operation_and_monitoring" ;
    rdfs:subClassOf iso42001:AISystemLifecycleStage ;
    skos:closeMatch nist_ai_600_1:OPERATION ;
    skos:definition "Ongoing operation, monitoring, and support." ;
    skos:exactMatch nist_ai_100_1:OPERATE_AND_MONITOR .

<https://w3id.org/lmodel/iso42001/AISystemLifecycleStage#re_evaluation> a owl:Class ;
    rdfs:label "re_evaluation" ;
    rdfs:subClassOf iso42001:AISystemLifecycleStage ;
    skos:closeMatch nist_ai_100_1:OPERATE_AND_MONITOR ;
    skos:definition "Re-evaluation following significant changes or new evidence." .

<https://w3id.org/lmodel/iso42001/AISystemLifecycleStage#verification_and_validation> a owl:Class ;
    rdfs:label "verification_and_validation" ;
    rdfs:subClassOf iso42001:AISystemLifecycleStage ;
    skos:definition "Verification and validation of the AI system." ;
    skos:exactMatch nist_ai_100_1:VERIFY_AND_VALIDATE .

