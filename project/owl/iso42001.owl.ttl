            owl:minCardinality 0 ;
            owl:onProperty iso42001:top_management ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:operational_procedures ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:scope_exclusions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:leadership_commitment_evidence ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:scope_boundaries ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:scope_statement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:ai_system_events ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso42001:Organization ;
            owl:onProperty iso42001:organization ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:communication_plan ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:planned_changes ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso42001:ThirdPartyRelationship ;
            owl:onProperty iso42001:third_party_relationships ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso42001:InternalAudit ;
            owl:onProperty iso42001:internal_audits ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:ai_incidents ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:certification_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:ai_risk_treatment_process ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso42001:CompetenceRecord ;
            owl:onProperty iso42001:competence_records ],
        [ a owl:Restriction ;
