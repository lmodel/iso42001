        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:approved_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:effective_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:author ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:retention_period ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty iso42001:approved_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:review_date ],
        iso42001:NamedEntity ;
    skos:closeMatch nist_ai_100_1:PlaybookEntry ;
    skos:definition "Abstract class for documented information per Clause 7.5. Captures metadata required for document control under the AIMS." ;
    skos:exactMatch iso27001:DocumentedInformation ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:note "Captures Clause 7.5 metadata needed for document control, review, and retention",
        "Sub-classes inherit document_type, owner, approval, and review-date slots" ;
    iso42001:iso42001_clause "7.5" .

