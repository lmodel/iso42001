iso42001:CommunicationItem a owl:Class ;
    rdfs:label "CommunicationItem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:responsible_party ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:records_required ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:audience ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:responsible_party ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:audience ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:purpose ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:frequency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:purpose ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:frequency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:audience ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:responsible_party ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:purpose ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:method ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:records_required ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:records_required ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:method ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:frequency ] ;
    skos:definition "A single communication requirement within the AIMS communication plan." ;
    skos:exactMatch iso27001:CommunicationItem ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:note "Captures what, when, with whom, and how to communicate",
        "One row of the communication plan per Clause 7.4" ;
    iso42001:iso42001_clause "7.4" .

iso42001:CustomerRelationship a owl:Class ;
    rdfs:label "CustomerRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:usage_agreement_reference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:customer_expectations ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:usage_agreement_reference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:customer_expectations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:communicated_limitations ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:communicated_limitations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:usage_agreement_reference ],
        iso42001:ThirdPartyRelationship ;
    skos:definition "A customer relationship for an AI product or service supplied by the organization per A.10.4." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:note "Captures customer expectations and communicated AI system limitations",
        "Customer relationship per Annex A.10.4" ;
    skos:relatedMatch iso27001:InterestedParty ;
    iso42001:annex_a_reference "A.10.4" .

