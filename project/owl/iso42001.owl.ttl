    skos:definition "AI risk implication of the finding." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:risk_matrix a owl:DatatypeProperty ;
    rdfs:label "risk_matrix" ;
    rdfs:range xsd:string ;
    skos:definition "Risk matrix or calculation method." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:risk_owner a owl:DatatypeProperty ;
    rdfs:label "risk_owner" ;
    rdfs:range xsd:string ;
    skos:closeMatch iso29100:pii_controller ;
    skos:definition "Person accountable for managing the AI risk." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    iso42001:iso42001_clause "6.1.2" .

iso42001:risk_owner_approval a owl:DatatypeProperty ;
    rdfs:label "risk_owner_approval" ;
    rdfs:range xsd:string ;
    skos:definition "Risk owner who approved the plan." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    iso42001:iso42001_clause "6.1.3" .

iso42001:risk_source_category a owl:ObjectProperty ;
    rdfs:label "risk_source_category" ;
    rdfs:range iso42001:AIRiskSourceCategory ;
    skos:definition "Category of AI risk source per Annex C." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:risk_source_description a owl:DatatypeProperty ;
    rdfs:label "risk_source_description" ;
    rdfs:range xsd:string ;
    skos:definition "Description of the specific source of risk." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:risk_treatment_option a owl:ObjectProperty ;
    rdfs:label "risk_treatment_option" ;
    rdfs:range iso42001:RiskTreatmentOption ;
    skos:closeMatch nist_ai_100_1:risk_response ;
    skos:definition "Selected treatment option for the AI risk." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:role_type a owl:DatatypeProperty ;
    rdfs:label "role_type" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ a rdfs:Datatype ;
                        owl:unionOf ( iso42001:GovernanceRoleType xsd:string ) ] xsd:string ) ] ;
    skos:definition "Category of the role. Use a `GovernanceRoleType` value for the normative AIMS governance positions; free-form strings remain accepted for organization-defined roles." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:root_cause_addressed a owl:DatatypeProperty ;
    rdfs:label "root_cause_addressed" ;
    rdfs:range xsd:string ;
    skos:definition "Root cause addressed by the action." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:root_cause_analysis a owl:DatatypeProperty ;
    rdfs:label "root_cause_analysis" ;
    rdfs:range xsd:string ;
    skos:definition "Analysis of the root cause." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:scope_statement a owl:DatatypeProperty ;
    rdfs:label "scope_statement" ;
    rdfs:range xsd:string ;
    skos:definition "Documented statement of AIMS scope per Clause 4.3." ;
    skos:exactMatch iso27001:scope_statement ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    iso42001:iso42001_clause "4.3" .

iso42001:similar_nonconformities_check a owl:DatatypeProperty ;
    rdfs:label "similar_nonconformities_check" ;
    rdfs:range xsd:string ;
    skos:definition "Check for similar nonconformities." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:size_category a owl:DatatypeProperty ;
    rdfs:label "size_category" ;
    rdfs:range xsd:string ;
    skos:definition "Organization size classification." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:soa_template a owl:DatatypeProperty ;
    rdfs:label "soa_template" ;
    rdfs:range xsd:string ;
    skos:definition "Template used for the Statement of Applicability." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:societal_context a owl:DatatypeProperty ;
    rdfs:label "societal_context" ;
    rdfs:range xsd:string ;
    skos:definition "Societal context relevant to the impact assessment." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:source a owl:DatatypeProperty ;
    rdfs:label "source" ;
    rdfs:range xsd:string ;
    skos:definition "Source from which the data was obtained." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:statement_of_applicability a owl:ObjectProperty ;
    rdfs:label "statement_of_applicability" ;
    rdfs:range iso42001:StatementOfApplicability ;
    skos:definition "Reference to the AIMS Statement of Applicability." ;
    skos:exactMatch iso27001:statement_of_applicability ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:subject a owl:DatatypeProperty ;
    rdfs:label "subject" ;
    rdfs:range xsd:string ;
    skos:definition "Subject of the communication." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:summary_findings a owl:DatatypeProperty ;
    rdfs:label "summary_findings" ;
    rdfs:range xsd:string ;
    skos:definition "Summary of assessment findings." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:target_completion_date a owl:DatatypeProperty ;
    rdfs:label "target_completion_date" ;
    rdfs:range xsd:date ;
    skos:definition "Target completion date." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:target_implementation_date a owl:DatatypeProperty ;
    rdfs:label "target_implementation_date" ;
    rdfs:range xsd:date ;
    skos:definition "Target date for implementing the control." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:target_threshold a owl:DatatypeProperty ;
    rdfs:label "target_threshold" ;
    rdfs:range xsd:string ;
    skos:definition "Target threshold for the metric." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:target_value a owl:DatatypeProperty ;
    rdfs:label "target_value" ;
    rdfs:range xsd:string ;
    skos:definition "Target value for the objective metric." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:technical_context a owl:DatatypeProperty ;
    rdfs:label "technical_context" ;
    rdfs:range xsd:string ;
    skos:definition "Specific technical context in which the AI system is deployed." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:tool_category a owl:DatatypeProperty ;
    rdfs:label "tool_category" ;
    rdfs:range xsd:string ;
    skos:definition "Category of tooling resource (algorithm, framework, model, library)." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:tool_version a owl:DatatypeProperty ;
    rdfs:label "tool_version" ;
    rdfs:range xsd:string ;
    skos:definition "Version identifier for the tooling resource." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:top_management a owl:DatatypeProperty ;
    rdfs:label "top_management" ;
    rdfs:range xsd:string ;
    skos:definition "Reference to the person or group exercising top management direction and control over the AIMS (Clause 3.3, 5.1)." ;
    skos:exactMatch iso27001:top_management ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    iso42001:iso42001_clause "3.3" .

iso42001:topic_area a owl:DatatypeProperty ;
    rdfs:label "topic_area" ;
    rdfs:range xsd:string ;
    skos:definition "The specific topic addressed by the policy." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:total_controls a owl:DatatypeProperty ;
    rdfs:label "total_controls" ;
    rdfs:range xsd:unsignedShort ;
    skos:definition "Total number of controls in scope." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:treatment_options_guidance a owl:DatatypeProperty ;
    rdfs:label "treatment_options_guidance" ;
    rdfs:range xsd:string ;
    skos:definition "Guidance on selecting AI risk treatment options." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:treatment_priority a owl:DatatypeProperty ;
    rdfs:label "treatment_priority" ;
    rdfs:range xsd:string ;
    skos:definition "Priority for treating this risk." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:trend a owl:DatatypeProperty ;
    rdfs:label "trend" ;
    rdfs:range xsd:string ;
    skos:definition "Observed trend in the metric." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:usage_agreement_reference a owl:DatatypeProperty ;
    rdfs:label "usage_agreement_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Reference to the usage agreement with the customer." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:usage_purpose a owl:DatatypeProperty ;
    rdfs:label "usage_purpose" ;
    rdfs:range xsd:string ;
    skos:definition "Purpose for which the tooling resource is used." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:vendor a owl:DatatypeProperty ;
    rdfs:label "vendor" ;
    rdfs:range xsd:string ;
    skos:definition "Vendor or origin of the tooling resource." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    rdfs:range xsd:string ;
    skos:definition "Version identifier for the entity." ;
    skos:exactMatch iso27001:version ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:CommunicationPlan a owl:Class ;
    rdfs:label "CommunicationPlan" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom iso42001:CommunicationItem ;
            owl:onProperty iso42001:communication_items ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:communication_items ],
        iso42001:DocumentedInformation ;
    skos:definition "Plan for internal and external communications relevant to the AIMS per Clause 7.4." ;
    skos:exactMatch iso27001:CommunicationPlan ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:note "Aggregates individual CommunicationItem records",
        "Internal and external communication plan per Clause 7.4" ;
    iso42001:iso42001_clause "7.4" .

iso42001:affected_dimensions a owl:ObjectProperty ;
    rdfs:label "affected_dimensions" ;
    rdfs:range iso42001:ImpactAssessmentDimension ;
    skos:definition "Dimensions of impact affected by the risk (individual, group, societal, safety, privacy, security, environmental)." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:ai_systems_assessed a owl:ObjectProperty ;
    rdfs:label "ai_systems_assessed" ;
    rdfs:range iso42001:AISystem ;
    skos:definition "AI systems covered by this assessment." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:applicable_controls a owl:ObjectProperty ;
    rdfs:label "applicable_controls" ;
    rdfs:range iso42001:AIReferenceControl ;
    skos:definition "Reference controls related to this policy or AI system." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:assigned_to a owl:DatatypeProperty ;
    rdfs:label "assigned_to" ;
    rdfs:range xsd:string ;
    skos:definition "Person(s) assigned to this role or resource." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:linked_corrective_actions a owl:ObjectProperty ;
    rdfs:label "linked_corrective_actions" ;
    rdfs:range iso42001:CorrectiveAction ;
    skos:definition "Linked corrective actions." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:required_competencies a owl:DatatypeProperty ;
    rdfs:label "required_competencies" ;
    rdfs:range xsd:string ;
    skos:definition "Competencies required for the role." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:trigger_events a owl:DatatypeProperty ;
    rdfs:label "trigger_events" ;
    rdfs:range xsd:string ;
    skos:definition "Events that trigger an assessment outside the planned schedule." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:note "Per 8.2 / 8.4 when significant changes are proposed or occur" .

iso42001:AIPolicy a owl:Class ;
    rdfs:label "AIPolicy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:communication_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty iso42001:last_policy_review_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:policy_objectives_framework ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso42001:TopicSpecificPolicy ;
            owl:onProperty iso42001:related_topic_policies ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:policy_objectives_framework ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:policy_objectives_framework ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:applicability_statement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:policy_statement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:commitment_statements ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:communication_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty iso42001:next_policy_review_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:next_policy_review_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:policy_statement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty iso42001:acknowledgment_required ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:last_policy_review_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:applicability_statement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:commitment_statements ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:acknowledgment_required ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:acknowledgment_required ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:related_topic_policies ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:last_policy_review_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:next_policy_review_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty iso42001:communication_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:policy_statement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:applicability_statement ],
        iso42001:DocumentedInformation ;
    skos:closeMatch iso27001:InformationSecurityPolicy,
        iso29100:PrivacyPolicy ;
    skos:definition "The AI policy established by top management per Clause 5.2. Provides a framework for setting AI objectives and demonstrates commitment to responsible AI." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:note "Reviewed at planned intervals per Annex A.2.4",
        "Top-management AI policy per Clause 5.2; framework for AI objectives" ;
    iso42001:annex_a_reference "A.2" ;
    iso42001:iso42001_clause "5.2" ;
    iso42001:mandatory "true" .

iso42001:AIRiskTreatmentPlan a owl:Class ;
    rdfs:label "AIRiskTreatmentPlan" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:residual_risk_acceptance ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso42001:AIReferenceControl ;
            owl:onProperty iso42001:controls_to_implement ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso42001:AIRisk ;
            owl:onProperty iso42001:risks_addressed ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty iso42001:approved_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:treatment_actions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:resources_required ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:plan_scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:implementation_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:approved_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:completion_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:risks_addressed ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:treatment_actions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:completion_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso42001:ImplementationStatus ;
            owl:onProperty iso42001:implementation_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:residual_risk_acceptance ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:implementation_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty iso42001:completion_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:risk_owner_approval ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:resources_required ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:implementation_timeline ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:plan_scope ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:responsible_parties ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:risk_owner_approval ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:residual_risk_acceptance ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:plan_scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:implementation_timeline ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:risk_owner_approval ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:resources_required ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:approved_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:implementation_timeline ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:controls_to_implement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:responsible_parties ],
        iso42001:DocumentedInformation ;
    skos:closeMatch iso27001:RiskTreatmentPlan ;
    skos:definition "A plan documenting planned actions to address identified AI risks through selected controls. Requires approval by designated management per Clause 6.1.3." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:note "Requires approval by designated management and acceptance of residual risk per Clause 6.1.3",
        "Tracks controls, owners, timelines, and implementation status" ;
    skos:relatedMatch iso29100:PrivacySafeguardingRequirement,
        nist_ai_100_1:RiskTolerance,
        nist_ai_600_1:SuggestedAction ;
    iso42001:iso42001_clause "6.1.3" .

iso42001:ImprovementOpportunity a owl:Class ;
    rdfs:label "ImprovementOpportunity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:improvement_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:expected_benefit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:priority ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:target_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso42001:RiskLevel ;
            owl:onProperty iso42001:priority ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:identification_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:improvement_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:improvement_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
