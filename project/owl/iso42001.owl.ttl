	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	iso42001:iso42001_clause "6.1.2" .
iso42001:AimsRiskAssessment a owl:Class ;
	rdfs:label "AimsRiskAssessment" ;
	rdfs:subClassOf iso42001:AimsDocumentControlMixin , iso42001:AimsRecordMixin , _:c14n100 , _:c14n1075 , _:c14n1090 , _:c14n1173 , _:c14n1185 , _:c14n1217 , _:c14n1266 , _:c14n1341 , _:c14n1359 , _:c14n1408 , _:c14n1637 , _:c14n165 , _:c14n1769 , _:c14n207 , _:c14n233 , _:c14n250 , _:c14n285 , _:c14n38 , _:c14n398 , _:c14n548 , _:c14n597 , _:c14n612 , _:c14n686 , _:c14n788 , _:c14n884 , _:c14n994 ;
	skos:closeMatch iso27001:IsmsRiskAssessment ;
