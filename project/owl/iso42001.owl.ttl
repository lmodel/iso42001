    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:audit_type a owl:ObjectProperty ;
    rdfs:label "audit_type" ;
    rdfs:range iso42001:AuditType ;
    skos:definition "Type of audit (internal, external second-party, external third-party, surveillance, recertification, combined)." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:auditee_response a owl:DatatypeProperty ;
    rdfs:label "auditee_response" ;
    rdfs:range xsd:string ;
    skos:definition "Auditee's response to the finding." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:auditor_qualifications a owl:DatatypeProperty ;
    rdfs:label "auditor_qualifications" ;
    rdfs:range xsd:string ;
    skos:definition "Required auditor qualifications." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:author a owl:DatatypeProperty ;
    rdfs:label "author" ;
    rdfs:range xsd:string ;
    skos:definition "Person who created the document." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:autonomy_level a owl:DatatypeProperty ;
    rdfs:label "autonomy_level" ;
    rdfs:range xsd:string ;
    skos:definition "Description of the level of autonomy and human oversight required for this AI system. Free-form text complements `human_oversight_required` and `human_oversight_description`." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:availability_status a owl:DatatypeProperty ;
    rdfs:label "availability_status" ;
    rdfs:range xsd:string ;
    skos:definition "Current availability of the resource." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:awareness_program a owl:ObjectProperty ;
    rdfs:label "awareness_program" ;
    rdfs:range iso42001:AwarenessProgram ;
    skos:definition "Reference to the awareness program." ;
    skos:exactMatch iso27001:awareness_program ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:categorized_as_incident a owl:DatatypeProperty ;
    rdfs:label "categorized_as_incident" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the event has been categorized as an incident requiring response." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:certification_body a owl:DatatypeProperty ;
    rdfs:label "certification_body" ;
    rdfs:range xsd:string ;
    skos:definition "Body that issued the certification." ;
    skos:exactMatch iso27001:certification_body ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:certification_date a owl:DatatypeProperty ;
    rdfs:label "certification_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date the AIMS was certified." ;
    skos:exactMatch iso27001:certification_date ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:certification_status a owl:DatatypeProperty ;
    rdfs:label "certification_status" ;
    rdfs:range xsd:string ;
    skos:definition "Current certification status of the AIMS." ;
    skos:exactMatch iso27001:certification_status ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:change_control_requirements a owl:DatatypeProperty ;
    rdfs:label "change_control_requirements" ;
    rdfs:range xsd:string ;
    skos:definition "Requirements for controlling changes to the process." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:classification a owl:DatatypeProperty ;
    rdfs:label "classification" ;
    rdfs:range xsd:string ;
    skos:definition "Information classification level." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:clause_reference a owl:DatatypeProperty ;
    rdfs:label "clause_reference" ;
    rdfs:range xsd:string ;
    skos:definition "ISO/IEC 42001 clause referenced by the finding." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:climate_change_relevant a owl:DatatypeProperty ;
    rdfs:label "climate_change_relevant" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether climate change has been determined to be a relevant issue for the organization's context per Clause 4.1." ;
    skos:exactMatch iso27001:climate_change_relevant ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    iso42001:iso42001_clause "4.1" .

iso42001:closure_evidence a owl:DatatypeProperty ;
    rdfs:label "closure_evidence" ;
    rdfs:range xsd:string ;
    skos:definition "Evidence of closure." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:closure_status a owl:DatatypeProperty ;
    rdfs:label "closure_status" ;
    rdfs:range xsd:string ;
    skos:definition "Closure status of the finding." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:communication_date a owl:DatatypeProperty ;
    rdfs:label "communication_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date when the policy was communicated." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:communication_needs a owl:DatatypeProperty ;
    rdfs:label "communication_needs" ;
    rdfs:range xsd:string ;
    skos:definition "Communication requirements for this party." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:competency_assessment_date a owl:DatatypeProperty ;
    rdfs:label "competency_assessment_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date of last competency assessment." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:completion_date a owl:DatatypeProperty ;
    rdfs:label "completion_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date when implementation was completed." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:completion_tracking a owl:DatatypeProperty ;
    rdfs:label "completion_tracking" ;
    rdfs:range xsd:string ;
    skos:definition "How completion is tracked." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:concern_description a owl:DatatypeProperty ;
    rdfs:label "concern_description" ;
    rdfs:range xsd:string ;
    skos:definition "Paraphrased summary of the concern raised." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:confidentiality_level a owl:DatatypeProperty ;
    rdfs:label "confidentiality_level" ;
    rdfs:range xsd:string ;
    skos:definition "Confidentiality classification applied to the concern record (e.g., confidential, restricted, internal)." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:consequences_addressed a owl:DatatypeProperty ;
    rdfs:label "consequences_addressed" ;
    rdfs:range xsd:string ;
    skos:definition "How consequences were addressed." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:contact_information a owl:DatatypeProperty ;
    rdfs:label "contact_information" ;
    rdfs:range xsd:string ;
    skos:definition "Contact details for the party." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:contractual_basis a owl:DatatypeProperty ;
    rdfs:label "contractual_basis" ;
    rdfs:range xsd:string ;
    skos:definition "Contractual basis of the relationship." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:control_family a owl:ObjectProperty ;
    rdfs:label "control_family" ;
    rdfs:range iso42001:AIControlFamily ;
    skos:definition "Family of the Annex A control." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:control_id a owl:DatatypeProperty ;
    rdfs:label "control_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ a rdfs:Datatype ;
                        owl:unionOf ( iso42001:AnnexAControlId xsd:string ) ] xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^A\\.[0-9]{1,2}(\\.[0-9]{1,2})*$" ] ) ] ) ] ;
    skos:definition "Control identifier from Annex A (e.g., A.6.2.4). Accepts either an enumerated normative `AnnexAControlId` value or a free-form string for organization-defined controls beyond Annex A." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:note "Format matches Annex A numbering (A.<family>[.<subclause>][.<control>])",
        "Use AnnexAControlId for the 38 normative Annex A controls; use string for org-defined controls." .

iso42001:control_owner a owl:DatatypeProperty ;
    rdfs:label "control_owner" ;
    rdfs:range xsd:string ;
    skos:definition "Person responsible for the control." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:control_selection_criteria a owl:DatatypeProperty ;
    rdfs:label "control_selection_criteria" ;
    rdfs:range xsd:string ;
    skos:definition "Criteria for selecting Annex A controls." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:control_text a owl:DatatypeProperty ;
    rdfs:label "control_text" ;
    rdfs:range xsd:string ;
    skos:definition "Organization-authored control statement or external control summary. Do not include verbatim ISO/IEC standards text." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:control_title a owl:DatatypeProperty ;
    rdfs:label "control_title" ;
    rdfs:range xsd:string ;
    skos:definition "Title of the control." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:created_date a owl:DatatypeProperty ;
    rdfs:label "created_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date when the entity was created." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:data_classification a owl:DatatypeProperty ;
    rdfs:label "data_classification" ;
    rdfs:range xsd:string ;
    skos:definition "Classification of the data resource." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:data_processing_role a owl:DatatypeProperty ;
    rdfs:label "data_processing_role" ;
    rdfs:range xsd:string ;
    skos:definition "Role of the third party in data processing (e.g., PII controller, PII processor)." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:data_provenance a owl:DatatypeProperty ;
    rdfs:label "data_provenance" ;
    rdfs:range xsd:string ;
    skos:definition "Provenance information for the data resource." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    iso42001:annex_a_reference "A.7.5" .

iso42001:data_resource_category a owl:ObjectProperty ;
    rdfs:label "data_resource_category" ;
    rdfs:range iso42001:DataResourceCategory ;
    skos:definition "Category of data resource (training, validation, test, production)." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:delegation_rules a owl:DatatypeProperty ;
    rdfs:label "delegation_rules" ;
    rdfs:range xsd:string ;
    skos:definition "Rules for delegating responsibilities." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:deployment_context a owl:DatatypeProperty ;
    rdfs:label "deployment_context" ;
    rdfs:range xsd:string ;
    skos:definition "Operational context in which the AI system is deployed." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:definition "Detailed description of the entity." ;
    skos:exactMatch iso27001:description ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:detected_by a owl:DatatypeProperty ;
    rdfs:label "detected_by" ;
    rdfs:range xsd:string ;
    skos:definition "Person or process that detected the nonconformity." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:detection_date a owl:DatatypeProperty ;
    rdfs:label "detection_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date the nonconformity was detected." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:detection_method a owl:DatatypeProperty ;
    rdfs:label "detection_method" ;
    rdfs:range xsd:string ;
    skos:definition "How the incident was detected (monitoring alert, user report, external report)." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:document_reference a owl:DatatypeProperty ;
    rdfs:label "document_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Unique reference number for document control." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:document_type a owl:ObjectProperty ;
    rdfs:label "document_type" ;
    rdfs:range iso42001:DocumentType ;
    skos:definition "Classification of the documented information." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:effective_date a owl:DatatypeProperty ;
    rdfs:label "effective_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date when the document becomes effective." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:effectiveness_criteria a owl:DatatypeProperty ;
    rdfs:label "effectiveness_criteria" ;
    rdfs:range xsd:string ;
    skos:definition "Criteria for assessing effectiveness." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:effectiveness_measures a owl:DatatypeProperty ;
    rdfs:label "effectiveness_measures" ;
    rdfs:range xsd:string ;
    skos:definition "How effectiveness is measured." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:effectiveness_rating a owl:DatatypeProperty ;
    rdfs:label "effectiveness_rating" ;
    rdfs:range xsd:string ;
    skos:definition "Rating of control effectiveness." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:effectiveness_review_date a owl:DatatypeProperty ;
    rdfs:label "effectiveness_review_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date when effectiveness was reviewed." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:effectiveness_verified a owl:DatatypeProperty ;
    rdfs:label "effectiveness_verified" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether effectiveness was verified." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:employee_count a owl:DatatypeProperty ;
    rdfs:label "employee_count" ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Approximate number of employees." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:environment_type a owl:DatatypeProperty ;
    rdfs:label "environment_type" ;
    rdfs:range xsd:string ;
    skos:definition "Type of environment (development, staging, production)." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:escalation_status a owl:DatatypeProperty ;
    rdfs:label "escalation_status" ;
    rdfs:range xsd:string ;
    skos:definition "Whether and how the concern was escalated (internal management, governing body, external authority)." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:event_datetime a owl:DatatypeProperty ;
    rdfs:label "event_datetime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date and time the event was observed." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:event_description a owl:DatatypeProperty ;
    rdfs:label "event_description" ;
    rdfs:range xsd:string ;
    skos:definition "Free-text description of the event." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:event_log_policy a owl:DatatypeProperty ;
    rdfs:label "event_log_policy" ;
    rdfs:range xsd:string ;
    skos:definition "Policy for AI system event log recording across life cycle phases." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    iso42001:annex_a_reference "A.6.2.8" .

iso42001:event_source a owl:DatatypeProperty ;
    rdfs:label "event_source" ;
    rdfs:range xsd:string ;
    skos:definition "Source channel through which the event was raised (monitoring, user report, external report, audit)." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:exclusion_justification a owl:DatatypeProperty ;
    rdfs:label "exclusion_justification" ;
    rdfs:range xsd:string ;
    skos:definition "Justification for excluding the control." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    iso42001:iso42001_clause "6.1.3 f)" .

iso42001:expected_benefit a owl:DatatypeProperty ;
    rdfs:label "expected_benefit" ;
    rdfs:range xsd:string ;
    skos:definition "Expected benefit of the improvement." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:finding_description a owl:DatatypeProperty ;
    rdfs:label "finding_description" ;
    rdfs:range xsd:string ;
    skos:definition "Description of the finding." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:finding_type a owl:ObjectProperty ;
    rdfs:label "finding_type" ;
    rdfs:range iso42001:AuditFindingType ;
    skos:definition "Type of audit finding." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:governing_body a owl:DatatypeProperty ;
    rdfs:label "governing_body" ;
    rdfs:range xsd:string ;
    skos:definition "Reference to the governing body to which top management is accountable (Clause 3.22)." ;
    skos:exactMatch iso27001:governing_body ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    iso42001:iso42001_clause "3.22" .

iso42001:human_oversight_description a owl:DatatypeProperty ;
    rdfs:label "human_oversight_description" ;
    rdfs:range xsd:string ;
    skos:definition "Description of human-oversight arrangements, including review points, escalation paths, and oversight authority (Annex B.9.3)." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:human_oversight_required a owl:DatatypeProperty ;
    rdfs:label "human_oversight_required" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch nist_ai_100_1:human_ai_configuration ;
    skos:definition "Whether human oversight is required for outputs of the AI system (Annex A.9, Annex B.9.3)." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    iso42001:annex_a_reference "A.9" .

iso42001:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Unique identifier for the entity." ;
    skos:exactMatch iso27001:id ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:identification_date a owl:DatatypeProperty ;
    rdfs:label "identification_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date the improvement opportunity was identified." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:identified_by a owl:DatatypeProperty ;
    rdfs:label "identified_by" ;
    rdfs:range xsd:string ;
    skos:definition "Person who identified the improvement opportunity." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:impact a owl:ObjectProperty ;
    rdfs:label "impact" ;
    rdfs:range iso42001:ImpactRating ;
    skos:definition "Assessed consequence if the risk materializes." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    iso42001:iso42001_clause "6.1.2 d) 1)" .

iso42001:impact_assessment_results a owl:DatatypeProperty ;
    rdfs:label "impact_assessment_results" ;
    rdfs:range xsd:string ;
    skos:definition "Summary of AI system impact assessment results." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:impact_scale a owl:DatatypeProperty ;
    rdfs:label "impact_scale" ;
    rdfs:range xsd:string ;
    skos:definition "Scale used for impact rating." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:implementation_date a owl:DatatypeProperty ;
    rdfs:label "implementation_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date the control was implemented." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:implementation_evidence a owl:DatatypeProperty ;
    rdfs:label "implementation_evidence" ;
    rdfs:range xsd:string ;
    skos:definition "Evidence of control implementation." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:implementation_guidance a owl:DatatypeProperty ;
    rdfs:label "implementation_guidance" ;
    rdfs:range xsd:string ;
    skos:definition "Organization-authored implementation notes for the control." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:implementation_plan a owl:DatatypeProperty ;
    rdfs:label "implementation_plan" ;
    rdfs:range xsd:string ;
    skos:definition "Plan for implementing the improvement." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:implementation_timeline a owl:DatatypeProperty ;
    rdfs:label "implementation_timeline" ;
    rdfs:range xsd:string ;
    skos:definition "Timeline for implementation." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:implemented_count a owl:DatatypeProperty ;
    rdfs:label "implemented_count" ;
    rdfs:range xsd:unsignedShort ;
    skos:definition "Number of implemented controls." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:improvement_description a owl:DatatypeProperty ;
    rdfs:label "improvement_description" ;
    rdfs:range xsd:string ;
    skos:definition "Description of the improvement opportunity." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:improvement_source a owl:DatatypeProperty ;
    rdfs:label "improvement_source" ;
    rdfs:range xsd:string ;
    skos:definition "Source of the improvement opportunity." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:incident_category a owl:ObjectProperty ;
    rdfs:label "incident_category" ;
    rdfs:range iso42001:AIIncidentCategory ;
    skos:definition "AI-specific category of the incident." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    iso42001:annex_a_reference "A.8.4" .

iso42001:incident_datetime a owl:DatatypeProperty ;
    rdfs:label "incident_datetime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date and time the incident was declared or detected." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:incident_description a owl:DatatypeProperty ;
    rdfs:label "incident_description" ;
    rdfs:range xsd:string ;
    skos:definition "Free-text description of the incident." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:inclusion_justification a owl:DatatypeProperty ;
    rdfs:label "inclusion_justification" ;
    rdfs:range xsd:string ;
    skos:definition "Justification for including the control." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    iso42001:iso42001_clause "6.1.3 f)" .

iso42001:industry_sector a owl:DatatypeProperty ;
    rdfs:label "industry_sector" ;
    rdfs:range xsd:string ;
    skos:definition "Primary industry sector of the organization (free-form label)." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:inherent_risk_level a owl:ObjectProperty ;
    rdfs:label "inherent_risk_level" ;
    rdfs:range iso42001:RiskLevel ;
    skos:definition "Risk level before controls are applied." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:initial_assessment a owl:DatatypeProperty ;
    rdfs:label "initial_assessment" ;
    rdfs:range xsd:string ;
    skos:definition "Initial triage assessment of the event." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

