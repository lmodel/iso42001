        <https://w3id.org/lmodel/iso42001/AIRiskSourceCategory#machine_learning_specific>,
        <https://w3id.org/lmodel/iso42001/AIRiskSourceCategory#technology_readiness> .

iso42001:AIOrganizationalRole a owl:Class ;
    rdfs:label "AIOrganizationalRole" ;
    owl:unionOf ( <https://w3id.org/lmodel/iso42001/AIOrganizationalRole#ai_provider> <https://w3id.org/lmodel/iso42001/AIOrganizationalRole#ai_producer> <https://w3id.org/lmodel/iso42001/AIOrganizationalRole#ai_customer> <https://w3id.org/lmodel/iso42001/AIOrganizationalRole#ai_partner> <https://w3id.org/lmodel/iso42001/AIOrganizationalRole#ai_subject> <https://w3id.org/lmodel/iso42001/AIOrganizationalRole#relevant_authority> ) ;
