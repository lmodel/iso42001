    skos:definition "An AI system within the AIMS scope. Captures life cycle stage, intended use, applicable domains, and references to data and tooling resources, technical documentation, and impact assessments." ;
    skos:exactMatch iso22989:ai_system,
        nist_ai_100_1:AiSystem ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:note "AI systems are the primary unit to which impact assessments and incidents attach",
        "Captures life cycle stage, intended use, foreseeable misuse, and resource references per Annex A.6" ;
    skos:relatedMatch iso27001:Asset,
        nist_ai_600_1:GaiProfile ;
    iso42001:annex_a_reference "A.6" .

iso42001:RiskLevel a owl:Class ;
