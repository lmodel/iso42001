iso42001:TopicSpecificPolicy a owl:Class ;
    rdfs:label "TopicSpecificPolicy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:parent_policy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:topic_area ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:parent_policy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:topic_area ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:applicable_controls ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso42001:AIReferenceControl ;
            owl:onProperty iso42001:applicable_controls ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:target_audience ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:topic_area ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:target_audience ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:target_audience ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso42001:AIPolicy ;
            owl:onProperty iso42001:parent_policy ],
        iso42001:DocumentedInformation ;
    skos:definition "A topic-specific policy supporting the overarching AI policy, for example covering data governance, fairness, transparency, supplier use, or human oversight of AI systems." ;
    skos:exactMatch iso27001:TopicSpecificPolicy ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:note "Supports the overarching AI policy with topic-specific guidance (data, fairness, oversight)",
        "Typical topics: data governance, transparency, human oversight, supplier use" ;
    iso42001:annex_a_reference "A.2" .

iso42001:accountability a owl:DatatypeProperty ;
