	skos:definition "An action planned on a risk or an opportunity the system faces, with how it fits the system's processes and how its effect will be judged." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	iso42001:iso42001_clause "6.1.1" .
iso42001:AimsPolicy a owl:Class ;
	rdfs:label "AimsPolicy" ;
	rdfs:subClassOf iso42001:AimsDocumentControlMixin , iso42001:AimsRecordMixin , _:c14n1008 , _:c14n1012 , _:c14n1023 , _:c14n1109 , _:c14n1131 , _:c14n1219 , _:c14n1250 , _:c14n1295 , _:c14n13 , _:c14n1441 , _:c14n1481 , _:c14n15 , _:c14n154 , _:c14n1683 , _:c14n1747 , _:c14n1751 , _:c14n198 , _:c14n220 , _:c14n271 , _:c14n288 , _:c14n315 , _:c14n374 , _:c14n378 , _:c14n518 , _:c14n616 , _:c14n633 , _:c14n650 , _:c14n691 , _:c14n763 , _:c14n844 , _:c14n845 , _:c14n861 , _:c14n939 ;
	skos:closeMatch iso27001:IsmsPolicy ;
