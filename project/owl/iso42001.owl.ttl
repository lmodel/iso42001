<https://w3id.org/lmodel/iso42001/RiskTreatmentOption#accept> a owl:Class ;
    rdfs:label "accept" ;
    rdfs:subClassOf iso42001:RiskTreatmentOption ;
    skos:altLabel "retain" ;
    skos:definition "Accept the residual AI risk without further treatment, within risk appetite, with designated management approval." ;
    skos:exactMatch nist_ai_100_1:ACCEPTING .

<https://w3id.org/lmodel/iso42001/RiskTreatmentOption#avoid> a owl:Class ;
    rdfs:label "avoid" ;
    rdfs:subClassOf iso42001:RiskTreatmentOption ;
    skos:altLabel "terminate" ;
    skos:definition "Eliminate the AI risk by not undertaking the activity that creates it (for example, not deploying a high-risk AI use case)." ;
    skos:exactMatch nist_ai_100_1:AVOIDING .

<https://w3id.org/lmodel/iso42001/RiskTreatmentOption#modify> a owl:Class ;
    rdfs:label "modify" ;
    rdfs:subClassOf iso42001:RiskTreatmentOption ;
    skos:altLabel "mitigate",
        "reduce" ;
    skos:definition "Apply controls to change the AI risk level (reduce likelihood or consequence)." ;
    skos:exactMatch nist_ai_100_1:MITIGATING .

<https://w3id.org/lmodel/iso42001/RiskTreatmentOption#share> a owl:Class ;
    rdfs:label "share" ;
    rdfs:subClassOf iso42001:RiskTreatmentOption ;
    skos:altLabel "transfer" ;
    skos:definition "Transfer or share the AI risk with external parties (e.g., insurance, contractual transfer to a supplier or partner)." ;
    skos:exactMatch nist_ai_100_1:TRANSFERRING .

