iso42001:AIRiskSourceCategory a owl:Class ;
    rdfs:label "AIRiskSourceCategory" ;
    owl:unionOf ( <https://w3id.org/lmodel/iso42001/AIRiskSourceCategory#complexity_of_environment> <https://w3id.org/lmodel/iso42001/AIRiskSourceCategory#lack_of_transparency_or_explainability> <https://w3id.org/lmodel/iso42001/AIRiskSourceCategory#level_of_automation> <https://w3id.org/lmodel/iso42001/AIRiskSourceCategory#machine_learning_specific> <https://w3id.org/lmodel/iso42001/AIRiskSourceCategory#hardware> <https://w3id.org/lmodel/iso42001/AIRiskSourceCategory#lifecycle> <https://w3id.org/lmodel/iso42001/AIRiskSourceCategory#technology_readiness> ) ;
