<https://w3id.org/lmodel/iso42001.owl.ttl> a owl:Ontology ;
    rdfs:label "iso42001" ;
    dcterms:license "https://www.apache.org/licenses/LICENSE-2.0" ;
    dcterms:title "ISO 42001 / AIMS: LinkML Schema" ;
    pav:version "1.0.0" ;
    rdfs:seeAlso <https://lmodel.github.io/iso42001>,
        <https://www.iso.org/standard/81230.html> ;
    skos:definition """A comprehensive LinkML schema modeling AI Management System (AIMS) entities, workflows, and traceability links aligned to ISO/IEC 42001:2023 clause and Annex references. Designed for open data publication, automated validation, and integration with AI governance, risk, and compliance platforms.
This schema captures: - AIMS lifecycle (establish, implement, maintain, improve) - AI risk assessment, treatment, and AI system impact assessment (Clause 6.1) - Annex A reference control catalog (A.2-A.10) for responsible AI - Audit, measurement, and continual improvement artifacts - Data resources, tooling, computing, and human resources for AI systems - Third-party, supplier, and customer relationships across the AI life cycle""" ;
    iso42001:amendment_reference "Forward-compatibility placeholder for tracking amendments (AMD) and technical corrigenda (Cor) to ISO/IEC 42001:2023. Update when ISO/IEC publishes amendments to the base edition." ;
    iso42001:developing_committee "ISO/IEC JTC 1/SC 42 (Artificial Intelligence)" ;
    iso42001:harmonized_structure true ;
    iso42001:normative_reference "ISO/IEC 22989:2022 (AI concepts and terminology)" ;
    iso42001:related_standards "ISO/IEC 23894 (AI risk management guidance); ISO/IEC 38507 (Governance of IT - AI governance implications); ISO/IEC 5259 (Data quality for analytics and ML); ISO/IEC 5338 (AI system life cycle process); ISO/IEC 27001 (Information security management); ISO/IEC 27701 (Privacy information management); ISO 9001 (Quality management); ISO 31000 (Risk management)" ;
    iso42001:rights_notice "This project is licensed under Apache-2.0 for original schema structure and descriptions. ISO/IEC standards text is owned by ISO/IEC and is not reproduced verbatim by this project." ;
    iso42001:schema_maintainer "noel.mcloughlin@gmail.com" ;
    iso42001:schema_status "stable" ;
    iso42001:standard_date "2023-12" ;
    iso42001:standard_edition "First edition" ;
    iso42001:standard_reference "ISO/IEC 42001:2023(E)" ;
    iso42001:standard_title "Information technology - Artificial intelligence - Management system" .

