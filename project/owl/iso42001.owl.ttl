iso42001:action_plan a owl:DatatypeProperty ;
    rdfs:label "action_plan" ;
    rdfs:range xsd:string ;
    skos:definition "Plan for achieving the objective." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:ai_policy a owl:ObjectProperty ;
    rdfs:label "ai_policy" ;
    rdfs:range iso42001:AIPolicy ;
