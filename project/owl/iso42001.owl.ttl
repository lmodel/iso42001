	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	iso42001:annex_a_control "A.2.2" ;
	iso42001:iso42001_clause "5.2" .
iso42001:AimsRecordMixin a owl:Class ;
	rdfs:label "AimsRecordMixin" ;
	rdfs:subClassOf _:c14n1077 , _:c14n1145 , _:c14n139 , _:c14n1400 , _:c14n1710 , _:c14n185 , _:c14n311 , _:c14n833 , _:c14n979 ;
	skos:definition "What every record of the system has, so that other records can refer to it: an identifier, a title and a description." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	skos:note "It is a mixin, not a base class, so that the adapt copy can re-root some record classes on LOKF's Concept and leave the others as they are. lokf adapt replaces aims_id with LOKF's id, and a class that declares id itself must descend from Concept." .
iso42001:AimsReportingObligation a owl:Class ;
	rdfs:label "AimsReportingObligation" ;
	rdfs:subClassOf iso42001:AimsRecordMixin , _:c14n1034 , _:c14n1172 , _:c14n1319 , _:c14n1410 , _:c14n1428 , _:c14n1619 , _:c14n1650 , _:c14n1693 , _:c14n197 , _:c14n392 , _:c14n402 , _:c14n614 , _:c14n684 , _:c14n81 , _:c14n885 ;
	skos:definition "Something the organization must report about a system to an interested party: to whom, under what rule, what and how soon." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	iso42001:annex_a_control "A.8.5" .
iso42001:AimsResource a owl:Class ;
	rdfs:label "AimsResource" ;
	rdfs:subClassOf iso42001:AimsRecordMixin , _:c14n1137 , _:c14n1323 , _:c14n1340 , _:c14n1538 , _:c14n1561 , _:c14n1605 , _:c14n1685 , _:c14n328 , _:c14n471 , _:c14n510 , _:c14n627 , _:c14n69 , _:c14n753 , _:c14n761 , _:c14n772 , _:c14n799 , _:c14n914 , _:c14n938 ;
	skos:closeMatch iso27001:IsmsResource ;
