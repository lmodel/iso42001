iso42001:AimsRiskAssessmentProcess a owl:Class ;
	rdfs:label "AimsRiskAssessmentProcess" ;
	rdfs:subClassOf iso42001:AimsDocumentControlMixin , iso42001:AimsRecordMixin , _:c14n1015 , _:c14n1095 , _:c14n1132 , _:c14n1152 , _:c14n1165 , _:c14n1213 , _:c14n1255 , _:c14n1256 , _:c14n1291 , _:c14n1318 , _:c14n1348 , _:c14n1424 , _:c14n1577 , _:c14n1665 , _:c14n229 , _:c14n240 , _:c14n256 , _:c14n436 , _:c14n48 , _:c14n536 , _:c14n593 , _:c14n651 , _:c14n717 , _:c14n730 , _:c14n834 , _:c14n898 , _:c14n910 , _:c14n931 ;
	skos:closeMatch iso27001:IsmsRiskAssessmentProcess ;
	skos:definition "The organization's process for assessing AI risks: its criteria, scales and method, and when it runs." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	iso42001:iso42001_clause "6.1.2" .
iso42001:AimsRiskLevel\#critical a owl:Class ;
	rdfs:label "critical" ;
	rdfs:subClassOf iso42001:AimsRiskLevel ;
	skos:definition "Threatens the organization's objectives and needs action at once." .
iso42001:AimsRiskLevel\#high a owl:Class ;
	rdfs:label "high" ;
	rdfs:subClassOf iso42001:AimsRiskLevel ;
	skos:definition "Needs treatment first and escalation." .
iso42001:AimsRiskLevel\#low a owl:Class ;
	rdfs:label "low" ;
	rdfs:subClassOf iso42001:AimsRiskLevel ;
	skos:definition "Managed by routine procedures." .
iso42001:AimsRiskLevel\#medium a owl:Class ;
	rdfs:label "medium" ;
	rdfs:subClassOf iso42001:AimsRiskLevel ;
	skos:definition "Needs management's attention and planned controls." .
iso42001:AimsRiskLevel\#very_low a owl:Class ;
	rdfs:label "very_low" ;
	rdfs:subClassOf iso42001:AimsRiskLevel ;
	skos:definition "Small enough to need no action." .
iso42001:AimsRiskLevel a owl:Class ;
	rdfs:label "AimsRiskLevel" ;
	owl:unionOf _:c14n467 ;
	skos:definition "A five-point scale of risk level, for an organization that adopts it. ISO/IEC 42001 leaves the scale to the organization." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	linkml:permissible_values iso42001:AimsRiskLevel\#critical , iso42001:AimsRiskLevel\#high , iso42001:AimsRiskLevel\#low , iso42001:AimsRiskLevel\#medium , iso42001:AimsRiskLevel\#very_low .
iso42001:AimsRiskSourceCategory\#complex_environment a owl:Class ;
	rdfs:label "complex_environment" ;
	rdfs:subClassOf iso42001:AimsRiskSourceCategory ;
	skos:definition "A system works where situations vary widely, so its results are less sure." ;
	iso42001:annex_c_item "C.3.1" .
iso42001:AimsRiskSourceCategory\#hardware a owl:Class ;
	rdfs:label "hardware" ;
	rdfs:subClassOf iso42001:AimsRiskSourceCategory ;
	skos:definition "Faulty parts, or moving a trained model to other equipment." ;
	iso42001:annex_c_item "C.3.5" .
iso42001:AimsRiskSourceCategory\#level_of_automation a owl:Class ;
	rdfs:label "level_of_automation" ;
	rdfs:subClassOf iso42001:AimsRiskSourceCategory ;
	skos:definition "How much a system does alone, which bears on safety or fairness among others." ;
	iso42001:annex_c_item "C.3.3" .
iso42001:AimsRiskSourceCategory\#life_cycle a owl:Class ;
	rdfs:label "life_cycle" ;
	rdfs:subClassOf iso42001:AimsRiskSourceCategory ;
	skos:definition "Flaws anywhere in a system's life, from design to retirement." ;
	iso42001:annex_c_item "C.3.6" .
iso42001:AimsRiskSourceCategory\#machine_learning a owl:Class ;
	rdfs:label "machine_learning" ;
	rdfs:subClassOf iso42001:AimsRiskSourceCategory ;
	skos:definition "The data a model learns from, or how it was gathered, is flawed." ;
	iso42001:annex_c_item "C.3.4" .
iso42001:AimsRiskSourceCategory\#opaque_system a owl:Class ;
	rdfs:label "opaque_system" ;
	rdfs:subClassOf iso42001:AimsRiskSourceCategory ;
	skos:definition "The organization cannot tell people enough about a system." ;
	iso42001:annex_c_item "C.3.2" .
iso42001:AimsRiskSourceCategory\#other a owl:Class ;
	rdfs:label "other" ;
	rdfs:subClassOf iso42001:AimsRiskSourceCategory ;
	skos:definition "A source the organization names for itself." .
iso42001:AimsRiskSourceCategory\#technology_readiness a owl:Class ;
	rdfs:label "technology_readiness" ;
	rdfs:subClassOf iso42001:AimsRiskSourceCategory ;
	skos:definition "A technology is too new to know well, or so old it breeds complacency." ;
	iso42001:annex_c_item "C.3.7" .
iso42001:AimsRiskSourceCategory a owl:Class ;
	rdfs:label "AimsRiskSourceCategory" ;
	owl:unionOf _:c14n439 ;
	skos:definition "Kinds of source a risk from AI can come from: those Annex C lists, and other." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	linkml:permissible_values iso42001:AimsRiskSourceCategory\#complex_environment , iso42001:AimsRiskSourceCategory\#hardware , iso42001:AimsRiskSourceCategory\#level_of_automation , iso42001:AimsRiskSourceCategory\#life_cycle , iso42001:AimsRiskSourceCategory\#machine_learning , iso42001:AimsRiskSourceCategory\#opaque_system , iso42001:AimsRiskSourceCategory\#other , iso42001:AimsRiskSourceCategory\#technology_readiness ;
	iso42001:annex_c_item "C.3" .
iso42001:AimsRiskTreatmentOption\#avoid a owl:Class ;
	rdfs:label "avoid" ;
	rdfs:subClassOf iso42001:AimsRiskTreatmentOption ;
	skos:altLabel "terminate" ;
	skos:definition "Remove the risk by stopping or changing what gives rise to it." .
iso42001:AimsRiskTreatmentOption\#modify a owl:Class ;
	rdfs:label "modify" ;
	rdfs:subClassOf iso42001:AimsRiskTreatmentOption ;
	skos:altLabel "mitigate" , "reduce" ;
	skos:definition "Change the risk with controls that lower its likelihood or its consequences." .
iso42001:AimsRiskTreatmentOption\#retain a owl:Class ;
	rdfs:label "retain" ;
	rdfs:subClassOf iso42001:AimsRiskTreatmentOption ;
	skos:altLabel "accept" ;
	skos:definition "Keep the risk as it is, with management's approval." .
iso42001:AimsRiskTreatmentOption\#share a owl:Class ;
	rdfs:label "share" ;
	rdfs:subClassOf iso42001:AimsRiskTreatmentOption ;
	skos:altLabel "transfer" ;
	skos:definition "Share the risk with another party, such as an insurer or a supplier." .
iso42001:AimsRiskTreatmentOption a owl:Class ;
	rdfs:label "AimsRiskTreatmentOption" ;
	owl:unionOf _:c14n993 ;
	skos:definition "The ways of treating a risk, by the names ISO 31000 gives them." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	skos:note "ISO/IEC 42001 asks an organization to choose options and names none, so these come from ISO 31000, as they do in lmodel/iso27001." ;
	linkml:permissible_values iso42001:AimsRiskTreatmentOption\#avoid , iso42001:AimsRiskTreatmentOption\#modify , iso42001:AimsRiskTreatmentOption\#retain , iso42001:AimsRiskTreatmentOption\#share .
iso42001:AimsRiskTreatmentPlan a owl:Class ;
	rdfs:label "AimsRiskTreatmentPlan" ;
	rdfs:subClassOf iso42001:AimsDocumentControlMixin , iso42001:AimsRecordMixin , _:c14n1009 , _:c14n1016 , _:c14n1018 , _:c14n1040 , _:c14n1060 , _:c14n1076 , _:c14n1086 , _:c14n110 , _:c14n1227 , _:c14n1232 , _:c14n1261 , _:c14n1263 , _:c14n1265 , _:c14n1303 , _:c14n1362 , _:c14n1405 , _:c14n1469 , _:c14n1594 , _:c14n1725 , _:c14n1755 , _:c14n214 , _:c14n253 , _:c14n34 , _:c14n433 , _:c14n468 , _:c14n484 , _:c14n527 , _:c14n571 , _:c14n575 , _:c14n586 , _:c14n668 , _:c14n681 , _:c14n944 , _:c14n958 , _:c14n973 ;
