<https://w3id.org/lmodel/iso42001/RiskLevel#critical> a owl:Class ;
    rdfs:label "critical" ;
    rdfs:subClassOf iso42001:RiskLevel ;
    skos:definition "Severe AI risk threatening organizational objectives, individuals, or societies; requires immediate executive action." .

<https://w3id.org/lmodel/iso42001/RiskLevel#high> a owl:Class ;
    rdfs:label "high" ;
    rdfs:subClassOf iso42001:RiskLevel ;
    skos:definition "Significant AI risk requiring priority treatment and escalation." .

<https://w3id.org/lmodel/iso42001/RiskLevel#low> a owl:Class ;
    rdfs:label "low" ;
    rdfs:subClassOf iso42001:RiskLevel ;
    skos:definition "Minor AI risk manageable through routine procedures." .

<https://w3id.org/lmodel/iso42001/RiskLevel#medium> a owl:Class ;
    rdfs:label "medium" ;
    rdfs:subClassOf iso42001:RiskLevel ;
