            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:classification ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:effective_date ],
        [ owl:unionOf ( iso42001:AIPolicy iso42001:AIRiskAssessment iso42001:AIRiskAssessmentProcess iso42001:AIRiskTreatmentPlan iso42001:AIRiskTreatmentProcess iso42001:AISystemImpactAssessment iso42001:AISystemImpactAssessmentProcess iso42001:AuditProgramme iso42001:AwarenessProgram iso42001:CommunicationPlan iso42001:CompetenceRecord iso42001:InternalAudit iso42001:ManagementReview iso42001:MonitoringProgram iso42001:OperationalProcedure iso42001:StatementOfApplicability iso42001:TopicSpecificPolicy ) ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
