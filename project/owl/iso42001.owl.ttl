	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	iso42001:iso42001_clause "6.1.3" .
iso42001:AimsRole a owl:Class ;
	rdfs:label "AimsRole" ;
	rdfs:subClassOf iso42001:AimsRecordMixin , _:c14n1033 , _:c14n1078 , _:c14n1159 , _:c14n1184 , _:c14n1279 , _:c14n1302 , _:c14n1373 , _:c14n1413 , _:c14n143 , _:c14n1442 , _:c14n1607 , _:c14n1673 , _:c14n1694 , _:c14n1705 , _:c14n1706 , _:c14n284 , _:c14n313 , _:c14n466 , _:c14n617 , _:c14n630 , _:c14n660 , _:c14n770 , _:c14n795 , _:c14n877 , _:c14n92 , _:c14n932 ;
	skos:closeMatch iso27001:IsmsRole , oscal:Role ;
