	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	iso42001:iso42001_clause "7.1" .
iso42001:AimsResourceProvider\#customer a owl:Class ;
	rdfs:label "customer" ;
	rdfs:subClassOf iso42001:AimsResourceProvider ;
	skos:definition "One of its customers." .
iso42001:AimsResourceProvider\#organization a owl:Class ;
	rdfs:label "organization" ;
	rdfs:subClassOf iso42001:AimsResourceProvider ;
	skos:definition "The organization itself." .
iso42001:AimsResourceProvider\#third_party a owl:Class ;
	rdfs:label "third_party" ;
	rdfs:subClassOf iso42001:AimsResourceProvider ;
	skos:definition "Someone else." .
iso42001:AimsResourceProvider a owl:Class ;
	rdfs:label "AimsResourceProvider" ;
	owl:unionOf _:c14n1622 ;
	skos:definition "Who provides a resource an AI system draws on." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	linkml:permissible_values iso42001:AimsResourceProvider\#customer , iso42001:AimsResourceProvider\#organization , iso42001:AimsResourceProvider\#third_party ;
	iso42001:annex_b_item "B.4.2" .
