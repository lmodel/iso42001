        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:societal_context ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:assessor ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:mitigations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:assessment_scope ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
