        <https://w3id.org/lmodel/iso42001/DataResourceCategory#validation> .

iso42001:ImpactRating a owl:Class ;
    rdfs:label "ImpactRating" ;
    owl:unionOf ( <https://w3id.org/lmodel/iso42001/ImpactRating#negligible> <https://w3id.org/lmodel/iso42001/ImpactRating#minor> <https://w3id.org/lmodel/iso42001/ImpactRating#moderate> <https://w3id.org/lmodel/iso42001/ImpactRating#major> <https://w3id.org/lmodel/iso42001/ImpactRating#severe> ) ;
