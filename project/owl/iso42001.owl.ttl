	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	iso42001:iso42001_clause "4.1" .
iso42001:AimsPiiRole\#joint_pii_controller a owl:Class ;
	rdfs:label "joint_pii_controller" ;
	rdfs:subClassOf iso42001:AimsPiiRole ;
	skos:definition "Makes those decisions together with another party." .
iso42001:AimsPiiRole\#pii_controller a owl:Class ;
	rdfs:label "pii_controller" ;
	rdfs:subClassOf iso42001:AimsPiiRole ;
	skos:definition "Decides why and how personal data is processed." .
iso42001:AimsPiiRole\#pii_processor a owl:Class ;
	rdfs:label "pii_processor" ;
	rdfs:subClassOf iso42001:AimsPiiRole ;
	skos:definition "Processes personal data on a controller's behalf." .
