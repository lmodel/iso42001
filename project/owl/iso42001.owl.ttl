            owl:onProperty iso42001:related_controls ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:process_criteria ],
        iso42001:DocumentedInformation ;
    skos:definition "A documented procedure for operational planning and control of AIMS processes per Clause 8.1, including AI system life cycle related controls." ;
    skos:exactMatch iso27001:OperationalProcedure ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:note "Operational planning and control per Clause 8.1",
        "Should cover AI life-cycle controls implemented via 6.1.3" ;
    skos:relatedMatch iso29100:PIIProcessingActivity ;
    iso42001:iso42001_clause "8.1" .

iso42001:Organization a owl:Class ;
