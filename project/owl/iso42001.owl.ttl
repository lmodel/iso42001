        "Risk source categories drawn from Annex C" ;
    skos:relatedMatch iso29100:PrivacyRisk ;
    iso42001:iso42001_clause "6.1.2" .

iso42001:DataResourceCategory a owl:Class ;
    rdfs:label "DataResourceCategory" ;
    owl:unionOf ( <https://w3id.org/lmodel/iso42001/DataResourceCategory#training> <https://w3id.org/lmodel/iso42001/DataResourceCategory#validation> <https://w3id.org/lmodel/iso42001/DataResourceCategory#test> <https://w3id.org/lmodel/iso42001/DataResourceCategory#production> <https://w3id.org/lmodel/iso42001/DataResourceCategory#reference> ) ;
