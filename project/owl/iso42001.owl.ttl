iso42001:LearningParadigm a owl:Class ;
    rdfs:label "LearningParadigm" ;
    owl:unionOf ( <https://w3id.org/lmodel/iso42001/LearningParadigm#static> <https://w3id.org/lmodel/iso42001/LearningParadigm#periodic_retraining> <https://w3id.org/lmodel/iso42001/LearningParadigm#continuous_learning> <https://w3id.org/lmodel/iso42001/LearningParadigm#online_learning> <https://w3id.org/lmodel/iso42001/LearningParadigm#transfer_learning> <https://w3id.org/lmodel/iso42001/LearningParadigm#reinforcement_learning> <https://w3id.org/lmodel/iso42001/LearningParadigm#hybrid> <https://w3id.org/lmodel/iso42001/LearningParadigm#not_applicable> ) ;
