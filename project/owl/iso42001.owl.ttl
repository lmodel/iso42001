    linkml:permissible_values <https://w3id.org/lmodel/iso42001/ImpactRating#major>,
        <https://w3id.org/lmodel/iso42001/ImpactRating#minor>,
        <https://w3id.org/lmodel/iso42001/ImpactRating#moderate>,
        <https://w3id.org/lmodel/iso42001/ImpactRating#negligible>,
        <https://w3id.org/lmodel/iso42001/ImpactRating#severe> .

iso42001:LikelihoodRating a owl:Class ;
    rdfs:label "LikelihoodRating" ;
    owl:unionOf ( <https://w3id.org/lmodel/iso42001/LikelihoodRating#rare> <https://w3id.org/lmodel/iso42001/LikelihoodRating#unlikely> <https://w3id.org/lmodel/iso42001/LikelihoodRating#possible> <https://w3id.org/lmodel/iso42001/LikelihoodRating#likely> <https://w3id.org/lmodel/iso42001/LikelihoodRating#almost_certain> ) ;
