iso42001:MLApproach a owl:Class ;
    rdfs:label "MLApproach" ;
    owl:unionOf ( <https://w3id.org/lmodel/iso42001/MLApproach#supervised> <https://w3id.org/lmodel/iso42001/MLApproach#unsupervised> <https://w3id.org/lmodel/iso42001/MLApproach#semi_supervised> <https://w3id.org/lmodel/iso42001/MLApproach#self_supervised> <https://w3id.org/lmodel/iso42001/MLApproach#reinforcement> <https://w3id.org/lmodel/iso42001/MLApproach#transfer> <https://w3id.org/lmodel/iso42001/MLApproach#federated> <https://w3id.org/lmodel/iso42001/MLApproach#generative> <https://w3id.org/lmodel/iso42001/MLApproach#symbolic> <https://w3id.org/lmodel/iso42001/MLApproach#hybrid> <https://w3id.org/lmodel/iso42001/MLApproach#not_applicable> ) ;
