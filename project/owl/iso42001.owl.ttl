iso42001:DataPreparationMethod a owl:Class ;
    rdfs:label "DataPreparationMethod" ;
    owl:unionOf ( <https://w3id.org/lmodel/iso42001/DataPreparationMethod#statistical_exploration> <https://w3id.org/lmodel/iso42001/DataPreparationMethod#cleaning> <https://w3id.org/lmodel/iso42001/DataPreparationMethod#imputation> <https://w3id.org/lmodel/iso42001/DataPreparationMethod#normalization> <https://w3id.org/lmodel/iso42001/DataPreparationMethod#scaling> <https://w3id.org/lmodel/iso42001/DataPreparationMethod#labelling> <https://w3id.org/lmodel/iso42001/DataPreparationMethod#encoding> <https://w3id.org/lmodel/iso42001/DataPreparationMethod#augmentation> <https://w3id.org/lmodel/iso42001/DataPreparationMethod#deduplication> <https://w3id.org/lmodel/iso42001/DataPreparationMethod#anonymization> <https://w3id.org/lmodel/iso42001/DataPreparationMethod#other> ) ;
