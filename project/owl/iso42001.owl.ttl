	rdfs:label "AimsPiiRole" ;
	owl:unionOf _:c14n205 ;
	skos:definition "The parts a party can play when personal data passes through AI, which ISO/IEC 29100 describes." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	linkml:permissible_values iso42001:AimsPiiRole\#joint_pii_controller , iso42001:AimsPiiRole\#pii_controller , iso42001:AimsPiiRole\#pii_processor ;
	iso42001:annex_b_item "B.10.2" .
iso42001:AimsPlannedAction a owl:Class ;
	rdfs:label "AimsPlannedAction" ;
