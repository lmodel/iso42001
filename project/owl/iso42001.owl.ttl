            owl:onProperty iso42001:responsible_party ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:improvement_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:expected_benefit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:implementation_plan ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:identification_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:implementation_plan ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:expected_benefit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:responsible_party ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty iso42001:target_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:responsible_party ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:implementation_plan ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:priority ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:outcome_assessment ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty iso42001:identification_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:outcome_assessment ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:improvement_source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty iso42001:actual_completion_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:improvement_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:identified_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:target_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:identified_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:identified_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:actual_completion_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:status ],
        iso42001:NamedEntity ;
    skos:definition "An opportunity for continual improvement of the AIMS per Clause 10.1." ;
    skos:exactMatch iso27001:ImprovementOpportunity ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:note "Continual improvement opportunity per Clause 10.1",
        "May originate from audit, review, monitoring, or interested-party feedback" ;
    iso42001:iso42001_clause "10.1" .

