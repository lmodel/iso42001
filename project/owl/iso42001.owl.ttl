        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:id ],
        [ owl:unionOf ( iso42001:AIIncident iso42001:AIManagementSystem iso42001:AIObjective iso42001:AIReferenceControl iso42001:AIRisk iso42001:AISystem iso42001:AISystemEvent iso42001:AuditFinding iso42001:ComputingResource iso42001:ConcernReport iso42001:CorrectiveAction iso42001:DataResource iso42001:DocumentedInformation iso42001:HumanResource iso42001:ImprovementOpportunity iso42001:InterestedParty iso42001:Nonconformity iso42001:Organization iso42001:Resource iso42001:Role iso42001:ThirdPartyRelationship iso42001:ToolingResource ) ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:created_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:modified_date ] ;
    skos:definition "Abstract base class for all entities with an identifier, name, and description. Provides common identification and documentation slots." ;
    skos:exactMatch iso27001:NamedEntity ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:note "All concrete classes should inherit from this or a subclass" .

