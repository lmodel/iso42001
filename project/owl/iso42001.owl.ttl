xsd:duration a rdfs:Datatype ;
	owl:equivalentClass _:c14n258 .
<https://w3id.org/lmodel/iso42001.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://www.iso.org/standard/81230.html> ;
	dcterms:title "ISO/IEC 42001:2023 AI management system records" ;
	pav:version "2023" ;
	a owl:Ontology ;
	rdfs:label "iso42001" ;
	rdfs:seeAlso <https://lmodel.github.io/iso42001> , <https://www.iso.org/standard/74296.html> , <https://www.iso.org/standard/81230.html> ;
	skos:definition "A LinkML model of the records an organization keeps to run an artificial intelligence (AI) management system under ISO/IEC 42001:2023. The records cover its context, leadership, planning and support, how it weighs and treats AI risks, and what its AI systems may do to people and society. They also cover those systems with their resources, data and documents, its audits and reviews, and what it corrects and improves. The reference controls of Annex A appear by number, with titles of this project's own." ;
	skos:note "A close mapping to lmodel/iso27001 names the class that answers to the same clause number, since both standards follow the harmonized structure of management system standards. AimsOrganization and AimsRole are the same kind of thing as SPDX's Organization and OSCAL's Role. AimsControl is related to OSCAL's Control: both name a safeguard, but OSCAL's is a catalogue entry and this one is the organization's own." , "Every record that other records refer to has an aims_id, and a reference holds that identifier. AimsManagementSystem holds each kind of record in a list of its own." , "ISO/IEC 42001 is copyright ISO and IEC, and none of its text is reproduced here. An element cites what it models by number, in the iso42001_clause, annex_a_control, annex_b_item, annex_c_item or annex_d_item annotation, and its title and description are this project's own words. A licence holder can merge the standard's wording into a private copy with the overlay that src/iso42001/schema/OVERLAY.md describes." , "The terms follow ISO/IEC 22989:2022, the one normative reference, and so do the stages of a system's life and the kinds of AI role. Annexes C and D are informative and give examples, so an enum built from one of them has the value other." , "The version is the edition the schema models, and source is ISO's page for it. ISO Open Data's records of the edition and of its normative reference are copied to src/iso42001/schema/iso-open-data/ on the date the annotations give, and scripts/check_upstream_release.py reports when ISO changes them. The release tags are the schema's own versions." ;
	iso42001:edition "1" ;
	iso42001:iso_open_data_date "2026-11-05" ;
	iso42001:normative_reference "ISO/IEC 22989:2022" ;
	iso42001:publication_date "2023-12-18" ;
	iso42001:standard "ISO/IEC 42001:2023" .
iso42001:AimsAiRole\#ai_customer a owl:Class ;
	rdfs:label "ai_customer" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Takes AI systems from a provider." .
iso42001:AimsAiRole\#ai_deployer a owl:Class ;
	rdfs:label "ai_deployer" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Puts a system into service." ;
	iso42001:role_family "ai_producer" .
iso42001:AimsAiRole\#ai_designer a owl:Class ;
	rdfs:label "ai_designer" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Decides how a system should work." ;
	iso42001:role_family "ai_producer" .
iso42001:AimsAiRole\#ai_developer a owl:Class ;
	rdfs:label "ai_developer" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Writes and trains what goes into a system." ;
	iso42001:role_family "ai_producer" .
iso42001:AimsAiRole\#ai_governance_professional a owl:Class ;
	rdfs:label "ai_governance_professional" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Oversees how AI is run and held to account." ;
	iso42001:role_family "ai_producer" .
iso42001:AimsAiRole\#ai_human_factor_professional a owl:Class ;
	rdfs:label "ai_human_factor_professional" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Looks after how people and a system work together." ;
	iso42001:role_family "ai_producer" .
iso42001:AimsAiRole\#ai_impact_assessor a owl:Class ;
	rdfs:label "ai_impact_assessor" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Weighs what a system may do to people and society." ;
	iso42001:role_family "ai_producer" .
iso42001:AimsAiRole\#ai_operator a owl:Class ;
	rdfs:label "ai_operator" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Keeps a system running." ;
	iso42001:role_family "ai_producer" .
iso42001:AimsAiRole\#ai_partner a owl:Class ;
	rdfs:label "ai_partner" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Helps others make or run AI systems." .
iso42001:AimsAiRole\#ai_platform_provider a owl:Class ;
	rdfs:label "ai_platform_provider" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Offers a platform that others build AI services on." ;
	iso42001:role_family "ai_provider" .
iso42001:AimsAiRole\#ai_producer a owl:Class ;
	rdfs:label "ai_producer" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Makes AI systems." .
iso42001:AimsAiRole\#ai_product_or_service_provider a owl:Class ;
	rdfs:label "ai_product_or_service_provider" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Offers goods or services that hold an AI system." ;
	iso42001:role_family "ai_provider" .
iso42001:AimsAiRole\#ai_provider a owl:Class ;
	rdfs:label "ai_provider" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Offers AI systems or platforms to others." .
iso42001:AimsAiRole\#ai_subject a owl:Class ;
	rdfs:label "ai_subject" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Is affected by what a system decides or does." .
iso42001:AimsAiRole\#ai_system_integrator a owl:Class ;
	rdfs:label "ai_system_integrator" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Joins a system to others." ;
	iso42001:role_family "ai_partner" .
iso42001:AimsAiRole\#ai_tester_or_evaluator a owl:Class ;
	rdfs:label "ai_tester_or_evaluator" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Checks how well a system does." ;
	iso42001:role_family "ai_producer" .
iso42001:AimsAiRole\#ai_user a owl:Class ;
	rdfs:label "ai_user" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Works with a system directly." ;
	iso42001:role_family "ai_customer" .
iso42001:AimsAiRole\#data_provider a owl:Class ;
	rdfs:label "data_provider" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Supplies data for a system." ;
	iso42001:role_family "ai_partner" .
iso42001:AimsAiRole\#data_subject a owl:Class ;
	rdfs:label "data_subject" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Is someone a system's data is about." ;
	iso42001:role_family "ai_subject" .
iso42001:AimsAiRole\#domain_expert a owl:Class ;
	rdfs:label "domain_expert" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Knows the field a system is used in." ;
	iso42001:role_family "ai_producer" .
iso42001:AimsAiRole\#other_subject a owl:Class ;
	rdfs:label "other_subject" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Is affected in some other way." ;
	iso42001:role_family "ai_subject" .
iso42001:AimsAiRole\#policymaker a owl:Class ;
	rdfs:label "policymaker" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Sets the rules." ;
	iso42001:role_family "relevant_authority" .
iso42001:AimsAiRole\#procurer a owl:Class ;
	rdfs:label "procurer" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Buys systems or their parts." ;
	iso42001:role_family "ai_producer" .
iso42001:AimsAiRole\#regulator a owl:Class ;
	rdfs:label "regulator" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Enforces the rules." ;
	iso42001:role_family "relevant_authority" .
iso42001:AimsAiRole\#relevant_authority a owl:Class ;
	rdfs:label "relevant_authority" ;
	rdfs:subClassOf iso42001:AimsAiRole ;
	skos:definition "Sets or enforces rules for AI." .
iso42001:AimsAiRole a owl:Class ;
	rdfs:label "AimsAiRole" ;
	owl:unionOf _:c14n1529 ;
	skos:definition "The parts an organization or a person can play towards AI systems. The six families are those of ISO/IEC 22989:2022, and each more specific role names its family in an annotation." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	skos:note "The standard says the list is open, so a part it does not name takes the family it falls under." ;
	linkml:permissible_values iso42001:AimsAiRole\#ai_customer , iso42001:AimsAiRole\#ai_deployer , iso42001:AimsAiRole\#ai_designer , iso42001:AimsAiRole\#ai_developer , iso42001:AimsAiRole\#ai_governance_professional , iso42001:AimsAiRole\#ai_human_factor_professional , iso42001:AimsAiRole\#ai_impact_assessor , iso42001:AimsAiRole\#ai_operator , iso42001:AimsAiRole\#ai_partner , iso42001:AimsAiRole\#ai_platform_provider , iso42001:AimsAiRole\#ai_producer , iso42001:AimsAiRole\#ai_product_or_service_provider , iso42001:AimsAiRole\#ai_provider , iso42001:AimsAiRole\#ai_subject , iso42001:AimsAiRole\#ai_system_integrator , iso42001:AimsAiRole\#ai_tester_or_evaluator , iso42001:AimsAiRole\#ai_user , iso42001:AimsAiRole\#data_provider , iso42001:AimsAiRole\#data_subject , iso42001:AimsAiRole\#domain_expert , iso42001:AimsAiRole\#other_subject , iso42001:AimsAiRole\#policymaker , iso42001:AimsAiRole\#procurer , iso42001:AimsAiRole\#regulator , iso42001:AimsAiRole\#relevant_authority ;
	iso42001:iso42001_clause "4.1" .
iso42001:AimsAiSystem a owl:Class ;
	rdfs:label "AimsAiSystem" ;
	rdfs:subClassOf iso42001:AimsRecordMixin , _:c14n1028 , _:c14n1066 , _:c14n1108 , _:c14n1114 , _:c14n1133 , _:c14n1200 , _:c14n1225 , _:c14n1237 , _:c14n1264 , _:c14n1300 , _:c14n1306 , _:c14n1350 , _:c14n1375 , _:c14n1403 , _:c14n1411 , _:c14n1427 , _:c14n1470 , _:c14n1511 , _:c14n1525 , _:c14n1553 , _:c14n1563 , _:c14n1569 , _:c14n1578 , _:c14n1598 , _:c14n1630 , _:c14n1638 , _:c14n1642 , _:c14n1655 , _:c14n1670 , _:c14n1684 , _:c14n1686 , _:c14n169 , _:c14n1698 , _:c14n1701 , _:c14n1729 , _:c14n1764 , _:c14n1765 , _:c14n1768 , _:c14n186 , _:c14n190 , _:c14n204 , _:c14n242 , _:c14n249 , _:c14n275 , _:c14n290 , _:c14n334 , _:c14n347 , _:c14n357 , _:c14n39 , _:c14n4 , _:c14n409 , _:c14n472 , _:c14n482 , _:c14n487 , _:c14n505 , _:c14n516 , _:c14n521 , _:c14n525 , _:c14n622 , _:c14n65 , _:c14n663 , _:c14n683 , _:c14n710 , _:c14n75 , _:c14n77 , _:c14n776 , _:c14n794 , _:c14n808 , _:c14n825 , _:c14n836 , _:c14n88 , _:c14n892 , _:c14n911 , _:c14n957 , _:c14n960 , _:c14n985 ;
	skos:definition "One AI system under the management system: what it is for, how it is built, run and overseen, what it draws on, and what is kept about it." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	iso42001:annex_a_control "A.6.2.2" ;
	iso42001:iso42001_clause "4.1" .
iso42001:AimsAiThreat\#data_poisoning a owl:Class ;
	rdfs:label "data_poisoning" ;
	rdfs:subClassOf iso42001:AimsAiThreat ;
	skos:definition "Slipping bad data in to spoil what a model learns." .
iso42001:AimsAiThreat\#model_inversion a owl:Class ;
	rdfs:label "model_inversion" ;
	rdfs:subClassOf iso42001:AimsAiThreat ;
	skos:definition "Working back from a model to the data it learned from." .
iso42001:AimsAiThreat\#model_stealing a owl:Class ;
	rdfs:label "model_stealing" ;
	rdfs:subClassOf iso42001:AimsAiThreat ;
	skos:definition "Copying a model by querying it or by taking it." .
iso42001:AimsAiThreat\#other a owl:Class ;
	rdfs:label "other" ;
	rdfs:subClassOf iso42001:AimsAiThreat ;
	skos:definition "A threat the organization names for itself." .
iso42001:AimsAiThreat a owl:Class ;
	rdfs:label "AimsAiThreat" ;
	owl:unionOf _:c14n764 ;
	skos:definition "Threats to information security peculiar to AI: those the guidance names, and other." ;
	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	linkml:permissible_values iso42001:AimsAiThreat\#data_poisoning , iso42001:AimsAiThreat\#model_inversion , iso42001:AimsAiThreat\#model_stealing , iso42001:AimsAiThreat\#other ;
	iso42001:annex_b_item "B.6.2.3, B.6.2.6" .
iso42001:AimsAnnexAControl\#a_10_2 dcterms:title "A.10.2 Sharing out duties" ;
	a owl:Class ;
	rdfs:label "a_10_2" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Settle who carries which duty across a system's life, among the organization and those it deals with." ;
	iso42001:area "external_relationships" .
iso42001:AimsAnnexAControl\#a_10_3 dcterms:title "A.10.3 What is bought in" ;
	a owl:Class ;
	rdfs:label "a_10_3" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Keep a process that holds what suppliers provide to how the organization means to treat AI." ;
	iso42001:area "external_relationships" .
iso42001:AimsAnnexAControl\#a_10_4 dcterms:title "A.10.4 Buyers' needs" ;
	a owl:Class ;
	rdfs:label "a_10_4" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "See that how the organization treats AI takes account of what its customers expect and want." ;
	iso42001:area "external_relationships" .
iso42001:AimsAnnexAControl\#a_2_2 dcterms:title "A.2.2 Written direction on AI" ;
	a owl:Class ;
	rdfs:label "a_2_2" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Set down in writing how the organization means to treat AI systems." ;
	iso42001:area "policy_direction" .
iso42001:AimsAnnexAControl\#a_2_3 dcterms:title "A.2.3 Fit with other policies" ;
	a owl:Class ;
	rdfs:label "a_2_3" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Find where the organization's other policies touch its aims for AI, in either direction." ;
	iso42001:area "policy_direction" .
iso42001:AimsAnnexAControl\#a_2_4 dcterms:title "A.2.4 Regular policy check" ;
	a owl:Class ;
	rdfs:label "a_2_4" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Look at the AI policy again on a schedule and whenever the need arises, to see that it still serves." ;
	iso42001:area "policy_direction" .
iso42001:AimsAnnexAControl\#a_3_2 dcterms:title "A.3.2 Who answers for what" ;
	a owl:Class ;
	rdfs:label "a_3_2" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Decide who carries which duty for AI, as the organization's needs dictate." ;
	iso42001:area "accountability" .
iso42001:AimsAnnexAControl\#a_3_3 dcterms:title "A.3.3 A way to raise worries" ;
	a owl:Class ;
	rdfs:label "a_3_3" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Give people a way to raise worries about the organization's part in a system, at any point in that system's life." ;
	iso42001:area "accountability" .
iso42001:AimsAnnexAControl\#a_4_2 dcterms:title "A.4.2 Inventory of what is needed" ;
	a owl:Class ;
	rdfs:label "a_4_2" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "List what each stage of a system's life, and other AI work, draws on." ;
	iso42001:area "system_resources" .
iso42001:AimsAnnexAControl\#a_4_3 dcterms:title "A.4.3 Record of data used" ;
	a owl:Class ;
	rdfs:label "a_4_3" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Record facts about the data a system draws on." ;
	iso42001:area "system_resources" .
iso42001:AimsAnnexAControl\#a_4_4 dcterms:title "A.4.4 Record of tools used" ;
	a owl:Class ;
	rdfs:label "a_4_4" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Record facts about the tools a system draws on." ;
	iso42001:area "system_resources" .
iso42001:AimsAnnexAControl\#a_4_5 dcterms:title "A.4.5 Record of infrastructure used" ;
	a owl:Class ;
	rdfs:label "a_4_5" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Record facts about the hardware and computing a system draws on." ;
	iso42001:area "system_resources" .
iso42001:AimsAnnexAControl\#a_4_6 dcterms:title "A.4.6 Record of people used" ;
	a owl:Class ;
	rdfs:label "a_4_6" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Record who works on a system across its whole life, and what skills they bring." ;
	iso42001:area "system_resources" .
iso42001:AimsAnnexAControl\#a_5_2 dcterms:title "A.5.2 Method for weighing consequences" ;
	a owl:Class ;
	rdfs:label "a_5_2" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Set up a way to work out what a system could do to people and society over its life." ;
	iso42001:area "impact_assessment" .
iso42001:AimsAnnexAControl\#a_5_3 dcterms:title "A.5.3 Keeping assessment results" ;
	a owl:Class ;
	rdfs:label "a_5_3" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Write down what each impact assessment found, and hold on to it for a set time." ;
	iso42001:area "impact_assessment" .
iso42001:AimsAnnexAControl\#a_5_4 dcterms:title "A.5.4 Effects on people" ;
	a owl:Class ;
	rdfs:label "a_5_4" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Work out and record how a system could affect single persons or particular groups over its life." ;
	iso42001:area "impact_assessment" .
iso42001:AimsAnnexAControl\#a_5_5 dcterms:title "A.5.5 Effects on society" ;
	a owl:Class ;
	rdfs:label "a_5_5" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Work out and record how a system could affect society over its life." ;
	iso42001:area "impact_assessment" .
iso42001:AimsAnnexAControl\#a_6_1_2 dcterms:title "A.6.1.2 Goals for building" ;
	a owl:Class ;
	rdfs:label "a_6_1_2" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Set goals that steer responsible building, and work measures for them into the development cycle." ;
	iso42001:area "system_life_cycle" ;
	iso42001:control_objective "A.6.1" .
iso42001:AimsAnnexAControl\#a_6_1_3 dcterms:title "A.6.1.3 Defined ways of building" ;
	a owl:Class ;
	rdfs:label "a_6_1_3" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Set down the particular processes for designing and building a system responsibly." ;
	iso42001:area "system_life_cycle" ;
	iso42001:control_objective "A.6.1" .
iso42001:AimsAnnexAControl\#a_6_2_2 dcterms:title "A.6.2.2 What a system must do" ;
	a owl:Class ;
	rdfs:label "a_6_2_2" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Write down what a new system, or a large upgrade to one, must meet." ;
	iso42001:area "system_life_cycle" ;
	iso42001:control_objective "A.6.2" .
iso42001:AimsAnnexAControl\#a_6_2_3 dcterms:title "A.6.2.3 Build records" ;
	a owl:Class ;
	rdfs:label "a_6_2_3" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Write down how a system was designed and built, against the goals and the requirements." ;
	iso42001:area "system_life_cycle" ;
	iso42001:control_objective "A.6.2" .
iso42001:AimsAnnexAControl\#a_6_2_4 dcterms:title "A.6.2.4 Checks and their criteria" ;
	a owl:Class ;
	rdfs:label "a_6_2_4" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Set the checks that verify and validate a system, and say when each applies." ;
	iso42001:area "system_life_cycle" ;
	iso42001:control_objective "A.6.2" .
iso42001:AimsAnnexAControl\#a_6_2_5 dcterms:title "A.6.2.5 Going live" ;
	a owl:Class ;
	rdfs:label "a_6_2_5" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Keep a plan for putting a system into service, and meet its conditions first." ;
	iso42001:area "system_life_cycle" ;
	iso42001:control_objective "A.6.2" .
iso42001:AimsAnnexAControl\#a_6_2_6 dcterms:title "A.6.2.6 Running and watching" ;
	a owl:Class ;
	rdfs:label "a_6_2_6" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Set down what keeping a system in service takes: at least watching it, fixing it, updating it and supporting it." ;
	iso42001:area "system_life_cycle" ;
	iso42001:control_objective "A.6.2" .
iso42001:AimsAnnexAControl\#a_6_2_7 dcterms:title "A.6.2.7 Documents per audience" ;
	a owl:Class ;
