	skos:inScheme <https://w3id.org/lmodel/iso42001> ;
	iso42001:iso42001_clause "6.1.3, 8.3" .
iso42001:AimsRiskTreatmentProcess a owl:Class ;
	rdfs:label "AimsRiskTreatmentProcess" ;
	rdfs:subClassOf iso42001:AimsDocumentControlMixin , iso42001:AimsRecordMixin , _:c14n1083 , _:c14n1099 , _:c14n1321 , _:c14n1458 , _:c14n1558 , _:c14n1667 , _:c14n195 , _:c14n199 , _:c14n338 , _:c14n535 , _:c14n565 , _:c14n569 , _:c14n610 , _:c14n661 , _:c14n680 , _:c14n778 , _:c14n886 , _:c14n91 , _:c14n949 , _:c14n959 , _:c14n974 ;
	skos:closeMatch iso27001:IsmsRiskTreatmentProcess ;
