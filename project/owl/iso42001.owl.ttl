            owl:minCardinality 0 ;
            owl:onProperty iso42001:related_controls ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:responsible_roles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:control_measures ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:change_control_requirements ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:procedure_scope ],
        [ a owl:Restriction ;
