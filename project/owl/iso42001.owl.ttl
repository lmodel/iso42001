	a owl:Class ;
	rdfs:label "a_7_6" ;
	rdfs:subClassOf iso42001:AimsAnnexAControl ;
	skos:definition "Set criteria for choosing how data is made ready, and name the methods to use." ;
	iso42001:area "data_management" .
