            owl:onProperty iso42001:incident_datetime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty iso42001:notifications_made ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty iso42001:detection_method ],
        [ a owl:Restriction ;
            owl:allValuesFrom iso42001:ImpactAssessmentDimension ;
            owl:onProperty iso42001:affected_dimensions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:incident_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty iso42001:detection_method ],
        [ a owl:Restriction ;
