    skos:definition "A documented relationship with a third party (supplier, partner, or customer) involved in the AI system life cycle per A.10." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:note "Documented relationship per Annex A.10 capturing responsibility allocation",
        "Specialized into SupplierRelationship and CustomerRelationship" ;
    skos:relatedMatch iso27001:InterestedParty ;
    iso42001:annex_a_reference "A.10" .

iso42001:AuditFindingType a owl:Class ;
    rdfs:label "AuditFindingType" ;
    owl:unionOf ( <https://w3id.org/lmodel/iso42001/AuditFindingType#major_nonconformity> <https://w3id.org/lmodel/iso42001/AuditFindingType#minor_nonconformity> <https://w3id.org/lmodel/iso42001/AuditFindingType#observation> <https://w3id.org/lmodel/iso42001/AuditFindingType#positive_finding> ) ;
    skos:definition "Classification of internal audit findings for the AIMS." ;
    skos:exactMatch iso27001:AuditFindingType ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    linkml:permissible_values <https://w3id.org/lmodel/iso42001/AuditFindingType#major_nonconformity>,
        <https://w3id.org/lmodel/iso42001/AuditFindingType#minor_nonconformity>,
        <https://w3id.org/lmodel/iso42001/AuditFindingType#observation>,
        <https://w3id.org/lmodel/iso42001/AuditFindingType#positive_finding> .

iso42001:RiskTreatmentOption a owl:Class ;
    rdfs:label "RiskTreatmentOption" ;
    owl:unionOf ( <https://w3id.org/lmodel/iso42001/RiskTreatmentOption#modify> <https://w3id.org/lmodel/iso42001/RiskTreatmentOption#accept> <https://w3id.org/lmodel/iso42001/RiskTreatmentOption#avoid> <https://w3id.org/lmodel/iso42001/RiskTreatmentOption#share> ) ;
    skos:definition "Standard risk treatment options drawn from ISO 31000 and adapted for AI risk treatment per Clause 6.1.3." ;
    skos:exactMatch iso27001:RiskTreatmentOption,
        nist_ai_100_1:RiskResponseEnum ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    linkml:permissible_values <https://w3id.org/lmodel/iso42001/RiskTreatmentOption#accept>,
        <https://w3id.org/lmodel/iso42001/RiskTreatmentOption#avoid>,
        <https://w3id.org/lmodel/iso42001/RiskTreatmentOption#modify>,
        <https://w3id.org/lmodel/iso42001/RiskTreatmentOption#share> .

iso42001:actual_completion_date a owl:DatatypeProperty ;
    rdfs:label "actual_completion_date" ;
    rdfs:range xsd:date ;
    skos:definition "Actual completion date." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:affected_ai_systems a owl:ObjectProperty ;
    rdfs:label "affected_ai_systems" ;
    rdfs:range iso42001:AISystem ;
    skos:closeMatch iso27001:affected_assets ;
    skos:definition "AI systems affected by this risk." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> ;
    skos:relatedMatch nist_ai_600_1:risk_scope .

iso42001:approved_by a owl:DatatypeProperty ;
    rdfs:label "approved_by" ;
    rdfs:range xsd:string ;
    skos:definition "Person who approved the document." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:approved_date a owl:DatatypeProperty ;
    rdfs:label "approved_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date when the document was approved." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:assessment_criteria a owl:DatatypeProperty ;
    rdfs:label "assessment_criteria" ;
    rdfs:range xsd:string ;
    skos:definition "Criteria for performing AI risk or impact assessments." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:assessment_date a owl:DatatypeProperty ;
    rdfs:label "assessment_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date the assessment was conducted." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:assessment_frequency a owl:DatatypeProperty ;
    rdfs:label "assessment_frequency" ;
    rdfs:range xsd:string ;
    skos:definition "Planned frequency of assessments." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:assessment_methodology a owl:DatatypeProperty ;
    rdfs:label "assessment_methodology" ;
    rdfs:range xsd:string ;
    skos:definition "Methodology used for assessment." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:assessment_scope a owl:DatatypeProperty ;
    rdfs:label "assessment_scope" ;
    rdfs:range xsd:string ;
    skos:definition "Scope of the assessment." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:assessor a owl:DatatypeProperty ;
    rdfs:label "assessor" ;
    rdfs:range xsd:string ;
    skos:definition "Person or team who conducted the assessment." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:closure_date a owl:DatatypeProperty ;
    rdfs:label "closure_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date when the item was closed." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:closure_datetime a owl:DatatypeProperty ;
    rdfs:label "closure_datetime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date and time the incident was closed." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:communication_plan a owl:ObjectProperty ;
    rdfs:label "communication_plan" ;
    rdfs:range iso42001:CommunicationPlan ;
    skos:definition "Reference to the communication plan." ;
    skos:exactMatch iso27001:communication_plan ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:control_reference a owl:ObjectProperty ;
    rdfs:label "control_reference" ;
    rdfs:range iso42001:AIReferenceControl ;
    skos:definition "Reference to an Annex A control (e.g., A.6.2.4)." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:cost a owl:DatatypeProperty ;
    rdfs:label "cost" ;
    rdfs:range xsd:string ;
    skos:definition "Cost of the resource." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:current_value a owl:DatatypeProperty ;
    rdfs:label "current_value" ;
    rdfs:range xsd:string ;
    skos:definition "Current measured value." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:frequency a owl:DatatypeProperty ;
    rdfs:label "frequency" ;
    rdfs:range xsd:string ;
    skos:definition "Frequency of the activity." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:measurement_frequency a owl:DatatypeProperty ;
    rdfs:label "measurement_frequency" ;
    rdfs:range xsd:string ;
    skos:definition "How often measurement is performed." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:measurement_method a owl:DatatypeProperty ;
    rdfs:label "measurement_method" ;
    rdfs:range xsd:string ;
    skos:definition "Method used to measure the metric." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:next_assessment_date a owl:DatatypeProperty ;
    rdfs:label "next_assessment_date" ;
    rdfs:range xsd:date ;
    skos:definition "Planned date for next assessment." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:party_type a owl:DatatypeProperty ;
    rdfs:label "party_type" ;
    rdfs:range xsd:string ;
    skos:definition "Category of party." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:quantity a owl:DatatypeProperty ;
    rdfs:label "quantity" ;
    rdfs:range xsd:string ;
    skos:definition "Quantity of the resource." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:related_controls a owl:ObjectProperty ;
    rdfs:label "related_controls" ;
    rdfs:range iso42001:AIReferenceControl ;
    skos:definition "Other reference controls related to this one." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:reporter a owl:DatatypeProperty ;
    rdfs:label "reporter" ;
    rdfs:range xsd:string ;
    skos:definition "Identifier or description of the person or system that reported the event." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:reporter_party_type a owl:DatatypeProperty ;
    rdfs:label "reporter_party_type" ;
    rdfs:range xsd:string ;
    skos:definition "Type of party that reported the event (internal user, external interested party, monitoring system, etc.)." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:responsible_role a owl:ObjectProperty ;
    rdfs:label "responsible_role" ;
    rdfs:range iso42001:Role ;
    skos:definition "Role responsible for the objective or control." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:review_date a owl:DatatypeProperty ;
    rdfs:label "review_date" ;
    rdfs:range xsd:date ;
    skos:definition "Date when the document is due for review." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:root_cause a owl:DatatypeProperty ;
    rdfs:label "root_cause" ;
    rdfs:range xsd:string ;
    skos:definition "Identified root cause." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:severity a owl:ObjectProperty ;
    rdfs:label "severity" ;
    rdfs:range iso42001:RiskLevel ;
    skos:definition "Severity rating of the incident." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:target_audience a owl:DatatypeProperty ;
    rdfs:label "target_audience" ;
    rdfs:range xsd:string ;
    skos:definition "Intended audience for the policy or document." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:target_date a owl:DatatypeProperty ;
    rdfs:label "target_date" ;
    rdfs:range xsd:date ;
    skos:definition "Target date for achieving the objective." ;
    skos:inScheme <https://w3id.org/lmodel/iso42001> .

iso42001:AIIncident a owl:Class ;
    rdfs:label "AIIncident" ;
