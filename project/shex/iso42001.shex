<NamedEntity>  (
    @<AIIncident> OR @<AIManagementSystem> OR @<AIObjective> OR @<AIReferenceControl> OR @<AIRisk> OR @<AISystem> OR
    @<AISystemEvent> OR @<AuditFinding> OR @<ComputingResource> OR @<ConcernReport> OR @<CorrectiveAction> OR @<DataResource> OR
    @<DocumentedInformation> OR @<HumanResource> OR @<ImprovementOpportunity> OR @<InterestedParty> OR @<Nonconformity> OR
    @<Organization> OR @<Resource> OR @<Role> OR @<ThirdPartyRelationship> OR @<ToolingResource>
)

<NamedEntity_struct> {
    (  $<NamedEntity_tes> (  <name> @linkml:String ;
          <description> @linkml:String ? ;
          <created_date> @linkml:Date ? ;
          <modified_date> @linkml:Date ? ;
          <version> @linkml:String ?
       ) ;
       rdf:type [ <NamedEntity> ]
    )
}

<Nonconformity> CLOSED {
    (  $<Nonconformity_tes> (  &<NamedEntity_tes> ;
