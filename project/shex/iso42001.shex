<DocumentedInformation>  (
    @<AIPolicy> OR @<AIRiskAssessment> OR @<AIRiskAssessmentProcess> OR @<AIRiskTreatmentPlan> OR @<AIRiskTreatmentProcess> OR
    @<AISystemImpactAssessment> OR @<AISystemImpactAssessmentProcess> OR @<AuditProgramme> OR @<AwarenessProgram> OR
    @<CommunicationPlan> OR @<CompetenceRecord> OR @<InternalAudit> OR @<ManagementReview> OR @<MonitoringProgram> OR
    @<OperationalProcedure> OR @<StatementOfApplicability> OR @<TopicSpecificPolicy>
)

