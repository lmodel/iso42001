<AimsAudit> CLOSED {
    (  $<AimsAudit_tes> (  &<AimsRecordMixin_tes> ;
          rdf:type [ <AimsRecordMixin> ] ? ;
          &<AimsDocumentControlMixin_tes> ;
          rdf:type [ <AimsDocumentControlMixin> ] ? ;
          <aims_audit_type> [ <https://w3id.org/lmodel/iso42001/AimsAuditType#first_party>
             <https://w3id.org/lmodel/iso42001/AimsAuditType#second_party>
             <https://w3id.org/lmodel/iso42001/AimsAuditType#third_party> ] ;
          <aims_audit_standards> [ <https://w3id.org/lmodel/iso42001/AimsManagementSystemStandard#iso_iec_27001>
             <https://w3id.org/lmodel/iso42001/AimsManagementSystemStandard#iso_iec_27701>
             <https://w3id.org/lmodel/iso42001/AimsManagementSystemStandard#iso_9001>
             <https://w3id.org/lmodel/iso42001/AimsManagementSystemStandard#iso_22000>
             <https://w3id.org/lmodel/iso42001/AimsManagementSystemStandard#iso_13485>
             <https://w3id.org/lmodel/iso42001/AimsManagementSystemStandard#other> ] * ;
          <aims_audit_scope> @linkml:String ? ;
          <aims_audit_criteria> @linkml:String * ;
          <aims_audit_objectives> @linkml:String * ;
          <aims_audit_period_start> @linkml:Date ? ;
          <aims_audit_period_end> @linkml:Date ? ;
          <aims_audit_lead> @linkml:String ? ;
          <aims_audit_team> @linkml:String * ;
          <aims_audit_auditees> @linkml:String * ;
          <aims_audit_plan> @<AimsDocumentedInformation> ? ;
          <aims_audit_findings> @<AimsAuditFinding> * ;
          <aims_audit_conclusion> @linkml:String ? ;
          <aims_audit_report_date> @linkml:Date ? ;
          <aims_audit_report_distribution> @linkml:String * ;
          schema1:name @linkml:String ;
          schema1:description @linkml:String ? ;
          <aims_document_reference> @linkml:String ? ;
          <aims_document_version> @linkml:String ? ;
          <aims_document_author> @linkml:String ? ;
          <aims_document_owner> @linkml:String ? ;
          <aims_document_format> @linkml:String ? ;
          <aims_document_medium> @linkml:String ? ;
          <aims_document_approver> @linkml:String ? ;
          <aims_document_approval_date> @linkml:Date ? ;
          <aims_document_effective_date> @linkml:Date ? ;
          <aims_document_last_review_date> @linkml:Date ? ;
          <aims_document_next_review_date> @linkml:Date ? ;
          <aims_document_status> @linkml:String ? ;
          <aims_document_classification> @linkml:String ? ;
          <aims_document_retention> @<AimsDuration> ? ;
          <aims_document_disposition> @linkml:String ? ;
          <aims_document_distribution> @linkml:String * ;
          <aims_document_storage> @linkml:String ? ;
          <aims_document_change_control> @linkml:String ? ;
          <aims_document_external_origin> @linkml:Boolean ? ;
          <aims_document_external_source> @linkml:String ?
       ) ;
       rdf:type [ <AimsAudit> ]
    )
}

