             <https://w3id.org/lmodel/iso42001/AIOrganizationalRole#ai_subject>
             <https://w3id.org/lmodel/iso42001/AIOrganizationalRole#relevant_authority> ] * ;
          <climate_change_relevant> @linkml:Boolean ?
       ) ;
       rdf:type [ <Organization> ]
    )
}

