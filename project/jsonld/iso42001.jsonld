    {
      "name": "ConcernReport",
      "definition_uri": "https://w3id.org/lmodel/iso42001/ConcernReport",
      "annotations": [
        {
          "tag": "annex_a_reference",
          "value": "A.3.3",
          "@type": "Annotation"
        }
      ],
      "description": "A concern raised by employees, contractors, users, or other interested parties about the organization's role with respect to an AI system. Operationalises Annex A.3.3 (Reporting of concerns). Confidentiality, anonymity, anti-reprisal protection, escalation, and timely response are core attributes; informed by ISO 37002.",
      "comments": [
        "First-class entity supporting A.3.3 concern-reporting workflows distinct from AIIncident",
        "Anonymity and anti-reprisal protections are required even when reporter identity is captured",
        "Reference: ISO/IEC 42001:2023 Annex A.3.3 (paraphrased); related guidance ISO 37002. ISO standards text is copyright ISO/IEC - not reproduced here."
      ],
      "in_subset": [
        "annex_a_controls",
        "performance_evaluation"
      ],
      "from_schema": "https://w3id.org/lmodel/iso42001",
      "related_mappings": [
        "iso27001:Nonconformity",
        "nist_ai_100_1:Harm",
        "nist_ai_600_1:StructuredPublicFeedback"
      ],
