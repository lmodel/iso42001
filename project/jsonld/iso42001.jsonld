          "name": "aims_document_external_source",
          "annotations": [
            {
              "tag": "iso42001_clause",
              "value": "7.5.3",
              "@type": "Annotation"
            }
          ],
          "description": "Who the document came from, when it comes from outside.",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/iso42001/AimsDocumentControlMixin",
      "@type": "ClassDefinition"
