          "@type": "SlotDefinition"
        },
        {
          "name": "aims_control_last_tested",
          "description": "When the control was last tested.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "aims_control_evidence",
          "description": "Where the evidence that the control is in place is kept.",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/iso42001/AimsControl",
      "@type": "ClassDefinition"
