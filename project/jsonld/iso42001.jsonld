      "name": "AimsApplicabilityEntry",
      "definition_uri": "https://w3id.org/lmodel/iso42001/AimsApplicabilityEntry",
      "annotations": [
        {
          "tag": "iso42001_clause",
          "value": "6.1.3",
          "@type": "Annotation"
        }
      ],
      "description": "One entry of the Statement of Applicability, which either includes a control or leaves one out, and says why.",
      "comments": [
        "An entry may hold for the whole system or for particular AI systems, which aims_ai_systems names."
      ],
      "in_subset": [
        "aims_annex_a"
      ],
      "from_schema": "https://w3id.org/lmodel/iso42001",
      "close_mappings": [
        "iso27001:IsmsApplicabilityEntry"
      ],
      "abstract": true,
      "slots": [
        "AimsApplicabilityEntry_aims_entry_type",
        "aims_entry_annex_a_control",
        "aims_ai_systems",
        "aimsApplicabilityEntry__aims_entry_justification"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "aims_entry_justification",
          "description": "Why the control is included or left out.",
          "required": true,
          "pattern": "^\\s*\\S",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/iso42001/AimsApplicabilityEntry",
      "@type": "ClassDefinition"
    },
