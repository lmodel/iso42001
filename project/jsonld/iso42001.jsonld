    {
      "name": "control_id",
      "definition_uri": "https://w3id.org/lmodel/iso42001/control_id",
      "description": "Control identifier from Annex A (e.g., A.6.2.4). Accepts either an enumerated normative `AnnexAControlId` value or a free-form string for organization-defined controls beyond Annex A.",
      "comments": [
        "Format matches Annex A numbering (A.<family>[.<subclause>][.<control>])",
        "Use AnnexAControlId for the 38 normative Annex A controls; use string for org-defined controls."
      ],
      "from_schema": "https://w3id.org/lmodel/iso42001",
      "slot_uri": "https://w3id.org/lmodel/iso42001/control_id",
      "owner": "AIReferenceControl",
      "domain_of": [
        "AIReferenceControl"
      ],
      "range": "string",
      "pattern": "^A\\.[0-9]{1,2}(\\.[0-9]{1,2})*$",
      "any_of": [
        {
          "range": "AnnexAControlId",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "string",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
