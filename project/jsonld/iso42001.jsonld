    {
      "name": "AISystemEvent",
      "definition_uri": "https://w3id.org/lmodel/iso42001/AISystemEvent",
      "annotations": [
        {
          "tag": "annex_a_reference",
          "value": "A.6.2.8, A.8.3",
          "@type": "Annotation"
        }
      ],
      "description": "An AI system event detected by monitoring, users, or external reporting channels. Events may or may not be subsequently classified as incidents. Supports A.6.2.8 event log capture and A.8.3 external reporting workflows.",
      "comments": [
        "First-class entity allowing event records to attach to A.6.2.8 logs and A.8.3 reports",
        "Reference: ISO/IEC 42001:2023 Annex A controls A.6.2.8, A.8.3. ISO/IEC standards text is copyright ISO/IEC - not reproduced here."
      ],
      "in_subset": [
