    {
      "name": "AIReferenceControl",
      "definition_uri": "https://w3id.org/lmodel/iso42001/AIReferenceControl",
      "annotations": [
        {
          "tag": "iso42001_clause",
          "value": "6.1.3",
          "@type": "Annotation"
        },
        {
          "tag": "annex_reference",
          "value": "Annex A",
          "@type": "Annotation"
        }
      ],
      "description": "A reference control from Annex A of ISO/IEC 42001:2023. Controls are grouped into nine families (A.2 through A.10) and supported by implementation guidance in Annex B.",
      "comments": [
        "Reference: ISO/IEC 42001:2023 Annex A and Annex B. ISO/IEC standards text is copyright ISO/IEC - not reproduced here.",
        "The control_text slot must contain organization-authored content only, not ISO/IEC standards text."
      ],
      "in_subset": [
        "annex_a_controls"
      ],
      "from_schema": "https://w3id.org/lmodel/iso42001",
      "close_mappings": [
