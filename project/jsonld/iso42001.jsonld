    {
      "name": "AimsControl",
      "definition_uri": "https://w3id.org/lmodel/iso42001/AimsControl",
      "annotations": [
        {
          "tag": "iso42001_clause",
          "value": "6.1.3",
          "@type": "Annotation"
        }
      ],
      "description": "A control the organization has found it needs to treat its risks: what it does in the organization's words, which Annex A controls it answers to, who owns it, how far it is in place and how well it works.",
      "comments": [
        "The text and guidance are the organization's own words, never the text of ISO/IEC 42001. A control from another source names no Annex A control."
      ],
      "in_subset": [
        "aims_annex_a"
      ],
      "from_schema": "https://w3id.org/lmodel/iso42001",
      "close_mappings": [
        "iso27001:IsmsControl"
      ],
      "related_mappings": [
        "oscal:Control"
      ],
      "mixins": [
        "AimsRecordMixin"
      ],
