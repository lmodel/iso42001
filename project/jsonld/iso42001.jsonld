      "@type": "ClassDefinition"
    },
    {
      "name": "DocumentedInformation",
      "definition_uri": "https://w3id.org/lmodel/iso42001/DocumentedInformation",
      "annotations": [
        {
          "tag": "iso42001_clause",
          "value": "7.5",
          "@type": "Annotation"
        }
      ],
      "description": "Abstract class for documented information per Clause 7.5. Captures metadata required for document control under the AIMS.",
      "comments": [
        "Captures Clause 7.5 metadata needed for document control, review, and retention",
        "Sub-classes inherit document_type, owner, approval, and review-date slots"
      ],
      "in_subset": [
        "documented_information"
      ],
      "from_schema": "https://w3id.org/lmodel/iso42001",
      "exact_mappings": [
        "iso27001:DocumentedInformation"
      ],
      "close_mappings": [
        "nist_ai_100_1:PlaybookEntry"
      ],
