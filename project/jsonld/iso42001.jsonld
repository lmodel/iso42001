        "aims_ai_systems",
        "aims_objective_categories",
        "aims_risk_source_categories",
        "aimsControl__aims_control_area",
        "aimsControl__aims_control_text",
        "aimsControl__aims_control_guidance",
        "aimsControl__aims_control_owner",
        "aimsControl__aims_control_implementation_date",
        "aimsControl__aims_control_effectiveness",
        "aimsControl__aims_control_last_tested",
        "aimsControl__aims_control_evidence",
        "aims_id",
        "AimsRecordMixin_title",
        "description"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "aims_control_area",
          "description": "Which of Annex A's nine areas the control belongs to.",
          "range": "AimsControlArea",
          "@type": "SlotDefinition"
        },
        {
          "name": "aims_control_text",
          "description": "What the control does, in the organization's own words.",
          "@type": "SlotDefinition"
        },
        {
          "name": "aims_control_guidance",
          "description": "The organization's notes on putting the control in place.",
          "@type": "SlotDefinition"
        },
        {
          "name": "aims_control_owner",
          "description": "The person who owns the control.",
          "@type": "SlotDefinition"
        },
        {
          "name": "aims_control_implementation_date",
          "description": "When the control was put in place.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "aims_control_effectiveness",
          "annotations": [
            {
              "tag": "iso42001_clause",
              "value": "8.1",
