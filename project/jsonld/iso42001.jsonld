        "description",
        "created_date",
        "modified_date",
        "version",
        "document_type",
        "document_reference",
        "author",
        "owner",
        "approved_by",
        "approved_date",
        "effective_date",
        "review_date",
        "status",
        "classification",
        "retention_period"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/iso42001/DocumentedInformation",
      "@type": "ClassDefinition"
    },
    {
      "name": "AIManagementSystem",
      "definition_uri": "https://w3id.org/lmodel/iso42001/AIManagementSystem",
      "annotations": [
        {
          "tag": "iso42001_clause",
          "value": "4.4",
          "@type": "Annotation"
        },
        {
          "tag": "mandatory",
          "value": "true",
          "@type": "Annotation"
        }
      ],
      "description": "Top-level container representing an organization's complete AI Management System (AIMS) per ISO/IEC 42001:2023. Aggregates all components required to support the AIMS lifecycle.",
      "comments": [
        "Root entity for any ISO/IEC 42001 conformance dataset",
        "Reference: ISO/IEC 42001:2023 Clause 4.4. ISO/IEC standards text is copyright ISO/IEC - not reproduced here."
      ],
      "in_subset": [
        "aims_core"
      ],
      "from_schema": "https://w3id.org/lmodel/iso42001",
      "close_mappings": [
        "iso27001:InformationSecurityManagementSystem",
        "nist_ai_100_1:AiRmfFramework"
      ],
      "related_mappings": [
        "iso29100:PrivacyFramework",
        "nist_ai_600_1:GaiProfile"
      ],
      "is_a": "NamedEntity",
      "slots": [
