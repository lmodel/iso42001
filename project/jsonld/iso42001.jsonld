    {
      "name": "NamedEntity",
      "definition_uri": "https://w3id.org/lmodel/iso42001/NamedEntity",
      "description": "Abstract base class for all entities with an identifier, name, and description. Provides common identification and documentation slots.",
      "comments": [
        "All concrete classes should inherit from this or a subclass"
      ],
      "from_schema": "https://w3id.org/lmodel/iso42001",
