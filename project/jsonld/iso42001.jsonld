    {
      "name": "AIIncident",
      "definition_uri": "https://w3id.org/lmodel/iso42001/AIIncident",
      "annotations": [
        {
          "tag": "annex_a_reference",
          "value": "A.8.3, A.8.4",
          "@type": "Annotation"
        }
      ],
      "description": "An AI incident, i.e., an AI system event determined to require response, escalation, or external communication. Captures triage, response lifecycle, and communications to users and other interested parties per A.8.4 and A.8.3.",
      "comments": [
        "Provides the entity to which A.8.4 communication plans and A.8.3 external reports attach",
        "AI-specific categories (data poisoning, model stealing, prompt injection, etc.) supplement classical infosec incident classes",
        "Reference: ISO/IEC 42001:2023 Annex A controls A.8.3, A.8.4. ISO/IEC standards text is copyright ISO/IEC - not reproduced here."
      ],
      "in_subset": [
