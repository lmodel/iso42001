	linkml:annotations _:c14n269 , _:c14n597 ;
	linkml:description "The data AI systems use: how it is managed, obtained, kept fit, traced and readied." .
<https://w3id.org/lmodel/iso42001/data_poisoning> linkml:description "Slipping bad data in to spoil what a model learns." .
<https://w3id.org/lmodel/iso42001/data_provider> linkml:annotations _:c14n337 ;
	linkml:description "Supplies data for a system." .
<https://w3id.org/lmodel/iso42001/data_subject> linkml:annotations _:c14n457 ;
	linkml:description "Is someone a system's data is about." .
<https://w3id.org/lmodel/iso42001/date> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date\"." , "URI is dateTime because OWL reasoners don't work with straight date or time" ;
	skos:exactMatch "schema:Date"^^xsd:anyURI ;
