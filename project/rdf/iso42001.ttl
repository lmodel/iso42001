<https://w3id.org/lmodel/iso42001/AimsUserInformation> OIO:inSubset <https://w3id.org/lmodel/iso42001/aims_ai_system_records> , <https://w3id.org/lmodel/iso42001/aims_documented_information> ;
	a linkml:ClassDefinition ;
	skos:inScheme "https://w3id.org/lmodel/iso42001"^^xsd:anyURI ;
	linkml:annotations _:c14n219 ;
	linkml:attributes <https://w3id.org/lmodel/iso42001/aims_user_information_channels> , <https://w3id.org/lmodel/iso42001/aims_user_information_contents> , <https://w3id.org/lmodel/iso42001/aims_user_information_criteria> , <https://w3id.org/lmodel/iso42001/aims_user_information_validated> ;
	linkml:class_uri "https://w3id.org/lmodel/iso42001/AimsUserInformation"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/iso42001/AimsUserInformation"^^xsd:anyURI ;
	linkml:description "What those who use a system are told: the contents, how it reaches them, what decided it, and the check that they got it." ;
	linkml:mixins <https://w3id.org/lmodel/iso42001/AimsDocumentControlMixin> , <https://w3id.org/lmodel/iso42001/AimsRecordMixin> ;
	linkml:slot_usage _:c14n129 ;
	linkml:slots <https://w3id.org/lmodel/iso42001/AimsRecordMixin_title> , <https://w3id.org/lmodel/iso42001/aimsDocumentControlMixin__aims_document_approval_date> , <https://w3id.org/lmodel/iso42001/aimsDocumentControlMixin__aims_document_approver> , <https://w3id.org/lmodel/iso42001/aimsDocumentControlMixin__aims_document_author> , <https://w3id.org/lmodel/iso42001/aimsDocumentControlMixin__aims_document_change_control> , <https://w3id.org/lmodel/iso42001/aimsDocumentControlMixin__aims_document_classification> , <https://w3id.org/lmodel/iso42001/aimsDocumentControlMixin__aims_document_disposition> , <https://w3id.org/lmodel/iso42001/aimsDocumentControlMixin__aims_document_distribution> , <https://w3id.org/lmodel/iso42001/aimsDocumentControlMixin__aims_document_effective_date> , <https://w3id.org/lmodel/iso42001/aimsDocumentControlMixin__aims_document_external_origin> , <https://w3id.org/lmodel/iso42001/aimsDocumentControlMixin__aims_document_external_source> , <https://w3id.org/lmodel/iso42001/aimsDocumentControlMixin__aims_document_format> , <https://w3id.org/lmodel/iso42001/aimsDocumentControlMixin__aims_document_last_review_date> , <https://w3id.org/lmodel/iso42001/aimsDocumentControlMixin__aims_document_medium> , <https://w3id.org/lmodel/iso42001/aimsDocumentControlMixin__aims_document_next_review_date> , <https://w3id.org/lmodel/iso42001/aimsDocumentControlMixin__aims_document_owner> , <https://w3id.org/lmodel/iso42001/aimsDocumentControlMixin__aims_document_reference> , <https://w3id.org/lmodel/iso42001/aimsDocumentControlMixin__aims_document_retention> , <https://w3id.org/lmodel/iso42001/aimsDocumentControlMixin__aims_document_status> , <https://w3id.org/lmodel/iso42001/aimsDocumentControlMixin__aims_document_storage> , <https://w3id.org/lmodel/iso42001/aimsDocumentControlMixin__aims_document_version> , <https://w3id.org/lmodel/iso42001/aimsUserInformation__aims_user_information_channels> , <https://w3id.org/lmodel/iso42001/aimsUserInformation__aims_user_information_contents> , <https://w3id.org/lmodel/iso42001/aimsUserInformation__aims_user_information_criteria> , <https://w3id.org/lmodel/iso42001/aimsUserInformation__aims_user_information_validated> , <https://w3id.org/lmodel/iso42001/aims_ai_systems> , <https://w3id.org/lmodel/iso42001/aims_id> , <https://w3id.org/lmodel/iso42001/description> .
<https://w3id.org/lmodel/iso42001/a_10_2> dcterms:title "A.10.2 Sharing out duties" ;
	linkml:annotations _:c14n318 ;
	linkml:description "Settle who carries which duty across a system's life, among the organization and those it deals with." .
<https://w3id.org/lmodel/iso42001/a_10_3> dcterms:title "A.10.3 What is bought in" ;
	linkml:annotations _:c14n330 ;
	linkml:description "Keep a process that holds what suppliers provide to how the organization means to treat AI." .
<https://w3id.org/lmodel/iso42001/a_10_4> dcterms:title "A.10.4 Buyers' needs" ;
	linkml:annotations _:c14n354 ;
	linkml:description "See that how the organization treats AI takes account of what its customers expect and want." .
<https://w3id.org/lmodel/iso42001/a_2_2> dcterms:title "A.2.2 Written direction on AI" ;
	linkml:annotations _:c14n130 ;
	linkml:description "Set down in writing how the organization means to treat AI systems." .
<https://w3id.org/lmodel/iso42001/a_2_3> dcterms:title "A.2.3 Fit with other policies" ;
	linkml:annotations _:c14n316 ;
	linkml:description "Find where the organization's other policies touch its aims for AI, in either direction." .
<https://w3id.org/lmodel/iso42001/a_2_4> dcterms:title "A.2.4 Regular policy check" ;
	linkml:annotations _:c14n658 ;
	linkml:description "Look at the AI policy again on a schedule and whenever the need arises, to see that it still serves." .
<https://w3id.org/lmodel/iso42001/a_3_2> dcterms:title "A.3.2 Who answers for what" ;
	linkml:annotations _:c14n507 ;
	linkml:description "Decide who carries which duty for AI, as the organization's needs dictate." .
<https://w3id.org/lmodel/iso42001/a_3_3> dcterms:title "A.3.3 A way to raise worries" ;
	linkml:annotations _:c14n182 ;
	linkml:description "Give people a way to raise worries about the organization's part in a system, at any point in that system's life." .
<https://w3id.org/lmodel/iso42001/a_4_2> dcterms:title "A.4.2 Inventory of what is needed" ;
	linkml:annotations _:c14n370 ;
	linkml:description "List what each stage of a system's life, and other AI work, draws on." .
<https://w3id.org/lmodel/iso42001/a_4_3> dcterms:title "A.4.3 Record of data used" ;
	linkml:annotations _:c14n204 ;
	linkml:description "Record facts about the data a system draws on." .
<https://w3id.org/lmodel/iso42001/a_4_4> dcterms:title "A.4.4 Record of tools used" ;
	linkml:annotations _:c14n406 ;
	linkml:description "Record facts about the tools a system draws on." .
<https://w3id.org/lmodel/iso42001/a_4_5> dcterms:title "A.4.5 Record of infrastructure used" ;
	linkml:annotations _:c14n478 ;
	linkml:description "Record facts about the hardware and computing a system draws on." .
<https://w3id.org/lmodel/iso42001/a_4_6> dcterms:title "A.4.6 Record of the people involved" ;
	linkml:annotations _:c14n448 ;
	linkml:description "Record who works on a system across its whole life, and what skills they bring." .
<https://w3id.org/lmodel/iso42001/a_5_2> dcterms:title "A.5.2 Method for weighing consequences" ;
	linkml:annotations _:c14n86 ;
	linkml:description "Set up a way to work out what a system could do to people and society over its life." .
<https://w3id.org/lmodel/iso42001/a_5_3> dcterms:title "A.5.3 Keeping assessment results" ;
	linkml:annotations _:c14n264 ;
	linkml:description "Write down what each impact assessment found, and hold on to it for a set time." .
<https://w3id.org/lmodel/iso42001/a_5_4> dcterms:title "A.5.4 Effects on people" ;
	linkml:annotations _:c14n475 ;
	linkml:description "Work out and record how a system could affect single persons or particular groups over its life." .
<https://w3id.org/lmodel/iso42001/a_5_5> dcterms:title "A.5.5 Effects on society" ;
	linkml:annotations _:c14n439 ;
	linkml:description "Work out and record how a system could affect society over its life." .
<https://w3id.org/lmodel/iso42001/a_6_1_2> dcterms:title "A.6.1.2 Goals for building" ;
	linkml:annotations _:c14n541 , _:c14n81 ;
	linkml:description "Set goals that steer responsible building, and work measures for them into the development cycle." .
<https://w3id.org/lmodel/iso42001/a_6_1_3> dcterms:title "A.6.1.3 Defined ways of building" ;
	linkml:annotations _:c14n17 , _:c14n84 ;
	linkml:description "Set down the particular processes for designing and building a system responsibly." .
<https://w3id.org/lmodel/iso42001/a_6_2_2> dcterms:title "A.6.2.2 What a system must do" ;
	linkml:annotations _:c14n476 , _:c14n78 ;
	linkml:description "Write down what a new system, or a large upgrade to one, must meet." .
<https://w3id.org/lmodel/iso42001/a_6_2_3> dcterms:title "A.6.2.3 Build records" ;
	linkml:annotations _:c14n420 , _:c14n67 ;
	linkml:description "Write down how a system was designed and built, against the goals and the requirements." .
<https://w3id.org/lmodel/iso42001/a_6_2_4> dcterms:title "A.6.2.4 Checks and their criteria" ;
	linkml:annotations _:c14n71 , _:c14n72 ;
	linkml:description "Set the checks that verify and validate a system, and say when each applies." .
<https://w3id.org/lmodel/iso42001/a_6_2_5> dcterms:title "A.6.2.5 Going live" ;
	linkml:annotations _:c14n299 , _:c14n472 ;
	linkml:description "Keep a plan for putting a system into service, and meet its conditions first." .
<https://w3id.org/lmodel/iso42001/a_6_2_6> dcterms:title "A.6.2.6 Running and watching" ;
	linkml:annotations _:c14n37 , _:c14n96 ;
	linkml:description "Set down what keeping a system in service takes: at least watching it, fixing it, updating it and supporting it." .
<https://w3id.org/lmodel/iso42001/a_6_2_7> dcterms:title "A.6.2.7 Documents per audience" ;
	linkml:annotations _:c14n297 , _:c14n608 ;
	linkml:description "Decide what technical documents each kind of reader needs, and give them those documents in a suitable form." .
<https://w3id.org/lmodel/iso42001/a_6_2_8> dcterms:title "A.6.2.8 Keeping logs" ;
	linkml:annotations _:c14n105 , _:c14n166 ;
	linkml:description "Decide at which points in a system's life it keeps event logs, and keep them at least while it is in service." .
<https://w3id.org/lmodel/iso42001/a_7_2> dcterms:title "A.7.2 Managing data for building" ;
	linkml:annotations _:c14n202 ;
	linkml:description "Set down and follow processes that manage the data used to build systems." .
<https://w3id.org/lmodel/iso42001/a_7_3> dcterms:title "A.7.3 Obtaining and choosing data" ;
	linkml:annotations _:c14n474 ;
	linkml:description "Record how the data a system uses was obtained and picked." .
<https://w3id.org/lmodel/iso42001/a_7_4> dcterms:title "A.7.4 Data fit for purpose" ;
	linkml:annotations _:c14n636 ;
	linkml:description "State what quality data must have, and see that the data used to build and run a system has it." .
<https://w3id.org/lmodel/iso42001/a_7_5> dcterms:title "A.7.5 Tracing where data came from" ;
	linkml:annotations _:c14n172 ;
	linkml:description "Keep a process that records where data came from and what happened to it, while it and the system last." .
<https://w3id.org/lmodel/iso42001/a_7_6> dcterms:title "A.7.6 Readying data" ;
	linkml:annotations _:c14n465 ;
	linkml:description "Set criteria for choosing how data is made ready, and name the methods to use." .
<https://w3id.org/lmodel/iso42001/a_8_2> dcterms:title "A.8.2 What users are told" ;
	linkml:annotations _:c14n157 ;
	linkml:description "Work out what those who use a system need to know, and tell them." .
<https://w3id.org/lmodel/iso42001/a_8_3> dcterms:title "A.8.3 Letting outsiders report harm" ;
	linkml:annotations _:c14n362 ;
	linkml:description "Give people outside the organization a way to report harm a system has done." .
<https://w3id.org/lmodel/iso42001/a_8_4> dcterms:title "A.8.4 Telling users about incidents" ;
	linkml:annotations _:c14n393 ;
	linkml:description "Keep a plan for telling those who use a system when something goes wrong." .
<https://w3id.org/lmodel/iso42001/a_8_5> dcterms:title "A.8.5 Duties to inform others" ;
	linkml:annotations _:c14n127 ;
	linkml:description "Work out what the organization owes others by way of reports about a system." .
<https://w3id.org/lmodel/iso42001/a_9_2> dcterms:title "A.9.2 Defined ways of using" ;
	linkml:annotations _:c14n307 ;
	linkml:description "Set down the processes for using AI systems responsibly." .
<https://w3id.org/lmodel/iso42001/a_9_3> dcterms:title "A.9.3 Goals for use" ;
	linkml:annotations _:c14n679 ;
	linkml:description "Set goals that steer how AI systems are used responsibly." .
<https://w3id.org/lmodel/iso42001/a_9_4> dcterms:title "A.9.4 Staying within documented use" ;
	linkml:annotations _:c14n192 ;
	linkml:description "See that a system is used only as intended and as its documents say." .
<https://w3id.org/lmodel/iso42001/accessibility> linkml:annotations _:c14n10 , _:c14n395 ;
	linkml:description "A system can be used by people with differing abilities." , "Whether people with differing abilities can use a system." .
<https://w3id.org/lmodel/iso42001/accountability> dcterms:title "A.3" ;
	linkml:annotations _:c14n11 , _:c14n209 , _:c14n332 , _:c14n38 ;
	linkml:description "Someone staying answerable for the outcome." , "Someone stays answerable for what a system helps to do." , "Who answers for AI within the organization's walls, and the way worries are raised." .
<https://w3id.org/lmodel/iso42001/ai_customer> linkml:description "Takes AI systems from a provider." .
<https://w3id.org/lmodel/iso42001/ai_deployer> linkml:annotations _:c14n190 ;
	linkml:description "Puts a system into service." .
<https://w3id.org/lmodel/iso42001/ai_designer> linkml:annotations _:c14n2 ;
	linkml:description "Decides how a system should work." .
<https://w3id.org/lmodel/iso42001/ai_developer> linkml:annotations _:c14n147 ;
	linkml:description "Writes and trains what goes into a system." .
<https://w3id.org/lmodel/iso42001/ai_expertise> linkml:annotations _:c14n36 ;
	linkml:description "The organization has people with the skills AI calls for." .
<https://w3id.org/lmodel/iso42001/ai_governance_professional> linkml:annotations _:c14n409 ;
	linkml:description "Oversees how AI is run and held to account." .
<https://w3id.org/lmodel/iso42001/ai_human_factor_professional> linkml:annotations _:c14n51 ;
	linkml:description "Looks after how people and a system work together." .
<https://w3id.org/lmodel/iso42001/ai_impact_assessor> linkml:annotations _:c14n272 ;
	linkml:description "Weighs what a system may do to people and society." .
<https://w3id.org/lmodel/iso42001/ai_operator> linkml:annotations _:c14n526 ;
	linkml:description "Keeps a system running." .
<https://w3id.org/lmodel/iso42001/ai_partner> linkml:description "Helps others make or run AI systems." .
<https://w3id.org/lmodel/iso42001/ai_platform_provider> linkml:annotations _:c14n175 ;
	linkml:description "Offers a platform that others build AI services on." .
<https://w3id.org/lmodel/iso42001/ai_producer> linkml:description "Makes AI systems." .
<https://w3id.org/lmodel/iso42001/ai_product_or_service_provider> linkml:annotations _:c14n49 ;
	linkml:description "Offers goods or services that hold an AI system." .
<https://w3id.org/lmodel/iso42001/ai_provider> linkml:description "Offers AI systems or platforms to others." .
<https://w3id.org/lmodel/iso42001/ai_subject> linkml:description "Is affected by what a system decides or does." .
<https://w3id.org/lmodel/iso42001/ai_system> linkml:description "The system itself misbehaved or failed." .
<https://w3id.org/lmodel/iso42001/ai_system_integrator> linkml:annotations _:c14n55 ;
	linkml:description "Joins a system to others." .
<https://w3id.org/lmodel/iso42001/ai_tester_or_evaluator> linkml:annotations _:c14n493 ;
	linkml:description "Checks how well a system does." .
<https://w3id.org/lmodel/iso42001/ai_user> linkml:annotations _:c14n675 ;
	linkml:description "Works with a system directly." .
