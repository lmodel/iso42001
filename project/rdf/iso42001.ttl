<https://w3id.org/lmodel/iso42001/operation_and_monitoring> linkml:description "The system runs and is watched." .
<https://w3id.org/lmodel/iso42001/organization> linkml:description "The organization itself." .
<https://w3id.org/lmodel/iso42001/organizational> linkml:annotations _:c14n664 ;
	linkml:description "An objective for the whole system." .
<https://w3id.org/lmodel/iso42001/other> linkml:description "A kind of objective the organization sets for itself." , "A method the organization names for itself." , "A source the organization names for itself." , "A threat the organization names for itself." , "An area the organization names for itself." , "Another management system standard, generic or for one sector." , "Something the organization names for itself." .
<https://w3id.org/lmodel/iso42001/other_subject> linkml:annotations _:c14n73 ;
	linkml:description "Is affected in some other way." .
<https://w3id.org/lmodel/iso42001/pii_controller> skos:closeMatch "iso29100:PfPiiController"^^xsd:anyURI ;
	linkml:description "Decides why and how personal data is processed." .
<https://w3id.org/lmodel/iso42001/pii_processor> skos:closeMatch "iso29100:PfPiiProcessor"^^xsd:anyURI ;
	linkml:description "Processes personal data on a controller's behalf." .
<https://w3id.org/lmodel/iso42001/plan> linkml:description "How the organization means to reach an objective." .
<https://w3id.org/lmodel/iso42001/planned> linkml:description "The work is planned, with a timeline." .
<https://w3id.org/lmodel/iso42001/policy_direction> dcterms:title "A.2" ;
	linkml:annotations _:c14n399 , _:c14n671 ;
	linkml:description "Written direction from management on AI, and how it fits with other policies." .
<https://w3id.org/lmodel/iso42001/policy_maker> linkml:annotations _:c14n345 ;
	linkml:description "Sets the rules." .
<https://w3id.org/lmodel/iso42001/positive> linkml:description "It helps." .
<https://w3id.org/lmodel/iso42001/positive_finding> linkml:description "Evidence of practice that works well." .
<https://w3id.org/lmodel/iso42001/possible> linkml:annotations _:c14n539 ;
	linkml:description "Might happen at some point." .
<https://w3id.org/lmodel/iso42001/privacy> linkml:annotations _:c14n303 ;
	linkml:description "Data about people, sensitive data above all, is neither misused nor exposed." , "Personal data was exposed or misused." .
<https://w3id.org/lmodel/iso42001/procedure> linkml:description "The steps for carrying out an activity the same way each time." .
<https://w3id.org/lmodel/iso42001/procurer> linkml:annotations _:c14n339 ;
	linkml:description "Buys systems or their parts." .
<https://w3id.org/lmodel/iso42001/production> linkml:description "Data a system meets in service." .
<https://w3id.org/lmodel/iso42001/rare> linkml:annotations _:c14n578 ;
	linkml:description "Not expected to happen." .
<https://w3id.org/lmodel/iso42001/re_evaluation> linkml:description "The system's results are weighed against its goals afresh." .
<https://w3id.org/lmodel/iso42001/record> linkml:description "Evidence of what was done or achieved." .
<https://w3id.org/lmodel/iso42001/regulator> linkml:annotations _:c14n449 ;
	linkml:description "Enforces the rules." .
<https://w3id.org/lmodel/iso42001/relevant_authority> linkml:description "Sets or enforces rules for AI." .
<https://w3id.org/lmodel/iso42001/reliability> linkml:annotations _:c14n554 ;
	linkml:description "A system keeps doing what it is meant to." .
<https://w3id.org/lmodel/iso42001/report> linkml:description "The formal output of an assessment, audit or review." .
<https://w3id.org/lmodel/iso42001/responsible_development> linkml:annotations _:c14n431 ;
	linkml:description "A goal that steers how systems are built." .
<https://w3id.org/lmodel/iso42001/responsible_use> dcterms:title "A.9" ;
	linkml:annotations _:c14n595 , _:c14n601 , _:c14n645 ;
	linkml:description "A goal that steers how systems are used." , "How AI systems are put to use, against the organization's goals and the systems' documents." .
<https://w3id.org/lmodel/iso42001/retain> skos:altLabel "accept" ;
	linkml:description "Keep the risk as it is, with management's approval." .
<https://w3id.org/lmodel/iso42001/retirement> linkml:description "The system is taken out of service." .
<https://w3id.org/lmodel/iso42001/robustness> linkml:annotations _:c14n424 ;
	linkml:description "A system does as well on unseen data as on what it was trained on." .
<https://w3id.org/lmodel/iso42001/safety> linkml:annotations _:c14n53 ;
	linkml:description "Nobody's life or health, and no property or part of nature, comes to harm." , "Someone or something was put in danger." .
<https://w3id.org/lmodel/iso42001/safety_and_health> linkml:annotations _:c14n162 ;
	linkml:description "Physical and mental harm and wellbeing." .
<https://w3id.org/lmodel/iso42001/scaling> linkml:description "Bringing values to comparable sizes." .
<https://w3id.org/lmodel/iso42001/second_party> linkml:description "A party with an interest in the organization audits it, such as a customer." .
<https://w3id.org/lmodel/iso42001/security> linkml:annotations _:c14n638 ;
	linkml:description "Threats peculiar to AI are met, beyond the usual ones." .
<https://w3id.org/lmodel/iso42001/security_and_privacy> linkml:annotations _:c14n386 ;
	linkml:description "Keeping people's information safe and private." .
<https://w3id.org/lmodel/iso42001/severe> linkml:annotations _:c14n441 ;
	linkml:description "An effect that threatens lives or the organization's survival." .
<https://w3id.org/lmodel/iso42001/share> skos:altLabel "transfer" ;
	linkml:description "Share the risk with another party, such as an insurer or a supplier." .
<https://w3id.org/lmodel/iso42001/societies> linkml:description "Society at large." .
<https://w3id.org/lmodel/iso42001/sparqlpath> dcterms:conformsTo "https://www.w3.org/TR/sparql11-query/#propertypaths" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"sparqlpath\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/Sparqlpath"^^xsd:anyURI ;
	linkml:description "A string encoding a SPARQL Property Path. The value of the string MUST conform to SPARQL syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded as RDF." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/iso42001/stakeholder_information> dcterms:title "A.8" ;
	linkml:annotations _:c14n249 , _:c14n467 ;
	linkml:description "What users and others are told about a system, and their way to report harm." .
<https://w3id.org/lmodel/iso42001/standard> linkml:description "Mandatory requirements for a technology or a process." .
<https://w3id.org/lmodel/iso42001/statistical_exploration> linkml:description "Looking at how the values are spread, and describing them." .
<https://w3id.org/lmodel/iso42001/string> a linkml:TypeDefinition ;
	skos:editorialNote "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"." ;
	skos:exactMatch "schema:Text"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/String"^^xsd:anyURI ;
	linkml:description "A character string" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/iso42001/system_life_cycle> dcterms:title "A.6" ;
	linkml:annotations _:c14n124 , _:c14n505 ;
	linkml:description "Building and running AI systems, from the goals set for them to their logs." .
<https://w3id.org/lmodel/iso42001/system_resources> dcterms:title "A.4" ;
	linkml:annotations _:c14n47 , _:c14n591 ;
	linkml:description "What each AI system draws on: components, data, tools, computing and people." .
<https://w3id.org/lmodel/iso42001/technology_readiness> linkml:annotations _:c14n100 ;
	linkml:description "A technology is too new to know well, or so old it breeds complacency." .
<https://w3id.org/lmodel/iso42001/test> linkml:description "Data held back to see how a finished model does." .
<https://w3id.org/lmodel/iso42001/third_party> linkml:description "An independent body audits it, such as a certification body or a regulator." , "Someone else." .
<https://w3id.org/lmodel/iso42001/time> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"time\"." , "URI is dateTime because OWL reasoners do not work with straight date or time" ;
	skos:exactMatch "schema:Time"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDTime" ;
	linkml:definition_uri "https://w3id.org/linkml/Time"^^xsd:anyURI ;
	linkml:description "A time object represents a (local) time of day, independent of any particular day" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#time"^^xsd:anyURI .
<https://w3id.org/lmodel/iso42001/title> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/iso42001"^^xsd:anyURI ;
	skos:mappingRelation "http://schema.org/name"^^xsd:anyURI ;
	skos:note "It means what LOKF's title means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key." ;
	linkml:definition_uri "https://w3id.org/lmodel/iso42001/title"^^xsd:anyURI ;
	linkml:description "The name the organization gives the record." ;
	linkml:domain_of <https://w3id.org/lmodel/iso42001/AimsRecordMixin> ;
	linkml:owner <https://w3id.org/lmodel/iso42001/AimsRecordMixin> ;
	linkml:range <https://w3id.org/lmodel/iso42001/string> ;
	linkml:slot_uri "http://schema.org/name"^^xsd:anyURI .
<https://w3id.org/lmodel/iso42001/training> linkml:description "Data a model learns from." .
<https://w3id.org/lmodel/iso42001/training_and_test_data> linkml:annotations _:c14n210 ;
	linkml:description "Good data to train and check a system is to hand." .
<https://w3id.org/lmodel/iso42001/transparency_and_explainability> linkml:annotations _:c14n203 , _:c14n64 ;
	linkml:description "Being able to see how a system works and why it gave a result." , "Those concerned can see how a system works and why it gave a result." .
<https://w3id.org/lmodel/iso42001/unlikely> linkml:annotations _:c14n678 ;
	linkml:description "Could happen, but is not expected to." .
<https://w3id.org/lmodel/iso42001/uri> dcterms:conformsTo "https://www.ietf.org/rfc/rfc3987.txt" ;
	a linkml:TypeDefinition ;
	skos:closeMatch "schema:URL"^^xsd:anyURI ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uri\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "in RDF serializations a slot with range of uri is treated as a literal or type xsd:anyURI unless it is an identifier or a reference to an identifier, in which case it is translated directly to a node" ;
	linkml:base "URI" ;
	linkml:definition_uri "https://w3id.org/linkml/Uri"^^xsd:anyURI ;
	linkml:description "a complete URI" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/iso42001/uriorcurie> a linkml:TypeDefinition ;
