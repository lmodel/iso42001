            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path iso42001:description ],
        [ sh:datatype xsd:string ;
            sh:description "Person who created the document." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path iso42001:author ],
        [ sh:datatype xsd:string ;
            sh:description "Specific technical context in which the AI system is deployed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso42001:technical_context ],
        [ sh:datatype xsd:string ;
            sh:description "Person or team who conducted the assessment." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso42001:assessor ],
        [ sh:datatype xsd:string ;
            sh:description "Mitigations to address identified consequences." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path iso42001:mitigations ],
