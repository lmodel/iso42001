            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path iso42001:id ] ;
    sh:targetClass iso42001:NamedEntity .

iso42001:AIObjective a sh:NodeShape ;
    rdfs:comment "A measurable AI objective per Clause 6.2, established at relevant functions and levels and aligned with the AI policy." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:date ;
            sh:description "Target date for achieving the objective." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path iso42001:target_date ],
        [ sh:datatype xsd:string ;
            sh:description "Current status of objective achievement." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path iso42001:achievement_status ],
        [ sh:datatype xsd:string ;
            sh:description "Current measured value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso42001:current_value ],
        [ sh:description "Category of AI objective (e.g., fairness, transparency, robustness)." ;
            sh:in ( "accountability" "ai_expertise" "data_quality" "environmental_impact" "fairness" "maintainability" "privacy" "robustness" "safety" "security" "transparency" "explainability" "reliability" "accessibility" "availability_of_training_data" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path iso42001:objective_category ],
        [ sh:datatype xsd:string ;
            sh:description "Resources required for implementation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iso42001:resources_required ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path iso42001:description ],
        [ sh:class iso42001:Role ;
            sh:description "Role responsible for the objective or control." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path iso42001:responsible_role ],
        [ sh:datatype xsd:string ;
            sh:description "Target value for the objective metric." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso42001:target_value ],
        [ sh:datatype xsd:string ;
            sh:description "Definition of how the objective is measured." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso42001:metric_definition ],
        [ sh:class iso42001:AIRisk ;
            sh:description "Associated AI risks." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path iso42001:related_risks ],
        [ sh:class iso42001:AIReferenceControl ;
            sh:description "Other reference controls related to this one." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path iso42001:related_controls ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path iso42001:name ],
        [ sh:datatype xsd:string ;
            sh:description "Clear statement of the objective." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iso42001:objective_statement ],
        [ sh:description "Unique identifier for this entity instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path iso42001:id ],
        [ sh:datatype xsd:string ;
            sh:description "Method used to measure the metric." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso42001:measurement_method ],
        [ sh:datatype xsd:string ;
            sh:description "Plan for achieving the objective." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path iso42001:action_plan ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path iso42001:created_date ],
        [ sh:datatype xsd:string ;
            sh:description "How often measurement is performed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path iso42001:measurement_frequency ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path iso42001:version ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was last modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path iso42001:modified_date ] ;
    sh:targetClass iso42001:AIObjective .

iso42001:AIRiskAssessment a sh:NodeShape ;
    rdfs:comment "An instance of AI risk assessment performed per Clause 8.2, identifying and evaluating AI risks at planned intervals or following significant change." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Recommendations from the assessment." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iso42001:recommendations ],
        [ sh:class iso42001:AISystem ;
            sh:description "AI systems covered by this assessment." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path iso42001:ai_systems_assessed ],
        [ sh:datatype xsd:date ;
            sh:description "Date the assessment was conducted." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso42001:assessment_date ],
        [ sh:description "Classification of the documented information." ;
            sh:in ( "policy" "procedure" "standard" "guideline" "record" "plan" "report" "technical_documentation" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path iso42001:document_type ],
        [ sh:class iso42001:AIRisk ;
            sh:description "Risks identified in this assessment." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path iso42001:risks_identified ],
        [ sh:class iso42001:AISystemImpactAssessment ;
            sh:description "AI system impact assessment linked to this risk assessment." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path iso42001:linked_impact_assessment ],
        [ sh:datatype xsd:string ;
            sh:description "Current status of the document or entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path iso42001:status ],
        [ sh:datatype xsd:string ;
            sh:description "Specific methodology applied in this assessment." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso42001:methodology_used ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path iso42001:name ],
        [ sh:datatype xsd:string ;
            sh:description "Summary of assessment findings." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso42001:summary_findings ],
        [ sh:datatype xsd:string ;
            sh:description "Person accountable for the document content and maintenance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path iso42001:owner ],
        [ sh:datatype xsd:string ;
            sh:description "Scope of the assessment." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iso42001:assessment_scope ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the document is due for review." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path iso42001:review_date ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was last modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path iso42001:modified_date ],
        [ sh:datatype xsd:string ;
            sh:description "Person or team who conducted the assessment." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso42001:assessor ],
        [ sh:datatype xsd:string ;
            sh:description "Person who created the document." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path iso42001:author ],
        [ sh:datatype xsd:string ;
            sh:description "Unique reference number for document control." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path iso42001:document_reference ],
        [ sh:datatype xsd:duration ;
            sh:description "Duration for which the document is retained." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path iso42001:retention_period ],
        [ sh:datatype xsd:string ;
            sh:description "Information classification level." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path iso42001:classification ],
        [ sh:datatype xsd:string ;
            sh:description "Person who approved the document." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path iso42001:approved_by ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path iso42001:description ],
        [ sh:description "Unique identifier for this entity instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path iso42001:id ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path iso42001:version ],
        [ sh:datatype xsd:date ;
            sh:description "Planned date for next assessment." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path iso42001:next_assessment_date ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path iso42001:created_date ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the document was approved." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path iso42001:approved_date ],
        [ sh:datatype xsd:date ;
