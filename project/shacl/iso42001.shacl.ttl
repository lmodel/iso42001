iso42001:SoAEntry a sh:NodeShape ;
    rdfs:comment "A single entry in the AIMS Statement of Applicability documenting the applicability and implementation status of one reference control." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Evidence of control implementation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso42001:implementation_evidence ],
        [ sh:datatype xsd:date ;
            sh:description "Target date for implementing the control." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso42001:target_implementation_date ],
        [ sh:class iso42001:Role ;
            sh:description "Role responsible for the objective or control." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path iso42001:responsible_role ],
        [ sh:datatype xsd:string ;
            sh:description "Justification for including the control." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso42001:inclusion_justification ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the control is applicable." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso42001:is_applicable ],
        [ sh:datatype xsd:string ;
            sh:description "Justification for excluding the control." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso42001:exclusion_justification ],
        [ sh:class iso42001:AIReferenceControl ;
            sh:description "Reference to an Annex A control (e.g., A.6.2.4)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path iso42001:control_reference ],
        [ sh:description "Current implementation status." ;
            sh:in ( "not_started" "planned" "in_progress" "implemented" "not_applicable" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path iso42001:implementation_status ] ;
    sh:targetClass iso42001:SoAEntry .

iso42001:StatementOfApplicability a sh:NodeShape ;
