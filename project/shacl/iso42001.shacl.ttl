iso42001:SupplierRelationship a sh:NodeShape ;
    rdfs:comment "A supplier relationship covering services, products, or materials (e.g., datasets, models, libraries, full AI systems) provided to the organization per A.10.3." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path iso42001:description ],
        [ sh:datatype xsd:string ;
            sh:description "Contractual basis of the relationship." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso42001:contractual_basis ],
        [ sh:datatype xsd:string ;
            sh:description "Category of party." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso42001:party_type ],
        [ sh:datatype xsd:string ;
            sh:description "Responsibilities allocated to the third party." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path iso42001:allocated_responsibilities ],
        [ sh:datatype xsd:string ;
            sh:description "Role of the third party in data processing (e.g., PII controller, PII processor)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso42001:data_processing_role ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path iso42001:version ],
        [ sh:datatype xsd:string ;
            sh:description "Evidence of assurance over the third party's conformance with the organization's responsible AI approach." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path iso42001:assurance_evidence ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path iso42001:name ],
        [ sh:description "Unique identifier for this entity instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path iso42001:id ],
        [ sh:description "AI life cycle stages where the third party is involved." ;
            sh:in ( "inception" "design" "data_collection_and_preparation" "development" "verification_and_validation" "deployment" "operation_and_monitoring" "continuous_validation" "re_evaluation" "decommissioning" ) ;
            sh:order 9 ;
            sh:path iso42001:lifecycle_stages_involved ],
        [ sh:datatype xsd:string ;
            sh:description "Criteria for assessing the supplier." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iso42001:supplier_assessment_criteria ],
        [ sh:datatype xsd:string ;
            sh:description "Frequency at which the relationship is reviewed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path iso42001:review_frequency ],
        [ sh:datatype xsd:string ;
            sh:description "Corrective actions required of the supplier." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso42001:corrective_actions_required ],
        [ sh:class iso42001:AISystem ;
            sh:description "AI systems involved in the third-party relationship." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path iso42001:ai_systems_involved ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the third party." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso42001:party_name ],
        [ sh:datatype xsd:string ;
            sh:description "How the supplier or customer relationship is monitored." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso42001:monitoring_method ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path iso42001:created_date ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was last modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path iso42001:modified_date ] ;
    sh:targetClass iso42001:SupplierRelationship .

iso42001:ThirdPartyRelationship a sh:NodeShape ;
    rdfs:comment "A documented relationship with a third party (supplier, partner, or customer) involved in the AI system life cycle per A.10." ;
    sh:closed true ;
    sh:ignoredProperties ( iso42001:supplier_assessment_criteria iso42001:customer_expectations rdf:type iso42001:corrective_actions_required iso42001:monitoring_method iso42001:usage_agreement_reference iso42001:communicated_limitations ) ;
