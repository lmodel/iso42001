            sh:order 3 ;
            sh:path iso42001:improvement_description ],
        [ sh:datatype xsd:string ;
            sh:description "Party responsible for the activity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso42001:responsible_party ],
        [ sh:datatype xsd:string ;
