            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path iso42001:implementation_plan ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path iso42001:created_date ],
        [ sh:datatype xsd:string ;
            sh:description "Expected benefit of the improvement." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso42001:expected_benefit ],
        [ sh:datatype xsd:date ;
            sh:description "Actual completion date." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path iso42001:actual_completion_date ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path iso42001:name ],
        [ sh:datatype xsd:date ;
            sh:description "Target date for achieving the objective." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iso42001:target_date ],
        [ sh:datatype xsd:string ;
            sh:description "Person who identified the improvement opportunity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso42001:identified_by ],
        [ sh:datatype xsd:string ;
            sh:description "Current status of the document or entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path iso42001:status ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path iso42001:description ],
        [ sh:datatype xsd:string ;
            sh:description "Source of the improvement opportunity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iso42001:improvement_source ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path iso42001:version ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was last modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path iso42001:modified_date ],
        [ sh:description "Priority assigned (qualitative level)." ;
            sh:in ( "very_low" "low" "medium" "high" "critical" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path iso42001:priority ] ;
    sh:targetClass iso42001:ImprovementOpportunity .

iso42001:InternalAudit a sh:NodeShape ;
    rdfs:comment "An internal audit instance per Clause 9.2 assessing AIMS conformance and effectiveness." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:duration ;
            sh:description "Duration for which the document is retained." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path iso42001:retention_period ],
        [ sh:datatype xsd:string ;
            sh:description "Scope of the audit." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso42001:audit_scope ],
        [ sh:datatype xsd:string ;
            sh:description "Person who approved the document." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path iso42001:approved_by ],
        [ sh:datatype xsd:string ;
            sh:description "Criteria used for the audit." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso42001:audit_criteria ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the document becomes effective." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path iso42001:effective_date ],
        [ sh:datatype xsd:string ;
            sh:description "Unique reference identifier for the audit." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iso42001:audit_reference ],
        [ sh:datatype xsd:string ;
            sh:description "Unique reference number for document control." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path iso42001:document_reference ],
        [ sh:datatype xsd:string ;
            sh:description "Overall conclusion of the audit." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path iso42001:audit_conclusion ],
        [ sh:datatype xsd:string ;
            sh:description "Objectives of the audit." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso42001:audit_objectives ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path iso42001:created_date ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path iso42001:description ],
        [ sh:datatype xsd:string ;
            sh:description "Lead auditor for the audit." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso42001:lead_auditor ],
        [ sh:description "Classification of the documented information." ;
            sh:in ( "policy" "procedure" "standard" "guideline" "record" "plan" "report" "technical_documentation" ) ;
            sh:maxCount 1 ;
            sh:order 16 ;
            sh:path iso42001:document_type ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path iso42001:version ],
        [ sh:datatype xsd:date ;
            sh:description "End date of the audit period." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path iso42001:audit_period_end ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the document is due for review." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path iso42001:review_date ],
        [ sh:datatype xsd:string ;
            sh:description "Reference to the audit plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path iso42001:audit_plan ],
        [ sh:datatype xsd:date ;
            sh:description "Start date of the audit period." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso42001:audit_period_start ],
        [ sh:datatype xsd:string ;
            sh:description "Person accountable for the document content and maintenance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path iso42001:owner ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path iso42001:name ],
        [ sh:datatype xsd:date ;
            sh:description "Date the audit report was issued." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path iso42001:report_date ],
        [ sh:datatype xsd:string ;
            sh:description "Representatives of the auditee." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path iso42001:auditee_representatives ],
        [ sh:class iso42001:AuditFinding ;
            sh:description "Findings from the audit." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path iso42001:findings ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the document was approved." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path iso42001:approved_date ],
        [ sh:datatype xsd:string ;
            sh:description "Distribution list for the audit report." ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path iso42001:report_distribution ],
        [ sh:description "Unique identifier for this entity instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path iso42001:id ],
        [ sh:datatype xsd:string ;
            sh:description "Information classification level." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path iso42001:classification ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was last modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path iso42001:modified_date ],
        [ sh:datatype xsd:string ;
            sh:description "Members of the audit team." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iso42001:audit_team ],
        [ sh:description "Type of audit (internal, external second-party, external third-party, surveillance, recertification, combined)." ;
            sh:in ( "internal" "external_second_party" "external_third_party" "surveillance" "recertification" "combined" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path iso42001:audit_type ],
        [ sh:datatype xsd:string ;
            sh:description "Positive observations from the audit." ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path iso42001:positive_observations ],
        [ sh:datatype xsd:string ;
            sh:description "Person who created the document." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path iso42001:author ],
        [ sh:datatype xsd:string ;
            sh:description "Current status of the document or entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path iso42001:status ] ;
    sh:targetClass iso42001:InternalAudit .

iso42001:AIIncident a sh:NodeShape ;
    rdfs:comment "An AI incident, i.e., an AI system event determined to require response, escalation, or external communication. Captures triage, response lifecycle, and communications to users and other interested parties per A.8.4 and A.8.3." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Containment actions taken to limit incident impact." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iso42001:containment_actions ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was last modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path iso42001:modified_date ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Date and time the incident was closed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path iso42001:closure_datetime ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path iso42001:name ],
        [ sh:description "Unique identifier for this entity instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path iso42001:id ],
        [ sh:class iso42001:AISystem ;
            sh:description "AI systems affected by this risk." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path iso42001:affected_ai_systems ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path iso42001:created_date ],
        [ sh:class iso42001:CorrectiveAction ;
            sh:description "Linked corrective actions." ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path iso42001:linked_corrective_actions ],
        [ sh:datatype xsd:string ;
            sh:description "References to evidence collected during incident response." ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path iso42001:evidence_collected ],
        [ sh:datatype xsd:string ;
            sh:description "Reference to the post-incident review record." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path iso42001:post_incident_review ],
        [ sh:datatype xsd:string ;
            sh:description "Notifications actually made (user communications, regulator filings)." ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path iso42001:notifications_made ],
        [ sh:datatype xsd:string ;
            sh:description "Recovery actions taken to restore normal AI system operation." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path iso42001:recovery_actions ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path iso42001:description ],
        [ sh:datatype xsd:string ;
            sh:description "Response actions taken for the incident." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso42001:response_actions ],
        [ sh:class iso42001:CommunicationPlan ;
            sh:description "Reference to the communication plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path iso42001:communication_plan ],
        [ sh:datatype xsd:string ;
            sh:description "Lessons learned recorded after incident closure." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path iso42001:lessons_learned ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether notification to interested parties or authorities is required." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path iso42001:notification_required ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text description of the incident." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso42001:incident_description ],
        [ sh:datatype xsd:string ;
            sh:description "How the incident was detected (monitoring alert, user report, external report)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path iso42001:detection_method ],
        [ sh:description "Severity rating of the incident." ;
            sh:in ( "very_low" "low" "medium" "high" "critical" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path iso42001:severity ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Date and time the incident was declared or detected." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iso42001:incident_datetime ],
        [ sh:datatype xsd:string ;
            sh:description "Identified root cause." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path iso42001:root_cause ],
        [ sh:datatype xsd:string ;
            sh:description "External reports received or filed regarding the incident." ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path iso42001:external_reports ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path iso42001:version ],
        [ sh:description "Dimensions of impact affected by the risk (individual, group, societal, safety, privacy, security, environmental)." ;
            sh:in ( "individual" "group" "societal" "fairness" "transparency" "explainability" "accountability" "accessibility" "human_rights" "financial" "health" "environmental" "economic" "government" "cultural_norms" "safety" "privacy" "security" ) ;
            sh:order 4 ;
            sh:path iso42001:affected_dimensions ],
        [ sh:description "AI-specific category of the incident." ;
            sh:in ( "data_poisoning" "model_stealing" "model_inversion" "membership_inference" "prompt_injection" "hallucination" "model_drift" "bias_incident" "safety_incident" "privacy_breach" "security_breach" "misuse" "adverse_societal_impact" "other" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path iso42001:incident_category ] ;
    sh:targetClass iso42001:AIIncident .

iso42001:AIRisk a sh:NodeShape ;
    rdfs:comment "An identified AI risk that may affect achievement of AI objectives, individuals, groups, or societies within the AIMS scope." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Risk level after controls are applied." ;
            sh:in ( "very_low" "low" "medium" "high" "critical" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path iso42001:residual_risk_level ],
        [ sh:description "Unique identifier for this entity instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path iso42001:id ],
        [ sh:class iso42001:AISystemImpactAssessment ;
            sh:description "AI system impact assessment associated with this risk." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path iso42001:related_impact_assessment ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the specific source of risk." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso42001:risk_source_description ],
        [ sh:class iso42001:AIRiskTreatmentPlan ;
            sh:description "Risk treatment plan addressing this risk." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path iso42001:related_treatment_plan ],
        [ sh:class iso42001:AIReferenceControl ;
            sh:description "Controls currently in place affecting this risk." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path iso42001:existing_controls ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path iso42001:version ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was last modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path iso42001:modified_date ],
        [ sh:class iso42001:AISystem ;
            sh:description "AI systems affected by this risk." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path iso42001:affected_ai_systems ],
        [ sh:datatype xsd:string ;
            sh:description "Priority for treating this risk." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path iso42001:treatment_priority ],
        [ sh:description "Selected treatment option for the AI risk." ;
            sh:in ( "modify" "accept" "avoid" "share" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path iso42001:risk_treatment_option ],
        [ sh:description "Dimensions of impact affected by the risk (individual, group, societal, safety, privacy, security, environmental)." ;
            sh:in ( "individual" "group" "societal" "fairness" "transparency" "explainability" "accountability" "accessibility" "human_rights" "financial" "health" "environmental" "economic" "government" "cultural_norms" "safety" "privacy" "security" ) ;
            sh:order 3 ;
            sh:path iso42001:affected_dimensions ],
        [ sh:description "Risk level before controls are applied." ;
            sh:in ( "very_low" "low" "medium" "high" "critical" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path iso42001:inherent_risk_level ],
        [ sh:datatype xsd:string ;
            sh:description "Person accountable for managing the AI risk." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso42001:risk_owner ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path iso42001:created_date ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path iso42001:description ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path iso42001:name ],
        [ sh:description "Assessed likelihood of risk occurrence." ;
            sh:in ( "rare" "unlikely" "possible" "likely" "almost_certain" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path iso42001:likelihood ],
        [ sh:description "Category of AI risk source per Annex C." ;
            sh:in ( "complexity_of_environment" "lack_of_transparency_or_explainability" "level_of_automation" "machine_learning_specific" "hardware" "lifecycle" "technology_readiness" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path iso42001:risk_source_category ],
        [ sh:description "Assessed consequence if the risk materializes." ;
            sh:in ( "negligible" "minor" "moderate" "major" "severe" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path iso42001:impact ] ;
    sh:targetClass iso42001:AIRisk .

iso42001:Nonconformity a sh:NodeShape ;
    rdfs:comment "A nonconformity identified per Clause 10.2 representing failure to fulfill an AIMS requirement." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Current status of the document or entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path iso42001:status ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the nonconformity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso42001:nonconformity_description ],
        [ sh:datatype xsd:string ;
            sh:description "Evidence of closure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path iso42001:closure_evidence ],
        [ sh:datatype xsd:string ;
            sh:description "Immediate actions taken." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso42001:immediate_actions ],
        [ sh:datatype xsd:string ;
