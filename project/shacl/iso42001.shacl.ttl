            sh:description "Target audience." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso42001:audience ],
        [ sh:datatype xsd:string ;
            sh:description "Records required to evidence the activity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path iso42001:records_required ],
        [ sh:datatype xsd:string ;
            sh:description "Frequency of the activity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso42001:frequency ],
        [ sh:datatype xsd:string ;
            sh:description "Party responsible for the activity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso42001:responsible_party ] ;
    sh:targetClass iso42001:CommunicationItem .

iso42001:CompetenceRecord a sh:NodeShape ;
    rdfs:comment "Evidence of competence for personnel affecting AIMS performance per Clause 7.2." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path iso42001:name ],
        [ sh:datatype xsd:string ;
            sh:description "Training completed." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso42001:training_records ],
        [ sh:datatype xsd:string ;
            sh:description "Current status of the document or entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path iso42001:status ],
        [ sh:datatype xsd:string ;
            sh:description "Unique reference number for document control." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path iso42001:document_reference ],
        [ sh:datatype xsd:string ;
            sh:description "Person accountable for the document content and maintenance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path iso42001:owner ],
        [ sh:datatype xsd:string ;
            sh:description "Education qualifications." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso42001:education_records ],
        [ sh:description "Classification of the documented information." ;
            sh:in ( "policy" "procedure" "standard" "guideline" "record" "plan" "report" "technical_documentation" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path iso42001:document_type ],
        [ sh:datatype xsd:string ;
            sh:description "Competencies required for the role." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso42001:required_competencies ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path iso42001:description ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path iso42001:version ],
        [ sh:datatype xsd:date ;
            sh:description "Date of last competency assessment." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path iso42001:competency_assessment_date ],
        [ sh:datatype xsd:string ;
            sh:description "Role of the person." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso42001:person_role ],
        [ sh:datatype xsd:duration ;
            sh:description "Duration for which the document is retained." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path iso42001:retention_period ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the document was approved." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path iso42001:approved_date ],
        [ sh:datatype xsd:string ;
            sh:description "Information classification level." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path iso42001:classification ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the document becomes effective." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path iso42001:effective_date ],
        [ sh:description "Unique identifier for this entity instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path iso42001:id ],
        [ sh:datatype xsd:string ;
            sh:description "Person who approved the document." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path iso42001:approved_by ],
        [ sh:datatype xsd:string ;
            sh:description "Person who created the document." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path iso42001:author ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the document is due for review." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path iso42001:review_date ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was last modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path iso42001:modified_date ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path iso42001:created_date ],
        [ sh:datatype xsd:string ;
            sh:description "Identified competency gaps." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso42001:competency_gaps ],
        [ sh:datatype xsd:string ;
            sh:description "Relevant experience." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso42001:experience_records ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the person." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iso42001:person_name ],
        [ sh:datatype xsd:string ;
            sh:description "Actions to address competency gaps." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iso42001:development_actions ] ;
    sh:targetClass iso42001:CompetenceRecord .

iso42001:ComputingResource a sh:NodeShape ;
    rdfs:comment "A system or computing resource used in the development or operation of an AI system per A.4.5." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Class of computing resource (e.g., GPU cluster, edge device)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iso42001:resource_class ],
        [ sh:description "Unique identifier for this entity instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path iso42001:id ],
        [ sh:datatype xsd:string ;
            sh:description "Type of environment (development, staging, production)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso42001:environment_type ],
        [ sh:datatype xsd:string ;
            sh:description "Quantity of the resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso42001:quantity ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was last modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path iso42001:modified_date ],
        [ sh:datatype xsd:string ;
            sh:description "Physical or logical location of the resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso42001:location ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path iso42001:name ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso42001:description ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path iso42001:version ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iso42001:created_date ],
        [ sh:datatype xsd:string ;
            sh:description "Cost of the resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso42001:cost ] ;
    sh:targetClass iso42001:ComputingResource .

iso42001:ConcernReport a sh:NodeShape ;
    rdfs:comment "A concern raised by employees, contractors, users, or other interested parties about the organization's role with respect to an AI system. Operationalises Annex A.3.3 (Reporting of concerns). Confidentiality, anonymity, anti-reprisal protection, escalation, and timely response are core attributes; informed by ISO 37002." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:date ;
            sh:description "Target date by which a response is owed to the reporter." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path iso42001:response_due_date ],
        [ sh:datatype xsd:string ;
            sh:description "Status of the investigation (e.g., opened, in_progress, closed, escalated, referred_external)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path iso42001:investigation_status ],
        [ sh:datatype xsd:string ;
            sh:description "Channel through which the concern was reported (e.g., hotline, web form, manager, ombudsperson, external auditor)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso42001:reporting_channel ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path iso42001:description ],
        [ sh:class iso42001:AIIncident ;
            sh:description "AI incidents linked to this concern report." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path iso42001:related_incidents ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was last modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path iso42001:modified_date ],
        [ sh:class iso42001:AISystem ;
            sh:description "AI systems referenced in the concern report." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path iso42001:concern_ai_systems ],
        [ sh:datatype xsd:string ;
            sh:description "Whether and how the concern was escalated (internal management, governing body, external authority)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path iso42001:escalation_status ],
        [ sh:datatype xsd:string ;
            sh:description "Actions taken to protect the reporter from reprisals or detriment (informed by ISO 37002)." ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path iso42001:reprisal_protection_actions ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the reporter chose to remain anonymous." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso42001:reporter_anonymous ],
        [ sh:datatype xsd:date ;
            sh:description "Date the concern was reported." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iso42001:reported_date ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path iso42001:version ],
        [ sh:datatype xsd:string ;
            sh:description "Confidentiality classification applied to the concern record (e.g., confidential, restricted, internal)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso42001:confidentiality_level ],
        [ sh:datatype xsd:string ;
            sh:description "Paraphrased description of the resolution provided." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path iso42001:resolution ],
        [ sh:description "Severity rating of the incident." ;
            sh:in ( "very_low" "low" "medium" "high" "critical" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path iso42001:severity ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path iso42001:created_date ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier or description of the investigator assigned to the concern." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path iso42001:investigator ],
        [ sh:datatype xsd:string ;
            sh:description "Type of party that reported the event (internal user, external interested party, monitoring system, etc.)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso42001:reporter_party_type ],
        [ sh:description "Unique identifier for this entity instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path iso42001:id ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path iso42001:name ],
        [ sh:datatype xsd:date ;
            sh:description "Date a response was provided to the reporter." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path iso42001:response_provided_date ],
        [ sh:datatype xsd:string ;
            sh:description "Paraphrased summary of investigation findings." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path iso42001:investigation_findings ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier or description of the person or system that reported the event." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso42001:reporter ],
        [ sh:class iso42001:Nonconformity ;
            sh:description "Nonconformities linked to this concern report." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path iso42001:related_nonconformities ],
        [ sh:description "AI system life cycle stage(s) at which the concern arose." ;
            sh:in ( "inception" "design" "data_collection_and_preparation" "development" "verification_and_validation" "deployment" "operation_and_monitoring" "continuous_validation" "re_evaluation" "decommissioning" ) ;
            sh:order 8 ;
            sh:path iso42001:concern_lifecycle_stage ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Date and time the incident was closed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path iso42001:closure_datetime ],
        [ sh:datatype xsd:string ;
            sh:description "Paraphrased summary of the concern raised." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path iso42001:concern_description ] ;
    sh:targetClass iso42001:ConcernReport .

iso42001:CustomerRelationship a sh:NodeShape ;
    rdfs:comment "A customer relationship for an AI product or service supplied by the organization per A.10.4." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Frequency at which the relationship is reviewed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path iso42001:review_frequency ],
        [ sh:datatype xsd:string ;
            sh:description "Evidence of assurance over the third party's conformance with the organization's responsible AI approach." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path iso42001:assurance_evidence ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path iso42001:description ],
        [ sh:datatype xsd:string ;
            sh:description "Documented customer expectations and needs." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iso42001:customer_expectations ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was last modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path iso42001:modified_date ],
        [ sh:datatype xsd:string ;
            sh:description "Category of party." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso42001:party_type ],
        [ sh:datatype xsd:string ;
            sh:description "Role of the third party in data processing (e.g., PII controller, PII processor)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso42001:data_processing_role ],
        [ sh:datatype xsd:string ;
            sh:description "Responsibilities allocated to the third party." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path iso42001:allocated_responsibilities ],
        [ sh:datatype xsd:string ;
            sh:description "Reference to the usage agreement with the customer." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso42001:usage_agreement_reference ],
        [ sh:description "Unique identifier for this entity instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path iso42001:id ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path iso42001:name ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path iso42001:version ],
        [ sh:datatype xsd:string ;
            sh:description "Contractual basis of the relationship." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso42001:contractual_basis ],
        [ sh:description "AI life cycle stages where the third party is involved." ;
            sh:in ( "inception" "design" "data_collection_and_preparation" "development" "verification_and_validation" "deployment" "operation_and_monitoring" "continuous_validation" "re_evaluation" "decommissioning" ) ;
            sh:order 9 ;
            sh:path iso42001:lifecycle_stages_involved ],
        [ sh:datatype xsd:string ;
            sh:description "Limitations of the AI system that are communicated to the customer." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso42001:communicated_limitations ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the third party." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso42001:party_name ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path iso42001:created_date ],
        [ sh:class iso42001:AISystem ;
            sh:description "AI systems involved in the third-party relationship." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path iso42001:ai_systems_involved ] ;
    sh:targetClass iso42001:CustomerRelationship .

iso42001:DataResource a sh:NodeShape ;
    rdfs:comment "A data resource used by an AI system per Annex A.7. Includes data acquisition, quality, provenance, and preparation metadata." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Source from which the data was obtained." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso42001:source ],
        [ sh:datatype xsd:string ;
            sh:description "Known or potential bias issues in the data." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path iso42001:known_bias_issues ],
        [ sh:datatype xsd:date ;
            sh:description "Date the data was last updated or modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iso42001:last_updated_date ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the data labelling process." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path iso42001:labelling_process ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path iso42001:name ],
        [ sh:description "Data preparation methods used (e.g., scaling, encoding, cleaning) per Annex A.7.6." ;
            sh:in ( "statistical_exploration" "cleaning" "imputation" "normalization" "scaling" "labelling" "encoding" "augmentation" "deduplication" "anonymization" "other" ) ;
            sh:order 7 ;
            sh:path iso42001:data_preparation_methods ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was last modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path iso42001:modified_date ],
        [ sh:datatype xsd:string ;
            sh:description "Classification of the data resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path iso42001:data_classification ],
        [ sh:datatype xsd:string ;
            sh:description "How the data was acquired (e.g., collected, purchased, synthetic)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso42001:acquisition_method ],
        [ sh:description "Unique identifier for this entity instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path iso42001:id ],
        [ sh:datatype xsd:string ;
            sh:description "Documented data quality requirements for the AI system." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso42001:data_quality_requirements ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path iso42001:description ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path iso42001:created_date ],
        [ sh:datatype xsd:string ;
            sh:description "Measured data quality metrics." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso42001:data_quality_metrics ],
        [ sh:description "Category of data resource (training, validation, test, production)." ;
            sh:in ( "training" "validation" "test" "production" "reference" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path iso42001:data_resource_category ],
        [ sh:datatype xsd:string ;
            sh:description "Provenance information for the data resource." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso42001:data_provenance ],
        [ sh:datatype xsd:string ;
            sh:description "Retention and disposal policy applicable to the data." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path iso42001:retention_policy ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path iso42001:version ] ;
    sh:targetClass iso42001:DataResource .

iso42001:DocumentedInformation a sh:NodeShape ;
