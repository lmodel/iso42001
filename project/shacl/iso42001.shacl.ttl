            sh:description "AI systems covered by this assessment." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path iso42001:ai_systems_assessed ],
        [ sh:datatype xsd:string ;
            sh:description "Societal context relevant to the impact assessment." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso42001:societal_context ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path iso42001:version ] ;
    sh:targetClass iso42001:AISystemImpactAssessment .

iso42001:CorrectiveAction a sh:NodeShape ;
