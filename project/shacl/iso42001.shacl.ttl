@prefix iso42001: <https://w3id.org/lmodel/iso42001/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

iso42001:AIManagementSystem a sh:NodeShape ;
    rdfs:comment "Top-level container representing an organization's complete AI Management System (AIMS) per ISO/IEC 42001:2023. Aggregates all components required to support the AIMS lifecycle." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Documented set of roles the organization plays in the AI ecosystem within the AIMS scope." ;
            sh:in ( "ai_provider" "ai_producer" "ai_customer" "ai_partner" "ai_subject" "relevant_authority" ) ;
            sh:order 6 ;
            sh:path iso42001:organizational_roles_with_ai ],
        [ sh:datatype xsd:string ;
            sh:description "External issues relevant to the AIMS per Clause 4.1." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso42001:context_external_issues ],
        [ sh:class iso42001:AIRiskTreatmentPlan ;
            sh:description "AI risk treatment plans." ;
            sh:nodeKind sh:IRI ;
            sh:order 29 ;
            sh:path iso42001:ai_risk_treatment_plans ],
        [ sh:datatype xsd:string ;
            sh:description "Records or references demonstrating top-management leadership and commitment to the AIMS per Clause 5.1." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path iso42001:leadership_commitment_evidence ],
        [ sh:class iso42001:AIReferenceControl ;
            sh:description "AI reference controls applied within the AIMS." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path iso42001:reference_controls ],
        [ sh:class iso42001:OperationalProcedure ;
            sh:description "Operational procedures of the AIMS." ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path iso42001:operational_procedures ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 50 ;
            sh:path iso42001:version ],
        [ sh:description "Related management-system standards with which the AIMS is jointly implemented or aligned (Introduction - Compatibility with other management system standards, Annex D)." ;
            sh:in ( "iso_iec_27001" "iso_iec_27701" "iso_9001" "iso_22000" "iso_13485" "iec_62304" "iso_iec_5338" "iso_iec_5259" "iso_iec_22989" "iso_iec_23894" "iso_iec_38507" "iso_iec_27000" "iso_iec_29100" "iso_31000" "iso_iec_25024" "iso_iec_25059" "iso_19011" "iso_37002" "other" ) ;
            sh:order 7 ;
            sh:path iso42001:integrated_management_systems ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was last modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 49 ;
            sh:path iso42001:modified_date ],
        [ sh:class iso42001:AISystem ;
            sh:description "AI systems within the AIMS scope." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path iso42001:ai_systems ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 46 ;
            sh:path iso42001:name ],
        [ sh:class iso42001:AIRiskTreatmentProcess ;
            sh:description "Reference to the AI risk treatment process." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path iso42001:ai_risk_treatment_process ],
        [ sh:datatype xsd:date ;
            sh:description "Date the AIMS was certified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 40 ;
            sh:path iso42001:certification_date ],
        [ sh:class iso42001:ThirdPartyRelationship ;
            sh:description "Third-party relationships within the AIMS scope." ;
            sh:nodeKind sh:IRI ;
            sh:order 37 ;
            sh:path iso42001:third_party_relationships ],
        [ sh:class iso42001:DocumentedInformation ;
            sh:description "Register of all documented information." ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path iso42001:documented_information_register ],
        [ sh:class iso42001:Organization ;
            sh:description "Reference to the organization operating the AIMS." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path iso42001:organization ],
        [ sh:class iso42001:AISystemImpactAssessmentProcess ;
            sh:description "Reference to the AI system impact assessment process." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path iso42001:ai_system_impact_assessment_process ],
        [ sh:class iso42001:AIIncident ;
            sh:description "AI incidents managed under the AIMS." ;
            sh:nodeKind sh:IRI ;
            sh:order 43 ;
            sh:path iso42001:ai_incidents ],
        [ sh:datatype xsd:string ;
            sh:description "Documented statement of AIMS scope per Clause 4.3." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso42001:scope_statement ],
        [ sh:datatype xsd:string ;
            sh:description "Reference to the governing body to which top management is accountable (Clause 3.22)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path iso42001:governing_body ],
        [ sh:class iso42001:MonitoringProgram ;
            sh:description "Reference to the monitoring program." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 31 ;
            sh:path iso42001:monitoring_program ],
        [ sh:datatype xsd:date ;
            sh:description "Date when recertification is due." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 41 ;
            sh:path iso42001:recertification_date ],
        [ sh:datatype xsd:string ;
            sh:description "Internal issues relevant to the AIMS per Clause 4.1." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso42001:context_internal_issues ],
        [ sh:class iso42001:CorrectiveAction ;
            sh:description "Corrective actions taken." ;
            sh:nodeKind sh:IRI ;
            sh:order 35 ;
            sh:path iso42001:corrective_actions ],
        [ sh:class iso42001:ImprovementOpportunity ;
            sh:description "Improvement opportunities being tracked." ;
            sh:nodeKind sh:IRI ;
            sh:order 36 ;
            sh:path iso42001:improvements ],
        [ sh:class iso42001:AIRiskAssessment ;
            sh:description "AI risk assessment instances." ;
            sh:nodeKind sh:IRI ;
            sh:order 28 ;
            sh:path iso42001:ai_risk_assessments ],
        [ sh:class iso42001:StatementOfApplicability ;
            sh:description "Reference to the AIMS Statement of Applicability." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path iso42001:statement_of_applicability ],
        [ sh:class iso42001:Role ;
            sh:description "AI-related roles defined in the AIMS." ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path iso42001:roles ],
        [ sh:class iso42001:AISystemEvent ;
            sh:description "AI system events recorded under the AIMS." ;
            sh:nodeKind sh:IRI ;
            sh:order 42 ;
            sh:path iso42001:ai_system_events ],
        [ sh:class iso42001:InternalAudit ;
            sh:description "Internal audits conducted." ;
            sh:nodeKind sh:IRI ;
            sh:order 32 ;
            sh:path iso42001:internal_audits ],
        [ sh:class iso42001:CommunicationPlan ;
            sh:description "Reference to the communication plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path iso42001:communication_plan ],
        [ sh:class iso42001:ConcernReport ;
            sh:description "Concern reports raised and managed under the AIMS per A.3.3." ;
            sh:nodeKind sh:IRI ;
            sh:order 44 ;
            sh:path iso42001:concern_reports ],
        [ sh:class iso42001:Nonconformity ;
            sh:description "Nonconformities identified." ;
            sh:nodeKind sh:IRI ;
            sh:order 34 ;
            sh:path iso42001:nonconformities ],
        [ sh:class iso42001:AIObjective ;
            sh:description "AI objectives established by the organization." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path iso42001:ai_objectives ],
        [ sh:class iso42001:Resource ;
            sh:description "Resources provided for the AIMS." ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path iso42001:resources ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 47 ;
            sh:path iso42001:description ],
        [ sh:class iso42001:ManagementReview ;
            sh:description "Management reviews of the AIMS." ;
            sh:nodeKind sh:IRI ;
            sh:order 33 ;
            sh:path iso42001:management_reviews ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 48 ;
            sh:path iso42001:created_date ],
        [ sh:datatype xsd:string ;
            sh:description "Body that issued the certification." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 39 ;
            sh:path iso42001:certification_body ],
        [ sh:class iso42001:AIPolicy ;
            sh:description "Reference to the AI policy." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path iso42001:ai_policy ],
        [ sh:datatype xsd:string ;
            sh:description "Current certification status of the AIMS." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 38 ;
            sh:path iso42001:certification_status ],
        [ sh:datatype xsd:string ;
            sh:description "Records of planned changes to the AIMS, including purpose, consequences, resource implications, and responsibilities per Clause 6.3." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path iso42001:planned_changes ],
        [ sh:datatype xsd:string ;
            sh:description "Reference to the person or group exercising top management direction and control over the AIMS (Clause 3.3, 5.1)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iso42001:top_management ],
        [ sh:class iso42001:AISystemImpactAssessment ;
            sh:description "AI system impact assessment instances." ;
            sh:nodeKind sh:IRI ;
            sh:order 30 ;
            sh:path iso42001:ai_system_impact_assessments ],
        [ sh:datatype xsd:string ;
            sh:description "Any exclusions from scope with justification." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso42001:scope_exclusions ],
        [ sh:description "Unique identifier for this entity instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 45 ;
            sh:path iso42001:id ],
        [ sh:class iso42001:AIRiskAssessmentProcess ;
            sh:description "Reference to the AI risk assessment process." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path iso42001:ai_risk_assessment_process ],
        [ sh:class iso42001:InterestedParty ;
            sh:description "Stakeholders relevant to the AIMS." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path iso42001:interested_parties ],
        [ sh:datatype xsd:string ;
            sh:description "Defined boundaries of the AIMS scope." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso42001:scope_boundaries ],
        [ sh:class iso42001:AwarenessProgram ;
            sh:description "Reference to the awareness program." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path iso42001:awareness_program ],
        [ sh:class iso42001:CompetenceRecord ;
            sh:description "Competence records for personnel." ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path iso42001:competence_records ] ;
    sh:targetClass iso42001:AIManagementSystem .

iso42001:AuditProgramme a sh:NodeShape ;
    rdfs:comment "The internal audit programme per Clause 9.2.2, planning AIMS audit activities over a defined period." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path iso42001:name ],
        [ sh:datatype xsd:string ;
            sh:description "Current status of the document or entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path iso42001:status ],
        [ sh:datatype xsd:string ;
            sh:description "Unique reference number for document control." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso42001:document_reference ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path iso42001:created_date ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the document was approved." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path iso42001:approved_date ],
        [ sh:datatype xsd:string ;
            sh:description "Person who approved the document." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path iso42001:approved_by ],
        [ sh:class iso42001:InternalAudit ;
            sh:description "Audits planned within the programme." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path iso42001:planned_audits ],
        [ sh:datatype xsd:string ;
            sh:description "Resources required for the activity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso42001:resource_requirements ],
        [ sh:description "Unique identifier for this entity instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path iso42001:id ],
        [ sh:datatype xsd:string ;
            sh:description "Person who created the document." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iso42001:author ],
        [ sh:datatype xsd:string ;
            sh:description "Rationale for the audit cadence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso42001:audit_frequency_rationale ],
        [ sh:datatype xsd:string ;
            sh:description "Status of the audit programme." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso42001:programme_status ],
        [ sh:description "Classification of the documented information." ;
            sh:in ( "policy" "procedure" "standard" "guideline" "record" "plan" "report" "technical_documentation" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path iso42001:document_type ],
        [ sh:datatype xsd:string ;
            sh:description "Required auditor qualifications." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso42001:auditor_qualifications ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was last modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path iso42001:modified_date ],
        [ sh:datatype xsd:string ;
            sh:description "Person accountable for the document content and maintenance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path iso42001:owner ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path iso42001:description ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the document becomes effective." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path iso42001:effective_date ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path iso42001:version ],
        [ sh:datatype xsd:string ;
            sh:description "Period covered by the audit programme." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iso42001:programme_period ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the document is due for review." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path iso42001:review_date ],
        [ sh:datatype xsd:string ;
            sh:description "Information classification level." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path iso42001:classification ],
        [ sh:datatype xsd:duration ;
            sh:description "Duration for which the document is retained." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path iso42001:retention_period ] ;
    sh:targetClass iso42001:AuditProgramme .

iso42001:NamedEntity a sh:NodeShape ;
    rdfs:comment "Abstract base class for all entities with an identifier, name, and description. Provides common identification and documentation slots." ;
    sh:closed false ;
    sh:ignoredProperties ( iso42001:risks_identified iso42001:control_id iso42001:alignment_with_ai_policy iso42001:risks_addressed iso42001:incident_category iso42001:dimensions_assessed iso42001:related_incidents iso42001:action_plan iso42001:ai_incidents iso42001:programme_status iso42001:target_audience iso42001:planned_count iso42001:internal_audits iso42001:awareness_topics iso42001:impact_scale iso42001:recommendations iso42001:assessment_criteria iso42001:residual_risk_acceptance iso42001:control_owner iso42001:detection_method iso42001:applicability_statement iso42001:soa_entries iso42001:related_nonconformities iso42001:certification_status iso42001:event_source iso42001:tool_version iso42001:concern_lifecycle_stage iso42001:risk_matrix iso42001:response_due_date iso42001:cost iso42001:retention_period iso42001:customer_expectations iso42001:concern_ai_systems iso42001:linked_corrective_actions iso42001:applicable_risk_sources iso42001:treatment_options_guidance iso42001:next_policy_review_date iso42001:allocated_to iso42001:resources_required iso42001:required_competencies iso42001:attendees iso42001:assigned_to iso42001:human_oversight_stages iso42001:audit_period_start iso42001:certification_date iso42001:current_value iso42001:known_bias_issues iso42001:education_records iso42001:geographic_locations iso42001:resource_type iso42001:linked_impact_assessment iso42001:action_description iso42001:target_date iso42001:measurement_frequency iso42001:planned_changes iso42001:ai_risk_treatment_process iso42001:allocation_date iso42001:data_processing_role iso42001:data_resource_category iso42001:lessons_learned iso42001:author iso42001:closure_evidence iso42001:top_management iso42001:license_terms iso42001:ai_roles iso42001:objective_evidence iso42001:reporting_channel iso42001:applicable_controls iso42001:ai_systems_involved iso42001:last_review_date iso42001:resource_requirements iso42001:external_reports iso42001:person_role iso42001:resource_class iso4200