iso42001:Organization a sh:NodeShape ;
    rdfs:comment "The organization establishing and operating the AIMS. Captures the context required by Clause 4.1, including the organization's role(s) with respect to AI systems." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:date ;
            sh:description "Date when the entity was last modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path iso42001:modified_date ],
        [ sh:description "Application sectors in which the organization deploys AI systems, drawn from the Annex D examples; supports identification of sector- specific management system standards that integrate with the AIMS." ;
            sh:in ( "health" "defence" "transport" "finance" "employment" "energy" "public_sector" "education" "manufacturing" "agriculture" "telecommunications" "retail" "other" ) ;
            sh:order 4 ;
            sh:path iso42001:sector_domains ],
        [ sh:datatype xsd:positiveInteger ;
            sh:description "Approximate number of employees." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path iso42001:employee_count ],
        [ sh:datatype xsd:string ;
            sh:description "Organization size classification." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso42001:size_category ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path iso42001:version ],
        [ sh:datatype xsd:string ;
            sh:description "Subsidiary organizations if applicable." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path iso42001:subsidiaries ],
        [ sh:datatype xsd:string ;
            sh:description "Jurisdictions whose regulations apply to the organization." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iso42001:regulatory_jurisdictions ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path iso42001:created_date ],
        [ sh:datatype xsd:string ;
            sh:description "Parent organization if applicable." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path iso42001:parent_organization ],
        [ sh:datatype xsd:string ;
            sh:description "Type of organization (e.g., corporation, government, nonprofit)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso42001:organization_type ],
        [ sh:description "Roles the organization takes with respect to AI systems (provider, producer, customer, partner, subject, authority)." ;
            sh:in ( "ai_provider" "ai_producer" "ai_customer" "ai_partner" "ai_subject" "relevant_authority" ) ;
            sh:order 11 ;
            sh:path iso42001:ai_roles ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path iso42001:name ],
        [ sh:datatype xsd:string ;
            sh:description "Legal registered name of the organization." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iso42001:legal_name ],
        [ sh:datatype xsd:string ;
            sh:description "Names under which the organization conducts business." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso42001:trading_names ],
        [ sh:datatype xsd:string ;
            sh:description "Primary industry sector of the organization (free-form label)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso42001:industry_sector ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path iso42001:description ],
        [ sh:description "Unique identifier for this entity instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path iso42001:id ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether climate change has been determined to be a relevant issue for the organization's context per Clause 4.1." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path iso42001:climate_change_relevant ],
        [ sh:datatype xsd:string ;
            sh:description "Countries or regions where the organization operates." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso42001:geographic_locations ] ;
    sh:targetClass iso42001:Organization .

iso42001:Resource a sh:NodeShape ;
    rdfs:comment "A resource provided for the AIMS per Clause 7.1." ;
    sh:closed true ;
