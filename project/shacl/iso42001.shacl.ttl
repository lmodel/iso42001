iso42001:Role a sh:NodeShape ;
    rdfs:comment "An AI-related role with defined responsibilities and authorities per Clause 5.3 and Annex A.3.2." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "What the role is accountable for." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso42001:accountability ],
        [ sh:datatype xsd:string ;
            sh:description "To whom this role reports." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path iso42001:reporting_line ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iso42001:name ],
        [ sh:datatype xsd:string ;
            sh:description "Person(s) assigned to this role or resource." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso42001:assigned_to ],
        [ sh:description "Unique identifier for this entity instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path iso42001:id ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path iso42001:description ],
        [ sh:datatype xsd:string ;
            sh:description "Responsibilities assigned to the role." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso42001:responsibilities ],
        [ sh:datatype xsd:string ;
            sh:description "Authorities granted to the role." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso42001:authorities ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path iso42001:version ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path iso42001:created_date ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was last modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path iso42001:modified_date ],
        [ sh:description "Category of the role. Use a `GovernanceRoleType` value for the normative AIMS governance positions; free-form strings remain accepted for organization-defined roles." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( "governing_body" "top_management" "designated_management" "chief_ai_officer" "ai_risk_owner" "ai_policy_owner" "ai_oversight_committee" "data_steward" "model_validator" "human_oversight_reviewer" "ai_developer" "ai_operator" "ai_impact_assessor" "auditor" "other" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 0 ;
            sh:path iso42001:role_type ],
        [ sh:datatype xsd:string ;
            sh:description "Rules for delegating responsibilities." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iso42001:delegation_rules ] ;
    sh:targetClass iso42001:Role .

iso42001:AIReferenceControl a sh:NodeShape ;
    rdfs:comment "A reference control from Annex A of ISO/IEC 42001:2023. Controls are grouped into nine families (A.2 through A.10) and supported by implementation guidance in Annex B." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Unique identifier for this entity instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path iso42001:id ],
        [ sh:description "Family of the Annex A control." ;
            sh:in ( "ai_policies" "internal_organization" "ai_resources" "impact_assessment" "ai_system_lifecycle" "data_for_ai" "information_for_parties" "use_of_ai" "third_party_relationships" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path iso42001:control_family ],
        [ sh:datatype xsd:string ;
            sh:description "References to evidence of implementation." ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path iso42001:evidence_references ],
        [ sh:class iso42001:AIReferenceControl ;
            sh:description "Other reference controls related to this one." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path iso42001:related_controls ],
        [ sh:datatype xsd:string ;
            sh:description "Person responsible for the control." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iso42001:control_owner ],
        [ sh:description "Control identifier from Annex A (e.g., A.6.2.4). Accepts either an enumerated normative `AnnexAControlId` value or a free-form string for organization-defined controls beyond Annex A." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:in ( "a_2_2" "a_2_3" "a_2_4" "a_3_2" "a_3_3" "a_4_2" "a_4_3" "a_4_4" "a_4_5" "a_4_6" "a_5_2" "a_5_3" "a_5_4" "a_5_5" "a_6_1_2" "a_6_1_3" "a_6_2_2" "a_6_2_3" "a_6_2_4" "a_6_2_5" "a_6_2_6" "a_6_2_7" "a_6_2_8" "a_7_2" "a_7_3" "a_7_4" "a_7_5" "a_7_6" "a_8_2" "a_8_3" "a_8_4" "a_8_5" "a_9_2" "a_9_3" "a_9_4" "a_10_2" "a_10_3" "a_10_4" ) ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 0 ;
            sh:path iso42001:control_id ],
        [ sh:description "Categories of AI risk source this control addresses." ;
            sh:in ( "complexity_of_environment" "lack_of_transparency_or_explainability" "level_of_automation" "machine_learning_specific" "hardware" "lifecycle" "technology_readiness" ) ;
            sh:order 6 ;
            sh:path iso42001:applicable_risk_sources ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path iso42001:description ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path iso42001:version ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path iso42001:created_date ],
        [ sh:datatype xsd:date ;
            sh:description "Date the control was implemented." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path iso42001:implementation_date ],
        [ sh:datatype xsd:string ;
            sh:description "Organization-authored implementation notes for the control." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso42001:implementation_guidance ],
        [ sh:datatype xsd:string ;
            sh:description "Organization-authored control statement or external control summary. Do not include verbatim ISO/IEC standards text." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso42001:control_text ],
        [ sh:description "AI objective categories this control supports." ;
            sh:in ( "accountability" "ai_expertise" "data_quality" "environmental_impact" "fairness" "maintainability" "privacy" "robustness" "safety" "security" "transparency" "explainability" "reliability" "accessibility" "availability_of_training_data" ) ;
            sh:order 7 ;
            sh:path iso42001:applicable_objectives ],
        [ sh:datatype xsd:date ;
            sh:description "Date the control was last tested." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path iso42001:last_test_date ],
        [ sh:datatype xsd:string ;
            sh:description "Title of the control." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso42001:control_title ],
        [ sh:description "Current implementation status." ;
            sh:in ( "not_started" "planned" "in_progress" "implemented" "not_applicable" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path iso42001:implementation_status ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was last modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path iso42001:modified_date ],
        [ sh:datatype xsd:string ;
            sh:description "Rating of control effectiveness." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path iso42001:effectiveness_rating ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path iso42001:name ] ;
    sh:targetClass iso42001:AIReferenceControl .

iso42001:AISystem a sh:NodeShape ;
    rdfs:comment "An AI system within the AIMS scope. Captures life cycle stage, intended use, applicable domains, and references to data and tooling resources, technical documentation, and impact assessments." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class iso42001:ToolingResource ;
            sh:description "Tooling resources used by the AI system." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path iso42001:tooling_resources ],
        [ sh:class iso42001:CustomerRelationship ;
            sh:description "Customer relationships relevant to this AI system." ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path iso42001:customer_relationships ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name or title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path iso42001:name ],
        [ sh:datatype xsd:string ;
            sh:description "Policy for AI system event log recording across life cycle phases." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path iso42001:event_log_policy ],
        [ sh:description "Machine-learning approach used by the AI system, capturing the design-choice dimension referenced in Annex B.6.2.3." ;
            sh:in ( "supervised" "unsupervised" "semi_supervised" "self_supervised" "reinforcement" "transfer" "federated" "generative" "symbolic" "hybrid" "not_applicable" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path iso42001:ml_approach ],
        [ sh:datatype xsd:string ;
            sh:description "Reasonably foreseeable misuse of the AI system." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso42001:foreseeable_misuse ],
        [ sh:datatype xsd:string ;
            sh:description "Reference to AI system technical documentation." ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path iso42001:technical_documentation ],
        [ sh:class iso42001:SupplierRelationship ;
            sh:description "Supplier relationships relevant to this AI system." ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path iso42001:supplier_relationships ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path iso42001:created_date ],
        [ sh:datatype xsd:string ;
            sh:description "Operational context in which the AI system is deployed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iso42001:deployment_context ],
        [ sh:description "Learning paradigm of the AI system (informs Clause 6.1 risk and Annex A.6.2.6 monitoring considerations)." ;
            sh:in ( "static" "periodic_retraining" "continuous_learning" "online_learning" "transfer_learning" "reinforcement_learning" "hybrid" "not_applicable" ) ;
            sh:maxCount 1 ;
            sh:order 12 ;
            sh:path iso42001:learning_mode ],
        [ sh:datatype xsd:string ;
            sh:description "Documented intended uses of the AI system." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iso42001:intended_uses ],
        [ sh:datatype xsd:date ;
            sh:description "Date when the entity was last modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path iso42001:modified_date ],
        [ sh:class iso42001:DataResource ;
            sh:description "Data resources used by the AI system." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path iso42001:data_resources ],
        [ sh:description "Unique identifier for this entity instance." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path iso42001:id ],
        [ sh:datatype xsd:string ;
            sh:description "Description of human-oversight arrangements, including review points, escalation paths, and oversight authority (Annex B.9.3)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path iso42001:human_oversight_description ],
        [ sh:datatype xsd:string ;
            sh:description "Version identifier for the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path iso42001:version ],
        [ sh:description "Current life cycle stage of the AI system." ;
            sh:in ( "inception" "design" "data_collection_and_preparation" "development" "verification_and_validation" "deployment" "operation_and_monitoring" "continuous_validation" "re_evaluation" "decommissioning" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path iso42001:lifecycle_stage ],
        [ sh:datatype xsd:string ;
            sh:description "Description of the level of autonomy and human oversight required for this AI system. Free-form text complements `human_oversight_required` and `human_oversight_description`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iso42001:autonomy_level ],
        [ sh:class iso42001:AISystemImpactAssessment ;
            sh:description "Impact assessments related to this AI system." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path iso42001:related_impact_assessments ],
        [ sh:description "The organization's role with respect to this AI system (provider, producer, customer, partner)." ;
            sh:in ( "ai_provider" "ai_producer" "ai_customer" "ai_partner" "ai_subject" "relevant_authority" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path iso42001:organization_role ],
        [ sh:description "AI system life cycle stages at which human oversight applies (Annex B.9.3)." ;
            sh:in ( "inception" "design" "data_collection_and_preparation" "development" "verification_and_validation" "deployment" "operation_and_monitoring" "continuous_validation" "re_evaluation" "decommissioning" ) ;
            sh:order 11 ;
            sh:path iso42001:human_oversight_stages ],
        [ sh:datatype xsd:string ;
            sh:description "Purpose of the AI system." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iso42001:ai_system_purpose ],
        [ sh:datatype xsd:string ;
            sh:description "Domain in which the AI system is applied (e.g., health, finance)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iso42001:application_domain ],
        [ sh:class iso42001:HumanResource ;
            sh:description "Human resources involved with the AI system." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path iso42001:human_resources ],
        [ sh:class iso42001:ComputingResource ;
            sh:description "System and computing resources used by the AI system." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path iso42001:computing_resources ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether human oversight is required for outputs of the AI system (Annex A.9, Annex B.9.3)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path iso42001:human_oversight_required ],
        [ sh:class iso42001:AIReferenceControl ;
            sh:description "Reference controls related to this policy or AI system." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path iso42001:applicable_controls ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed description of the entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path iso42001:description ] ;
    sh:targetClass iso42001:AISystem .

