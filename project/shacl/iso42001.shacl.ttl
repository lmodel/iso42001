            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iso42001:author ],
        [ sh:datatype xsd:string ;
            sh:description "Control measures applied." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iso42001:control_measures ],
        [ sh:datatype xsd:date ;
